+
+/* R&C patch 7116: the word an idle RSX fetches when put moves off it.
+ *
+ * An RSX parked at get == put polls put and fetches the word at get within microseconds of the guest moving put
+ * (RPCS3: one dedicated puller thread, put re-read on every idle poll, the word copied into its fetch cache at once
+ * [src:rpcs3-rsxfifo], read for behaviour only). The walker here runs once per frame-thread pass, ~3-4 ms apart, and
+ * reads that word only at its next pass. A title that reuses the memory behind put right after moving put loses the
+ * word. Full Frontal Assault's frame end (0x006F6138) injects a copy block at GET (JUMP at GET, the JUMP-back
+ * 0x20000000 | GET at the block's end), sets put to the JUMP-back slot, waits get == put (0x0079C2F0), then sets put
+ * back to GET with no wait for the RSX to take the JUMP-back, restores the word at GET and later resets the per-frame
+ * scratch ring the block came from (read in the lifted code). The port's walker then found scratch data at IO
+ * 0x006080B8 (0x49FC9A00 ...), decoded it, hit "FIFO JUMP to unmapped" and resynced to put about once per flip
+ * (measured: ls-ffa-newgame-luamsg-1120-124120, ~1 flip per 6 s in phoenix_ph1). The same shape (put back to GET, no
+ * wait) is read in Into the Nexus 1.01 0x005F8AF8 / 0x0063D3F4, All 4 One 0x006DC25C and A Crack in Time 1.20
+ * 0x005F46F0; whether those run is not measured.
+ *
+ * What it does: when the guest stores put while the published get equals the old put (the walker is parked there,
+ * so the next word it fetches is the one at the old put), that ONE word is kept here, as the RSX would have fetched it
+ * then. By the push-buffer protocol it is final at that moment (titles write commands before they move put). The
+ * walker's next fetch at that offset takes the kept word once, so a later guest store to that memory does not change
+ * what the RSX already fetched (RPCS3 executes from its fetch cache the same way). Only the first word is kept, not the
+ * span [old put, new put): the rest is read from memory when the walker gets there, as before. That covers FFA's single
+ * JUMP-back word; a title that reuses later words of the span before the walker's next pass is not covered.
+ * When the walker is NOT parked at the old put nothing is kept, so a walker that is behind reads memory exactly as
+ * before (a busy RSX does too). One slot; a newer keep replaces an unused one (counted as dropped). The slot is
+ * dropped on a resync, when a pass starts at another offset, and by the runtime's own put stores (the ring recycle,
+ * cellGcm_syscall_set_fifo), which move the walker without the hook.
+ * GCM_PUT_SNAP=0 / off / false / no: off (hook not armed). GCM_PUT_SNAP=log: keep and compare, but walk the word in
+ * memory (the old behaviour), to show the race without changing it. Default: on. GCM_PUT_SNAP_LOG=<n>: log the first
+ * n kept words. GCM_PUT_SNAP_STATS=<s>: the counter line every s seconds of walker passes (default 30; 0 = at exit
+ * only). Do not combine with GCM_GET_EQ_PUT=1: it publishes get = put, so the parked test always passes.
+ * Counters ([gcm-putsnap] hook=... line): hook = guest put stores seen, kept = words kept, used = kept words taken by
+ * the walker's fetch, changed = of those, words memory no longer held, dropped = kept words never used. */
+static volatile uint64_t s_put_snap;   /* (io | 1) << 32 | word; 0 = empty. io is 4-aligned, so io|1 != 0 */
+static volatile long s_put_snap_hook, s_put_snap_taken, s_put_snap_used, s_put_snap_diff, s_put_snap_drop;
+static int gcm_put_snap_mode(void)
+{
+    static int m = -1;
+    if (m < 0) { const char* e = getenv("GCM_PUT_SNAP");
+                 if (!e || !*e) m = 1;
+                 else if (!strcmp(e, "0") || !strcmp(e, "off") || !strcmp(e, "false") || !strcmp(e, "no")) m = 0;
+                 else if (!strcmp(e, "log")) m = 2;
+                 else m = 1; }
+    return m;
+}
+static void gcm_put_snap_summary(const char* when)
+{
+    fprintf(stderr, "[gcm-putsnap] %s: hook=%ld kept=%ld used=%ld changed=%ld dropped=%ld (mode %s)\n", when,
+            __atomic_load_n(&s_put_snap_hook, __ATOMIC_RELAXED), __atomic_load_n(&s_put_snap_taken, __ATOMIC_RELAXED),
+            __atomic_load_n(&s_put_snap_used, __ATOMIC_RELAXED), __atomic_load_n(&s_put_snap_diff, __ATOMIC_RELAXED),
+            __atomic_load_n(&s_put_snap_drop, __ATOMIC_RELAXED),
+            gcm_put_snap_mode() == 1 ? "on" : gcm_put_snap_mode() == 2 ? "log" : "off");
+}
+static void gcm_put_snap_at_exit(void) { gcm_put_snap_summary("exit"); fflush(stderr); }
+void gcm_note_ppu_put(u32 new_put)   /* guest thread, from vm_write32 / vm_write64 before the store lands */
+{
+    __atomic_add_fetch(&s_put_snap_hook, 1, __ATOMIC_RELAXED);
+    const u32 old_put = vm_read32(GCM_CONTROL_GUEST_ADDR + 0) & ~3u;
+    if (!gcm_put_snap_mode()) return;
+    if ((new_put & ~3u) == old_put) return;
+    if (vm_read32(GCM_CONTROL_GUEST_ADDR + 4) != old_put) return;   /* walker not parked at the old put */
+    const u32 ea = gcm_io2ea(old_put);
+    if (!ea) return;
+    const u32 w = vm_read32(ea);
+    /* seq_cst, and before the guest's put store: a walker that reads the new put (acquire) sees the slot. */
+    if (__atomic_exchange_n(&s_put_snap, ((uint64_t)(old_put | 1u) << 32) | w, __ATOMIC_SEQ_CST))
+        __atomic_add_fetch(&s_put_snap_drop, 1, __ATOMIC_RELAXED);
+    const long n = __atomic_add_fetch(&s_put_snap_taken, 1, __ATOMIC_RELAXED);
+    static int lg = -1;
+    if (lg < 0) { const char* e = getenv("GCM_PUT_SNAP_LOG"); lg = e ? atoi(e) : 0; }
+    if (n <= lg)
+        fprintf(stderr, "[gcm-putsnap] kept io=0x%08X w=0x%08X (put 0x%08X -> 0x%08X)\n", old_put, w, old_put, new_put);
+}
+/* Walker thread: the fetch at `io` read *w from memory; take the kept word if the slot is for this offset. */
+static void gcm_put_snap_fetch(u32 io, u32* w)
+{
+    uint64_t s = __atomic_load_n(&s_put_snap, __ATOMIC_ACQUIRE);
+    if (!s || (u32)(s >> 32) != (io | 1u)) return;
+    if (!__atomic_compare_exchange_n(&s_put_snap, &s, 0, 0, __ATOMIC_ACQ_REL, __ATOMIC_RELAXED)) return;
+    __atomic_add_fetch(&s_put_snap_used, 1, __ATOMIC_RELAXED);
+    const u32 kept = (u32)s;
+    if (kept == *w) return;
+    const long n = __atomic_add_fetch(&s_put_snap_diff, 1, __ATOMIC_RELAXED);
+    if (n <= 16 || (n & (n - 1)) == 0)   /* first 16, then every power of two: the count stays exact */
+        fprintf(stderr, "[gcm-putsnap] io=0x%08X now 0x%08X, was 0x%08X when put moved off it: %s "
+                "(changed #%ld; kept %ld used %ld dropped %ld)\n", io, *w, kept,
+                gcm_put_snap_mode() == 1 ? "walking the kept word" : "log only, walking memory",
+                n, s_put_snap_taken, s_put_snap_used, s_put_snap_drop);
+    if (gcm_put_snap_mode() == 1) *w = kept;
+}
+static void gcm_put_snap_forget(void)
+{
+    if (__atomic_exchange_n(&s_put_snap, 0, __ATOMIC_ACQ_REL))
+        __atomic_add_fetch(&s_put_snap_drop, 1, __ATOMIC_RELAXED);
+}
