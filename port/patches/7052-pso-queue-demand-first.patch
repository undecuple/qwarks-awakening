+/* R&C patch 7052: demand-first order of the asynchronous PSO build queue (KZ3 2048 + R&C 7050 lookahead).
+ *
+ * KZ3 2048's queue is FIFO. With the 7050 lookahead a miss submits up to ~100 speculative builds, and the build of a
+ * draw the walker then waits on queues behind every one of them: ToD ahead-on2-cold (2026-11-11) waited 36 times
+ * for 26.0 s, max 5.1 s, against 181 waits, max 0.81 s, without lookahead (the RE notes s.30).
+ *
+ * Order: each queued job has a priority, its FIFO distance from the walker (the END sequence number of the draw it
+ * was submitted for; lower = sooner). A build the walker waits on (a demand) has priority 0 and goes to the front, so it
+ * runs as soon as a worker is free: it waits only for the builds already running, never for a queued one. Lookahead
+ * submissions keep their distance order, nearest first, also across scans. Equal priorities keep submission order.
+ *
+ * Shared compiles (KZ3 2048 RSX pass 50): the first job that needs a VS/PS blob owns its compile; later jobs wait for
+ * the owner's result in the worker. FIFO made that deadlock-free (an owner was always taken before its dependents);
+ * with a reordered queue the rule becomes: the owner of a pending compile is the job taken first. When a job is
+ * queued or promoted ahead of the queued owner of a compile it needs, the ownership moves to it (rsx_apq_claim), so
+ * no worker ever waits for a compile that sits behind it in the queue.
+ *
+ * Worker count (rsx_apq_workers): 2048 fixed 3 workers (LD_PSO_ASYNC_THREADS). The default is now sized from the host:
+ * logical processors minus the threads the game keeps busy during a load, clamped to [2, 8]. ToD's [perf-thr] in a
+ * level load: the PPU main thread (~1000 ms/s), 4 SPURS SPU threads (up to ~850 ms/s), the RSX walker, d3d12core's
+ * queue thread; a raw SPU and the audio/IO threads come and go: 8 reserved. 20 logical processors (i7-12700KF) -> 8
+ * workers; 12 -> 4; 8 or fewer -> 2. LD_PSO_ASYNC_THREADS still overrides.
+ * Pure C (host test port/rc/tests/run_pso_prio_test.sh). The caller holds its lock around every call. */
+#ifndef RSX_PSO_PRIO_H
+#define RSX_PSO_PRIO_H
+#include <stdint.h>
+
+#define RSX_APQ_DEMAND 0ull
+#define RSX_APQ_GAME_THREADS 8
+#define RSX_APQ_MIN_WORKERS 2
+#define RSX_APQ_MAX_WORKERS 8
+
+typedef struct rsx_apq_node {
+    struct rsx_apq_node* next;
+    uint64_t prio;
+    uint8_t queued;      /* 1 between insert and pop */
+} rsx_apq_node;
+
+typedef struct {
+    rsx_apq_node* head;
+    uint32_t n_queued;
+    uint64_t promoted, claims;   /* demands moved to the front; compile ownerships moved */
+} rsx_apq;
+
+/* Insert after every node of lower or equal priority (stable). */
+static inline void rsx_apq_insert(rsx_apq* q, rsx_apq_node* n, uint64_t prio)
+{
+    rsx_apq_node** pp = &q->head;
+    while (*pp && (*pp)->prio <= prio) pp = &(*pp)->next;
+    n->prio = prio; n->next = *pp; *pp = n; n->queued = 1;
+    q->n_queued++;
+}
+
+/* The next job to run (NULL when empty). */
+static inline rsx_apq_node* rsx_apq_pop(rsx_apq* q)
+{
+    rsx_apq_node* n = q->head;
+    if (!n) return NULL;
+    q->head = n->next; n->next = NULL; n->queued = 0;
+    q->n_queued--;
+    return n;
+}
+
+/* 1 when a is queued strictly ahead of b (both queued). */
+static inline int rsx_apq_before(const rsx_apq* q, const rsx_apq_node* a, const rsx_apq_node* b)
+{
+    for (const rsx_apq_node* n = q->head; n; n = n->next) {
+        if (n == a) return 1;
+        if (n == b) return 0;
+    }
+    return 0;
+}
+
+/* A demand: move a queued node to the front (ahead of every other node, earlier demands included; the walker waits
+ * on one build at a time). Returns 1 when it moved, 0 when it was not queued (running or done). */
+static inline int rsx_apq_promote(rsx_apq* q, rsx_apq_node* n)
+{
+    if (!n->queued) return 0;
+    rsx_apq_node** pp = &q->head;
+    while (*pp && *pp != n) pp = &(*pp)->next;
+    if (!*pp) return 0;
+    *pp = n->next;
+    n->prio = RSX_APQ_DEMAND; n->next = q->head; q->head = n;
+    q->promoted++;
+    return 1;
+}
+
+/* Compile ownership of one shared blob. *owner / *owner_flag: the entry's current owner node and its "I compile it"
+ * flag (NULL owner = the owner was taken by a worker already, or nobody). me / my_flag: a queued job that needs the
+ * blob. When me is queued ahead of the queued owner, me becomes the owner. Returns 1 when ownership moved. */
+static inline int rsx_apq_claim(rsx_apq* q, rsx_apq_node* me, uint8_t* my_flag, void** owner, uint8_t** owner_flag)
+{
+    rsx_apq_node* o = (rsx_apq_node*)*owner;
+    if (*my_flag || !o || o == me || !o->queued || !me->queued || !rsx_apq_before(q, me, o)) return 0;
+    **owner_flag = 0; *my_flag = 1;
+    *owner = me; *owner_flag = my_flag;
+    q->claims++;
+    return 1;
+}
+
+/* Default worker count from the logical processor count. */
+static inline int rsx_apq_workers(int logical)
+{
+    int n = logical - RSX_APQ_GAME_THREADS;
+    if (n < RSX_APQ_MIN_WORKERS) n = RSX_APQ_MIN_WORKERS;
+    if (n > RSX_APQ_MAX_WORKERS) n = RSX_APQ_MAX_WORKERS;
+    return n;
+}
+#endif
