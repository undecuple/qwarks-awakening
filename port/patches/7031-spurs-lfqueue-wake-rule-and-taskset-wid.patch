+/* patch 7031: wake the waiter taken off the ring, the way the SPU task library's fpSendSignal does it (ACiT Edge task
+ * elf_00be3800 @0x99F8, ToD elf_008ea200 the same code; called with eaSignal = line +0x70 and the ring id @0xA798):
+ *  - the id is (wklCurrentId << 8) | taskId: id callback @0x97F8 = (LS 0x1DC << 8) | u32 at [LS 0x2FB8] + 0xD4 = 0x27D4
+ *    (SpursKernelContext.wklCurrentId, SpursTasksetContext.taskId, [src:rpcs3-cellspurs]);
+ *  - eaSignal & 15 == 0: eaSignal is the taskset, signal task (id & 0xFF);
+ *  - otherwise (cellSpursLFQueueInitializeIWL style, owner = spurs | 1): wid = id >> 8, refused when > 15
+ *    (0x80410902), taskset = wklInfo1[wid].arg = u64 at spurs + 0xB00 + 32 * wid + 8 (@0x9778 DMAs that entry), then
+ *    signal task (id & 0xFF);
+ *  - the send (@0x9828) refuses taskset 0 (0x80410911), taskset & 0x7F (0x80410910), task > 127 (0x80410902).
+ * ASSUMPTION: the PPU push in libsre routes a waiter the same way (no PPU push code exists in the EBOOT); the spurs
+ * base is taken from eaSignal & ~15 where the SPU reads its own kernel context's spurs (LS 0x1C0): the same instance. */
+static int rc_lfq_wake(u32 q, u32 id, int logit)
+{
+    u64 eas = vm_read64(q + 0x70);
+    u32 tid = id & 0xFF, wid = id >> 8, ts;
+    if (!(eas & 15)) ts = (u32)eas;
+    else {
+        if (wid > 15) { printf("[cellSpurs] LFQueuePush wake q=0x%08X id=0x%04X: wid %u > 15, no signal\n", q, id, wid); return -1; }
+        ts = (u32)vm_read64((u32)(eas & ~15ull) + 0xB00 + 32 * wid + 8);
+    }
+    if (!ts || (ts & 0x7F) || tid > 127) {
+        printf("[cellSpurs] LFQueuePush wake q=0x%08X id=0x%04X eaSignal=0x%llX: bad target taskset 0x%08X task %u, no signal\n",
+               q, id, (unsigned long long)eas, ts, tid);
+        return -1;
+    }
+    if (logit || PS3_LOG_FIRST(s_rc_lfq_wake_n, 8))
+        printf("[cellSpurs] LFQueuePush wake q=0x%08X id=0x%04X -> taskset 0x%08X task %u (%s wid %u)\n", q, id, ts, tid,
+               (eas & 15) ? "IWL" : "taskset", wid);
+    spu_taskset_signal_task(ts, tid);
+    return 0;
+}
