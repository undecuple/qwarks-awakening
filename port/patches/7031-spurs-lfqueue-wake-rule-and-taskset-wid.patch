+/* ---- patch 7031: a taskset's workload id ----
+ * Console: _spurs::create_taskset adds a workload (taskset PM, argument = taskset EA) and stores its id in taskset->wid
+ * (+0x74) [src:rpcs3-cellspurs]; the SPU library finds a taskset from (spurs, wid) through wklInfo1[wid].arg. The port
+ * runs taskset tasks itself (spu_workload.c), so the slot is reserved without a PM: wklEnabled and wklState stay 0 and
+ * the PM is marked missing, so no port kernel thread ever selects it. ASSUMPTION: wklInfo addr/size 0 (console: the
+ * firmware's taskset PM image). The port's workload table is shared by all instances (16 slots). Returns the wid or
+ * CELL_SPURS_MAX_WORKLOAD when every slot is taken (logged; the taskset then keeps wid 0 as before this patch). */
+static u32 rc_spurs_taskset_wid_take(u32 spurs_ea, u32 taskset_ea)
+{
+    u32 w = CELL_SPURS_MAX_WORKLOAD;
+    for (u32 i = 0; i < CELL_SPURS_MAX_WORKLOAD && w == CELL_SPURS_MAX_WORKLOAD; i++)   /* re-created at the same EA */
+        if (s_workloads[i].in_use && s_workloads[i].taskset_ea == taskset_ea && s_workloads[i].spurs_ea == spurs_ea) w = i;
+    for (u32 i = 0; i < CELL_SPURS_MAX_WORKLOAD && w == CELL_SPURS_MAX_WORKLOAD; i++)
+        if (!s_workloads[i].in_use) w = i;
+    if (w == CELL_SPURS_MAX_WORKLOAD) {
+        printf("[cellSpurs] CreateTaskset 0x%08X: no free workload id (16 taken), taskset wid stays 0\n", taskset_ea);
+        return w;
+    }
+    memset(&s_workloads[w], 0, sizeof s_workloads[w]);
+    s_workloads[w].in_use = 1;
+    s_workloads[w].spurs_ea = spurs_ea;
+    s_workloads[w].data = taskset_ea;
+    s_workloads[w].taskset_ea = taskset_ea;
+    s_wkl_pm[w].fn = NULL; s_wkl_pm[w].image_id = -1; s_wkl_pm[w].resolved = -1;
+    u32 info = spurs_ea + SPURS_WKL_INFO1 + w * SPURS_WKL_INFO_SZ;
+    vm_write64(info + 0x00, 0);
+    vm_write64(info + 0x08, (u64)taskset_ea);       /* wklInfo1[wid].arg = the taskset */
+    vm_write32(info + 0x10, 0);
+    vm_write32(info + 0x14, w << 24);               /* uniqueId, as AddWorkload */
+    vm_write64(info + 0x18, 0);
+    return w;
+}
+
+static void rc_spurs_taskset_wid_free(u32 taskset_ea)
+{
+    for (u32 i = 0; i < CELL_SPURS_MAX_WORKLOAD; i++)
+        if (s_workloads[i].in_use && s_workloads[i].taskset_ea == taskset_ea) {
+            vm_write64(s_workloads[i].spurs_ea + SPURS_WKL_INFO1 + i * SPURS_WKL_INFO_SZ + 0x08, 0);
+            memset(&s_workloads[i], 0, sizeof s_workloads[i]);
+            memset(&s_wkl_pm[i], 0, sizeof s_wkl_pm[i]);   /* a later AddWorkload in this slot resolves its own PM */
+        }
+}
