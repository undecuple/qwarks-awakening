     vm_memcpy_to(dst, vm_ptr8(src), size);     /* the element is in place before h5 can move past it */
     int waiter = rc_lfq_publish(q, depth, slot, direction);
-    if (waiter >= 0) {
-        u32 owner = (u32)vm_read64(q + 0x70) & ~1u;
-        if (owner) spu_taskset_signal_task(owner, (u32)waiter);
-    }
+    if (waiter >= 0) rc_lfq_wake(q, (u32)waiter, logit);
     if (logit) {
         printf("[cellSpurs] LFQueuePush(q=0x%08X dir=%u slot=%u dst=0x%08X waiter=%d)\n", q, direction, slot, dst, waiter);
         rc_lfq_dump("after", q);
     }
     return CELL_OK;
 }
