+{
+    ctx->gpr[3] = (uint64_t)(int64_t)cellSaveDataUserListAutoSave(RC_G(3), RC_G(4), RC_G(5),
+        RC_P(CellSaveDataSetList*, 6), RC_P(CellSaveDataSetBuf*, 7), RC_P(CellSaveDataFixedCallback, 8),
+        RC_P(CellSaveDataStatCallback, 9), RC_P(CellSaveDataFileCallback, 10), savedata_arg9(ctx),
+        (void*)(uintptr_t)savedata_arg10(ctx));
+}
+
+static void hle_cellSaveDataUserListAutoLoad(ppu_context* ctx)
+{
+    ctx->gpr[3] = (uint64_t)(int64_t)cellSaveDataUserListAutoLoad(RC_G(3), RC_G(4), RC_G(5),
+        RC_P(CellSaveDataSetList*, 6), RC_P(CellSaveDataSetBuf*, 7), RC_P(CellSaveDataFixedCallback, 8),
+        RC_P(CellSaveDataStatCallback, 9), RC_P(CellSaveDataFileCallback, 10), savedata_arg9(ctx),
+        (void*)(uintptr_t)savedata_arg10(ctx));
+}
