+++ b/libs/video/rsx_oq_rb.h
@@ -0,0 +1,31 @@
+/* R&C patch 7017: report-readback bookkeeping for ZPASS reports (KZ3 patch 2027) when a report offset is reused.
+ *
+ * 2027 answers a GET_REPORT in two steps: at walk time the guest report gets the offset's LAST real count, and a
+ * frame later the readback ring writes this query's count. Both assume one report offset = one object. ToD reuses
+ * offsets for different objects from frame to frame, so
+ *  (1) the walk-time value is another object's count (a hidden object's 0 for Ratchet), and
+ *  (2) an older readback for the offset lands after a newer GET_REPORT at the same offset was walked, writing the
+ *      previous object's count over it.
+ * Either is a wrong 0 the title culls by: the flicker (tods-play-1140; gone with LD_OQ_READBACK=0, tods-play-1137).
+ * Now the walk-time value is the "no count yet" answer cellGcmSys already uses (0xFFFF, visible), and a readback
+ * reaches the guest only if it is the newest GET_REPORT walked for that offset. A count the guest sees is then always
+ * the count of the query it asked for, or "visible". */
+#ifndef RSX_OQ_RB_H
+#define RSX_OQ_RB_H
+#include <stdint.h>
+
+/* Walk-time value for a PENDING report. base (2027): the slot's last count when it has one. */
+static inline uint32_t ld_rbk_walk_value(int fixed, int has_val, uint32_t last_val, uint32_t dflt)
+{
+    if (fixed) return dflt;
+    return has_val ? last_val : dflt;
+}
+
+/* Does the readback ring entry `entry` (0-based ring index) go to the guest? guest_flag: 2027's per-entry mark
+ * (set when its GET_REPORT was walked); newest_guest: index + 1 of the newest walked entry for the same offset. */
+static inline int ld_rbk_drain_to_guest(int fixed, int guest_flag, uint64_t entry, uint64_t newest_guest)
+{
+    if (!guest_flag) return 0;
+    return fixed ? (entry + 1u == newest_guest) : 1;
+}
+#endif
