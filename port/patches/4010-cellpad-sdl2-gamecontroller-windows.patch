diff --git a/CMakeLists.txt b/CMakeLists.txt
index a7c6214..93ea610 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -139,9 +139,26 @@ if(WIN32)
         ole32       # COM for WASAPI audio
         bcrypt      # BCryptGenRandom for SSL RNG
     )
+    # KZ3 patch 4010: cellPad loads SDL3.dll at run time (SDL3 Gamepad, HIDAPI: DualShock 4, DualSense, Switch Pro,
+    # Xbox; motion sensors) and falls back to XInput without it. It declares the SDL3 ABI it uses itself: no SDL3
+    # headers or import library needed. With SDL3's headers found, their values are checked at compile time.
+    option(PS3RECOMP_PAD_SDL3 "Windows: SDL3 Gamepad pads via SDL3.dll loaded at run time" ON)
+    if(PS3RECOMP_PAD_SDL3)
+        target_compile_definitions(ps3recomp_runtime PRIVATE PS3RECOMP_PAD_SDL3)
+        find_package(SDL3 CONFIG QUIET)
+        if(TARGET SDL3::Headers)
+            target_include_directories(ps3recomp_runtime PRIVATE
+                $<TARGET_PROPERTY:SDL3::Headers,INTERFACE_INCLUDE_DIRECTORIES>)
+            message(STATUS "  SDL3:         cellPad loads SDL3.dll at run time (ABI checked against SDL3 headers)")
+        else()
+            message(STATUS "  SDL3:         cellPad loads SDL3.dll at run time (no SDL3 headers: ABI not checked)")
+        endif()
+    endif()
 else()
-    # cellPad and cellAudio select their SDL2 backends unconditionally off
-    # Windows (see PAD_BACKEND_SDL2 / AUDIO_BACKEND_SDL2), so SDL2 is required
+    # KZ3 patch 4010: cellPad loads libSDL3.so.0 at run time (dlopen).
+    target_link_libraries(ps3recomp_runtime PRIVATE ${CMAKE_DL_LIBS})
+    # cellAudio selects its SDL2 backend unconditionally off
+    # Windows (see AUDIO_BACKEND_SDL2), so SDL2 is required
     # here -- docs/BUILDING.md already lists it as the Linux/macOS dependency.
     find_package(SDL2 QUIET)
     if(SDL2_FOUND)
