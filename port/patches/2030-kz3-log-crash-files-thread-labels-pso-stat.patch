+/* KZ3 patch 2030: PSO / shader-compile statistics on the walker thread, one [pso-stat] line per minute of run time
+ * with any PSO built (minute = ms since process start / 60000). For the shader preload decision (RSX pass 31):
+ * miss = the whole PSO cache-miss path (decompile + compile or disk load + CreateGraphicsPipelineState).
+ * LD_PSO_STAT=0 turns it off. */
+typedef struct { unsigned n, max_us; unsigned long long us; } ld_pstat_acc;
+static struct {
+    int on; long long qpf, qpc0, ms0; long long bucket;
+    ld_pstat_acc miss, vsc, psc, create;
+    unsigned disk_v, disk_p, over4, over16, over50;
+    unsigned long long tot_miss, tot_compile; unsigned long long tot_miss_us;
+} g_ld_pstat = { -1 };
+static long long ld_pstat_now_ms(void)
+{
+    LARGE_INTEGER q; QueryPerformanceCounter(&q);
+    return g_ld_pstat.ms0 + (q.QuadPart - g_ld_pstat.qpc0) * 1000 / g_ld_pstat.qpf;
+}
+static int ld_pstat_on(void)
+{
+    if (g_ld_pstat.on < 0) {
+        const char* e = getenv("LD_PSO_STAT");
+        g_ld_pstat.on = !(e && *e == '0');
+        LARGE_INTEGER f, q; QueryPerformanceFrequency(&f); QueryPerformanceCounter(&q);
+        g_ld_pstat.qpf = f.QuadPart; g_ld_pstat.qpc0 = q.QuadPart;
+        FILETIME c, x, k, u, now; GetSystemTimeAsFileTime(&now);
+        g_ld_pstat.ms0 = 0;
+        if (GetProcessTimes(GetCurrentProcess(), &c, &x, &k, &u)) {
+            ULARGE_INTEGER a, b; a.LowPart = c.dwLowDateTime; a.HighPart = c.dwHighDateTime;
+            b.LowPart = now.dwLowDateTime; b.HighPart = now.dwHighDateTime;
+            if (b.QuadPart > a.QuadPart) g_ld_pstat.ms0 = (long long)((b.QuadPart - a.QuadPart) / 10000u);
+        }
+        g_ld_pstat.bucket = -1;
+    }
+    return g_ld_pstat.on;
+}
+static void ld_pstat_acc_add(ld_pstat_acc* a, unsigned us) { a->n++; a->us += us; if (us > a->max_us) a->max_us = us; }
+static unsigned ld_pstat_us(LONGLONG t0) { LARGE_INTEGER q; QueryPerformanceCounter(&q);
+    return (unsigned)((q.QuadPart - t0) * 1000000 / (g_ld_pstat.qpf ? g_ld_pstat.qpf : 1)); }
+static LONGLONG ld_pstat_qpc(void) { LARGE_INTEGER q; QueryPerformanceCounter(&q); return q.QuadPart; }
+/* Called on every PSO miss: closes the previous minute's line when the minute changed. */
+static void ld_pstat_flush_if_new_minute(void)
+{
+    const long long b = ld_pstat_now_ms() / 60000;
+    if (b == g_ld_pstat.bucket) return;
+    if (g_ld_pstat.bucket >= 0 && g_ld_pstat.miss.n)
+        fprintf(stderr, "[pso-stat] min %lld: pso-miss n=%u tot=%.1f ms max=%.1f ms (>4ms %u >16ms %u >50ms %u)"
+                " | vs-compile n=%u tot=%.1f max=%.1f | ps-compile n=%u tot=%.1f max=%.1f | disk-hit vs=%u ps=%u"
+                " | create n=%u tot=%.1f max=%.1f | run total miss=%llu compiles=%llu %.1f ms\n",
+                g_ld_pstat.bucket, g_ld_pstat.miss.n, g_ld_pstat.miss.us / 1e3, g_ld_pstat.miss.max_us / 1e3,
+                g_ld_pstat.over4, g_ld_pstat.over16, g_ld_pstat.over50,
+                g_ld_pstat.vsc.n, g_ld_pstat.vsc.us / 1e3, g_ld_pstat.vsc.max_us / 1e3,
+                g_ld_pstat.psc.n, g_ld_pstat.psc.us / 1e3, g_ld_pstat.psc.max_us / 1e3,
+                g_ld_pstat.disk_v, g_ld_pstat.disk_p,
+                g_ld_pstat.create.n, g_ld_pstat.create.us / 1e3, g_ld_pstat.create.max_us / 1e3,
+                g_ld_pstat.tot_miss, g_ld_pstat.tot_compile, g_ld_pstat.tot_miss_us / 1e3);
+    memset(&g_ld_pstat.miss, 0, sizeof g_ld_pstat.miss); memset(&g_ld_pstat.vsc, 0, sizeof g_ld_pstat.vsc);
+    memset(&g_ld_pstat.psc, 0, sizeof g_ld_pstat.psc); memset(&g_ld_pstat.create, 0, sizeof g_ld_pstat.create);
+    g_ld_pstat.disk_v = g_ld_pstat.disk_p = g_ld_pstat.over4 = g_ld_pstat.over16 = g_ld_pstat.over50 = 0;
+    g_ld_pstat.bucket = b;
+}
+static HRESULT ld_pstat_compile(LPCVOID src, SIZE_T n, LPCSTR name, const D3D_SHADER_MACRO* defs, ID3DInclude* inc,
+                                LPCSTR entry, LPCSTR target, UINT f1, UINT f2, ID3DBlob** code, ID3DBlob** err)
+{
+    const LONGLONG t0 = ld_pstat_qpc();
+    HRESULT hr = D3DCompile(src, n, name, defs, inc, entry, target, f1, f2, code, err);
+    if (g_ld_pstat.on > 0) {
+        ld_pstat_acc_add(target[0] == 'v' ? &g_ld_pstat.vsc : &g_ld_pstat.psc, ld_pstat_us(t0));
+        g_ld_pstat.tot_compile++;
+    }
+    return hr;
+}
+static ID3DBlob* shader_disk_cache_load(u32 stage, const char* source, u32 source_length, u64 hash);
+static ID3DBlob* ld_pstat_disk_load(u32 stage, const char* source, u32 source_length, u64 hash)
+{
+    ID3DBlob* b = shader_disk_cache_load(stage, source, source_length, hash);
+    if (b && g_ld_pstat.on > 0) { if (stage == 'V') g_ld_pstat.disk_v++; else g_ld_pstat.disk_p++; }
+    return b;
+}
