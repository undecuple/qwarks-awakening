+/* KZ3 patch 2040: attribute-major fetch. For each block of RSX_VTX_BLOCK
+ * vertices (the block's output stays in L1/L2) and each layout slot, the
+ * element type and component count are resolved once and a specialised loop
+ * converts the block; a vertex outside the attribute's contiguous mapping, a
+ * frequency-divided attribute, or an attribute with no mapping takes the
+ * per-vertex path of rsx_vertex_fetch_one. The arithmetic per component is
+ * the same expression as rsx_vertex_decode_fast, so the output bytes are
+ * identical (tools/smoke/test_vtx_batch.sh checks this bit for bit). */
+#define RSX_VTX_BLOCK 128u
 
