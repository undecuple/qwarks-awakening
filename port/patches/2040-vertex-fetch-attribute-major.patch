-        if (attr == 0)
-            return 0;
-        memcpy(value, fetch->default_value, 16);
+#define RSX_VTX_BATCH_LOOP(NC, EXPR)                                        \
+    for (u32 i = 0; i < n; i++) {                                           \
+        const u32 el = (rb[i].vertex_id + rb[i].base_index) & 0x000FFFFFu; \
+        float* v = (float*)(ob + (u64)i * out_stride + slot * 16u);         \
+        if (el - first > range) {                                           \
+            if (!rsx_vertex_fetch_attr_one(plan, fetch, attr, &rb[i], v))   \
+                return 0;                                                   \
+            continue;                                                       \
+        }                                                                   \
+        const u8* source = base + (u64)(el - first) * stride;               \
+        v[0] = 0.0f; v[1] = 0.0f; v[2] = 0.0f; v[3] = 1.0f;                 \
+        for (u32 c = 0; c < (NC); c++)                                      \
+            v[c] = (EXPR);                                                  \
+    }
+
+#define RSX_VTX_BATCH_DISPATCH(EXPR)                                        \
+    switch (ncomp) {                                                        \
+    case 1: RSX_VTX_BATCH_LOOP(1u, EXPR) break;                             \
+    case 2: RSX_VTX_BATCH_LOOP(2u, EXPR) break;                             \
+    case 3: RSX_VTX_BATCH_LOOP(3u, EXPR) break;                             \
+    default: RSX_VTX_BATCH_LOOP(4u, EXPR) break;                            \
+    }
+
+int rsx_vertex_fetch_many(
+    const rsx_vertex_fetch_plan* plan, const rsx_vertex_ref* refs, u32 count,
+    u8* out, u32 out_stride)
+{
+    if (!plan || (!refs && count) || (!out && plan->layout.stride && count))
+        return 0;
+    for (u32 b0 = 0; b0 < count; b0 += RSX_VTX_BLOCK) {
+        const u32 n = count - b0 < RSX_VTX_BLOCK ? count - b0 : RSX_VTX_BLOCK;
+        const rsx_vertex_ref* rb = refs + b0;
+        u8* ob = out + (u64)b0 * out_stride;
+        for (u32 slot = 0; slot < plan->layout.count; slot++) {
+            const u32 attr = plan->layout.attrs[slot];
+            const rsx_vertex_fetch_attr* fetch = &plan->attr[attr];
+            if (!fetch->desc.type || !fetch->desc.size) {
+                for (u32 i = 0; i < n; i++)
+                    memcpy(ob + (u64)i * out_stride + slot * 16u,
+                           fetch->default_value, 16);
+                continue;
+            }
+            if (!fetch->stable_base || fetch->desc.frequency > 1 ||
+                fetch->desc.type == RSX_VTX_TYPE_CMP32) {
+                for (u32 i = 0; i < n; i++)
+                    if (!rsx_vertex_fetch_attr_one(
+                            plan, fetch, attr, &rb[i],
+                            (float*)(ob + (u64)i * out_stride + slot * 16u)))
+                        return 0;
+                continue;
+            }
+            const u8* base = fetch->stable_base;
+            const u32 first = fetch->stable_first;
+            const u32 range = fetch->stable_last - fetch->stable_first;
+            const u32 stride = fetch->stride;
+            const u32 ncomp = fetch->desc.size < 4u ? fetch->desc.size : 4u;
+            switch (fetch->desc.type) {
+            case RSX_VTX_TYPE_FLOAT:
+                RSX_VTX_BATCH_DISPATCH(rsx_compact_be_f32(source + c * 4))
+                break;
+            case RSX_VTX_TYPE_HALF:
+                RSX_VTX_BATCH_DISPATCH(rsx_compact_be_f16(source + c * 2))
+                break;
+            case RSX_VTX_TYPE_UNORM8:
+                RSX_VTX_BATCH_DISPATCH(source[c] / 255.0f)
+                break;
+            case RSX_VTX_TYPE_UINT8:
+                RSX_VTX_BATCH_DISPATCH((float)source[c])
+                break;
+            case RSX_VTX_TYPE_SNORM16:
+                RSX_VTX_BATCH_DISPATCH(
+                    (s16)((source[c * 2] << 8) | source[c * 2 + 1]) / 32767.0f)
+                break;
+            case RSX_VTX_TYPE_SINT16:
+                RSX_VTX_BATCH_DISPATCH(
+                    (float)(s16)((source[c * 2] << 8) | source[c * 2 + 1]))
+                break;
+            default:   /* unknown type: fetch_one's per-vertex outcome (default or fatal ATTR0) */
+                for (u32 i = 0; i < n; i++)
+                    if (!rsx_vertex_fetch_attr_one(
+                            plan, fetch, attr, &rb[i],
+                            (float*)(ob + (u64)i * out_stride + slot * 16u)))
+                        return 0;
+                break;
+            }
+        }
     }
     return 1;
 }
