                     c = int.from_bytes(d[o:o+4], 'big')
                     t = int.from_bytes(d[o+4:o+8], 'big')
+                    # The TOC register points 0x8000 into its .toc table, so a
+                    # TOC whose table ends a segment lies up to 0x8000 past the
+                    # segment's end (R&C ToD: third TOC 0x8afe5c, segment ends
+                    # 0x8ad4e8; its 119 dispatchers stayed unresolved).
                     if text_lo <= c < text_hi and (c & 3) == 0 and \
