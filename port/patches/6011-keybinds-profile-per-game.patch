diff -ruN a/libs/input/pad_kb_profile.h b/libs/input/pad_kb_profile.h
--- /dev/null
+++ b/libs/input/pad_kb_profile.h
@@ -0,0 +1,50 @@
+/*
+ * R&C patch 6011: a port's keybinds profile (pure types, C and C++).
+ *
+ * A port that runs several games on one runtime (the Ratchet & Clank collection: one exe per game, one settings
+ * folder per game) gives cellPad its game's profile before the first pad poll (cellPad_keybinds_profile): its default
+ * key table, the uses the file's comments name, the file's title, and a [mouse] section (mouse look on/off,
+ * sensitivity, zoom factor, invert) that the parser reads and the writer keeps. No profile (Project Helghast, every
+ * port that never calls it) = the built-in table and file exactly as before.
+ */
+#ifndef PAD_KB_PROFILE_H
+#define PAD_KB_PROFILE_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* One default binding: input name (pad_kb_inputs[], e.g. "cross", "ls_up"), primary and secondary key codes
+ * (Windows virtual keys of US key positions, as pad_kb_keys[]; 0 = none). Inputs a table leaves out are unbound. */
+typedef struct { const char* in; unsigned char a, b; } PadKbDefKey;
+
+/* The [mouse] section. look/invert: -1 = not set, 0 off, 1 on; sens/zoom: <= 0 = not set. */
+typedef struct {
+    signed char look;
+    signed char invert;
+    float sens;    /* the user factor on 0.022 deg/count (pad_mouse.h; KZ3_MOUSE_SENS) */
+    float zoom;    /* extra factor while zoomed (KZ3_MOUSE_ZOOM_SENS) */
+} PadKbMouse;
+
+/* Input uses for the file's comments, by input name; inputs not listed keep the built-in text. */
+typedef struct { const char* in; const char* what; } PadKbUse;
+
+typedef struct {
+    const char*        title;   /* the file's first line names it ("... key bindings"); NULL = PS3RECOMP_PRODUCT_NAME */
+    const PadKbDefKey* keys;
+    int                nkeys;
+    const PadKbUse*    uses;
+    int                nuses;
+    PadKbMouse         mouse;   /* the defaults of the [mouse] section */
+} PadKbProfile;
+
+/* cellPad.c (Windows): set before the first pad poll (the bindings are read once at the first poll; later calls
+ * are ignored after that). cellPad_keybinds_mouse: loads the file if not loaded yet (written with the profile's
+ * defaults when missing) and copies its [mouse] section; returns 0 without a profile or off Windows. */
+void cellPad_keybinds_profile(const PadKbProfile* p);
+int  cellPad_keybinds_mouse(PadKbMouse* out);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
