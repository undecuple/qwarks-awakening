 }
 
+/* R&C patch 6011 (pad_kb_profile.h): the port's keybinds profile, set before the bindings are first read (a later call
+ * changes nothing: the defaults and the file were already taken). */
+void cellPad_keybinds_profile(const PadKbProfile* p)
+{
+    AcquireSRWLockExclusive(&s_kb_lock);
+    if (!s_kb_ready) pad_kb_profile = p;
+    else printf("[keybinds] profile set after the first read: ignored\n");
+    ReleaseSRWLockExclusive(&s_kb_lock);
+}
+/* The [mouse] section of the file (read now when the bindings were not read yet; the file is written with the
+ * profile's defaults when missing). 0 without a profile. */
+int cellPad_keybinds_mouse(PadKbMouse* out)
+{
+    int ok;
+    AcquireSRWLockExclusive(&s_kb_lock);
+    ok = pad_kb_profile && out;
+    if (ok) { pad_kb_ensure_loaded(); *out = s_kb.mouse; }
+    ReleaseSRWLockExclusive(&s_kb_lock);
+    return ok;
+}
