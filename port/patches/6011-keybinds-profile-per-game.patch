+/* A positive finite number below 1000 from s[0..n), else -1. */
+static float pad_kb_posf(const char* s, size_t n)
+{
+    char t[32];
+    char* e;
+    float v;
+    if (n == 0 || n >= sizeof t) return -1.0f;
+    memcpy(t, s, n); t[n] = 0;
+    v = strtof(t, &e);
+    return (e == t + n && v > 0.0f && v < 1000.0f) ? v : -1.0f;
+}
