+static void guest_callback(u32 opd, u64 cb, u64 get, u64 set, u64 a, u64 b, u64 c, u64 d, u64 e)
+{
+    (void)set; (void)a; (void)b; (void)c; (void)d; (void)e;
+    if (opd == FIXED_OPD || opd == LIST_OPD) {
+        s_fixed_calls += opd == FIXED_OPD;
+        s_seen_dirnum = vm_read32((u32)get);
+        s_seen_num = vm_read32((u32)get + 4);
+        u32 list = vm_read32((u32)get + 8);
+        for (u32 i = 0; i < s_seen_num && i < 8; i++)
+            snprintf(s_seen[i], sizeof s_seen[i], "%.31s", (const char*)vm_base + list + i * 48);
+        /* funcFixed: OK_LAST (listing only). funcList: OK_NEXT with nothing chosen. */
+        vm_write32((u32)cb, opd == FIXED_OPD ? 1u : 0u);
+    } else if (opd == STAT_OPD) {
