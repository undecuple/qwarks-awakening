+};
+
+static void make_fixture(const char* root)
+{
+    char path[1024];
+    for (size_t i = 0; i < sizeof k_saves / sizeof k_saves[0]; i++) {
+        snprintf(path, sizeof path, "%s/%s", root, k_saves[i].name);
+        if (mkdir(path, 0700) != 0) { s_fail++; printf("FAIL: mkdir %s\n", path); continue; }
+        uint8_t sfo[4096];
+        size_t n = ps3_psf_build(sfo, sizeof sfo, k_saves[i].name, "Title", k_saves[i].sub, "Detail", 0, "");
+        snprintf(path, sizeof path, "%s/%s/PARAM.SFO", root, k_saves[i].name);
+        FILE* f = fopen(path, "wb");
+        if (!f || fwrite(sfo, 1, n, f) != n) { s_fail++; printf("FAIL: write %s\n", path); }
+        if (f) fclose(f);
+        set_time(path, k_saves[i].sfo_t);
+        snprintf(path, sizeof path, "%s/%s/SAVE.DAT", root, k_saves[i].name);
+        f = fopen(path, "wb");
+        if (!f || fwrite("data", 1, 4, f) != 4) { s_fail++; printf("FAIL: write %s\n", path); }
+        if (f) fclose(f);
+        set_time(path, k_saves[i].data_t);
+        snprintf(path, sizeof path, "%s/%s", root, k_saves[i].name);
+        set_time(path, k_saves[i].dir_t);
+    }
+}
+
+static void set_list(u32 type, u32 order, u32 dir_max)
+{
+    vm_write32(SETLIST + 0, type);
+    vm_write32(SETLIST + 4, order);
+    vm_write32(SETLIST + 8, PREFIX);
+    vm_write32(SETBUF + 0, dir_max);
+    vm_write32(SETBUF + 32, 8 * 48);
+    vm_write32(SETBUF + 36, LISTBUF);
+}
+
+static void expect_fixed(const char* what, u32 type, u32 order, u32 dir_max, const char* const* want, u32 want_n)
+{
+    set_list(type, order, dir_max);
+    memset(s_seen, 0, sizeof s_seen); s_seen_num = s_seen_dirnum = 0;
+    u32 calls = s_fixed_calls;
+    s32 rc = cellSaveDataFixedLoad2(0, (void*)(uintptr_t)SETLIST, (void*)(uintptr_t)SETBUF,
+                                    (void*)(uintptr_t)FIXED_OPD, (void*)(uintptr_t)STAT_OPD, NULL, 0, NULL);
+    CHECK(rc == CELL_OK && s_fixed_calls == calls + 1, "%s: FixedLoad2 rc=0x%08X calls=%u", what, (unsigned)rc,
+          s_fixed_calls - calls);
+    CHECK(s_seen_dirnum == 5, "%s: dirNum %u, want 5", what, s_seen_dirnum);
+    CHECK(s_seen_num == want_n, "%s: dirListNum %u, want %u", what, s_seen_num, want_n);
+    char got[160] = "", exp[160] = "";
+    /* the last letter names the save (BCUS00000A..E) */
+    for (u32 i = 0; i < s_seen_num && i < 8; i++) { strcat(got, s_seen[i][0] ? s_seen[i] + 9 : "?"); strcat(got, " "); }
+    for (u32 i = 0; i < want_n; i++) { strcat(exp, want[i] + 9); strcat(exp, " "); }
+    CHECK(!strcmp(got, exp), "%s: dirList order [%s], want [%s]", what, got, exp);
+    if (!strcmp(got, exp)) printf("ok   %s: [%s]\n", what, got);
+}
+
+int main(int argc, char** argv)
+{
+    if (argc != 2) { printf("usage: test_savedata_sort SAVE_ROOT\n"); return 2; }
+    snprintf(s_save_root, sizeof s_save_root, "%s", argv[1]);
+    make_fixture(argv[1]);
+    vm_base = calloc(1, 0x200000);
+    if (!vm_base) return 2;
+    if (cellSaveData_set_scratch_region(0x100000, 0x20000) != CELL_OK) { printf("FAIL: scratch region\n"); return 1; }
+    strcpy((char*)vm_base + PREFIX, "BCUS");
+    g_ps3_guest_caller = guest_callback;
+
+    static const char* const time_desc[] = { "BCUS00000E", "BCUS00000B", "BCUS00000C", "BCUS00000D", "BCUS00000A" };
+    static const char* const time_asc[]  = { "BCUS00000A", "BCUS00000D", "BCUS00000C", "BCUS00000B", "BCUS00000E" };
+    static const char* const sub_asc[]   = { "BCUS00000B", "BCUS00000D", "BCUS00000E", "BCUS00000A", "BCUS00000C" };
+    static const char* const sub_desc[]  = { "BCUS00000C", "BCUS00000A", "BCUS00000E", "BCUS00000D", "BCUS00000B" };
+    expect_fixed("MODIFIEDTIME DESCENT", CELL_SAVEDATA_SORTTYPE_MODIFIEDTIME, CELL_SAVEDATA_SORTORDER_DESCENT, 8, time_desc, 5);
+    expect_fixed("MODIFIEDTIME ASCENT",  CELL_SAVEDATA_SORTTYPE_MODIFIEDTIME, CELL_SAVEDATA_SORTORDER_ASCENT,  8, time_asc, 5);
+    expect_fixed("SUBTITLE ASCENT",      CELL_SAVEDATA_SORTTYPE_SUBTITLE,     CELL_SAVEDATA_SORTORDER_ASCENT,  8, sub_asc, 5);
+    expect_fixed("SUBTITLE DESCENT",     CELL_SAVEDATA_SORTTYPE_SUBTITLE,     CELL_SAVEDATA_SORTORDER_DESCENT, 8, sub_desc, 5);
+    expect_fixed("MODIFIEDTIME DESCENT dirListMax=2", CELL_SAVEDATA_SORTTYPE_MODIFIEDTIME,
+                 CELL_SAVEDATA_SORTORDER_DESCENT, 2, time_desc, 2);
+
+    /* ListLoad2 whose funcList chooses nothing loads dirList[0]: the newest save. */
+    set_list(CELL_SAVEDATA_SORTTYPE_MODIFIEDTIME, CELL_SAVEDATA_SORTORDER_DESCENT, 8);
+    s_stat_dir[0] = 0;
+    s32 rc = cellSaveDataListLoad2(0, (void*)(uintptr_t)SETLIST, (void*)(uintptr_t)SETBUF,
+                                   (void*)(uintptr_t)LIST_OPD, (void*)(uintptr_t)STAT_OPD, NULL, 0, NULL);
+    CHECK(rc == CELL_OK && !strcmp(s_stat_dir, "BCUS00000E"),
+          "ListLoad2 fallback loads '%s' (rc=0x%08X), want the newest BCUS00000E", s_stat_dir, (unsigned)rc);
+    if (rc == CELL_OK && !strcmp(s_stat_dir, "BCUS00000E")) printf("ok   ListLoad2 fallback loads the newest save\n");
+
+    /* sortType / sortOrder above 1: parameter error before any callback. */
+    u32 calls = s_fixed_calls;
+    set_list(2, CELL_SAVEDATA_SORTORDER_DESCENT, 8);
+    rc = cellSaveDataFixedLoad2(0, (void*)(uintptr_t)SETLIST, (void*)(uintptr_t)SETBUF,
+                                (void*)(uintptr_t)FIXED_OPD, (void*)(uintptr_t)STAT_OPD, NULL, 0, NULL);
+    CHECK(rc == CELL_SAVEDATA_ERROR_PARAM && s_fixed_calls == calls, "sortType 2: rc=0x%08X, want PARAM", (unsigned)rc);
+    set_list(CELL_SAVEDATA_SORTTYPE_MODIFIEDTIME, 2, 8);
+    rc = cellSaveDataListLoad2(0, (void*)(uintptr_t)SETLIST, (void*)(uintptr_t)SETBUF,
+                               (void*)(uintptr_t)LIST_OPD, (void*)(uintptr_t)STAT_OPD, NULL, 0, NULL);
+    CHECK(rc == CELL_SAVEDATA_ERROR_PARAM, "sortOrder 2: rc=0x%08X, want PARAM", (unsigned)rc);
+    if (s_fail == 0) printf("ok   sortType/sortOrder above 1 are CELL_SAVEDATA_ERROR_PARAM\n");
+
+    free(vm_base);
+    printf("%s (%d failures)\n", s_fail ? "FAIL" : "PASS", s_fail);
+    return s_fail ? 1 : 0;
+}
