--- /dev/null
+++ b/tools/test_savedata_sort.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""cellSaveData hands the title its save directories in the SetList's order.
+
+libs/system/tests/test_savedata_sort.c builds five saves whose name, time and
+SUB_TITLE orders all differ and checks the dirList funcFixed receives for
+CELL_SAVEDATA_SORTTYPE_MODIFIEDTIME / SUBTITLE x SORTORDER_DESCENT / ASCENT,
+the cut to dirListMax after the sort, the save a ListLoad2 falls back to when
+funcList picks none (the newest), and CELL_SAVEDATA_ERROR_PARAM for a
+sortType or sortOrder above 1 (RC patch 7109).
+
+It needs a host C compiler (under CI=1 a missing one fails instead of
+skipping).
+
+Usage:
+    python3 tools/test_savedata_sort.py [--against TREE]
+
+--against TREE builds the same checks against TREE/libs/system/cellSaveData.c
+(the negative control: a tree without patch 7109 must FAIL).
+"""
+
+import argparse
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(TOOLS)
+SOURCE = os.path.join(ROOT, "libs", "system", "tests", "test_savedata_sort.c")
+
+
+def _cc():
+    return (shutil.which(os.environ.get("CC", "cc")) or shutil.which("clang")
+            or shutil.which("gcc"))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--against", help="tree whose libs/system/cellSaveData.c is tested (default: this one)")
+    args = ap.parse_args()
+    tree = os.path.abspath(args.against) if args.against else ROOT
+
+    cc = _cc()
+    if cc is None:
+        if os.environ.get("CI"):
+            print("FAIL: no C compiler found")
+            return 1
+        print("skip test_savedata_sort.c: no C compiler")
+        return 0
+    with tempfile.TemporaryDirectory() as td:
+        exe = os.path.join(td, "test_savedata_sort")
+        cmd = [cc, "-std=gnu17", "-w", "-I" + os.path.join(tree, "include"), "-o", exe, SOURCE]
+        if args.against:
+            cmd.insert(3, '-DSAVEDATA_SRC="%s"' % os.path.join(tree, "libs", "system", "cellSaveData.c"))
+        r = subprocess.run(cmd, capture_output=True, text=True)
+        if r.returncode != 0:
+            print("FAIL: fixture did not build")
+            print((r.stdout + r.stderr)[-4000:])
+            return 1
+        saves = os.path.join(td, "saves")
+        os.mkdir(saves)
+        r = subprocess.run([exe, saves], capture_output=True, text=True)
+        lines = [l for l in r.stdout.splitlines() if not l.startswith("[cellSaveData]")]
+        print("\n".join(lines))
+        if r.returncode != 0 and not lines[-1:] == ["FAIL"]:
+            print(r.stderr[-2000:])
+        return 1 if r.returncode != 0 else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
