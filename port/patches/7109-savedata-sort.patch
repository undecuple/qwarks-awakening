+/* ---------------------------------------------------------------------------
+ * RC patch 7109: dirList order (CellSaveDataSetList sortType / sortOrder)
+ *
+ * The firmware hands funcList / funcFixed the matching save directories sorted by the title's SetList:
+ * CELL_SAVEDATA_SORTTYPE_MODIFIEDTIME (0) or SUBTITLE (1), CELL_SAVEDATA_SORTORDER_DESCENT (0) or ASCENT (1); a
+ * value above 1 is a parameter error. Ties: MODIFIEDTIME falls back to SUB_TITLE and SUBTITLE to the time (RPCS3
+ * cellSaveData.cpp savedata_op, read for behaviour only, nothing copied). The directory name is the last key so the
+ * order never depends on the host's directory order. Before this patch dirList came in readdir / FindFirstFile order,
+ * so a title that loads its first entry (or the fallback below when funcList picks nothing) took the first save by
+ * name, not the newest.
+ *
+ * ASSUMPTION: the firmware sorts every matching directory before it cuts the list to dirListMax (RPCS3 cuts first,
+ * in host directory order, then sorts).
+ * ASSUMPTION: the time key is the newest of the directory's own mtime, PARAM.SFO and its files' mtimes. On the PS3
+ * (and in RPCS3, which writes a save into a fresh directory and renames it) the directory's mtime is the last save;
+ * this backend rewrites the files in place, which leaves the directory's mtime at its creation.
+ * -----------------------------------------------------------------------*/
+static int savedata_host_mtime(const char* path, s64* out)
+{
+    HOST_STAT_T st;
+    if (HOST_STAT(path, &st) != 0) return 0;
+#ifdef _WIN32
+    *out = (s64)st.st_mtime;
+#elif defined(__APPLE__)
+    *out = (s64)st.st_mtimespec.tv_sec;
+#else
+    *out = (s64)st.st_mtim.tv_sec;
+#endif
+    return 1;
+}
+
+static s64 savedata_dir_sort_time(const char* save_path)
+{
+    s64 newest = 0, t;
+    if (savedata_host_mtime(save_path, &t) && t > newest) newest = t;
+    char sfo[1024];
+    snprintf(sfo, sizeof(sfo), "%s/PARAM.SFO", save_path);
+#ifdef _WIN32
+    for (char* p = sfo; *p; p++) if (*p == '/') *p = '\\';
+#endif
+    if (savedata_host_mtime(sfo, &t) && t > newest) newest = t;
+    /* Every file in it (enumerate_save_files leaves st_mtime 0 on Windows, so this reads the times itself). */
+#ifdef _WIN32
+    char search[1024];
+    snprintf(search, sizeof(search), "%s\\*", save_path);
+    for (char* p = search; *p; p++) if (*p == '/') *p = '\\';
+    WIN32_FIND_DATAA fd;
+    HANDLE h = FindFirstFileA(search, &fd);
+    if (h != INVALID_HANDLE_VALUE) {
+        do {
+            if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+            ULARGE_INTEGER ft;   /* 100 ns ticks since 1601-01-01 -> Unix seconds */
+            ft.LowPart = fd.ftLastWriteTime.dwLowDateTime;
+            ft.HighPart = fd.ftLastWriteTime.dwHighDateTime;
+            if (ft.QuadPart < 116444736000000000ull) continue;
+            t = (s64)((ft.QuadPart - 116444736000000000ull) / 10000000ull);
+            if (t > newest) newest = t;
+        } while (FindNextFileA(h, &fd));
+        FindClose(h);
+    }
+#else
+    DIR* dp = opendir(save_path);
+    if (dp) {
+        struct dirent* de;
+        while ((de = readdir(dp)) != NULL) {
+            if (de->d_name[0] == '.') continue;
+            char full[1024];
+            snprintf(full, sizeof(full), "%s/%s", save_path, de->d_name);
+            if (!dir_exists(full) && savedata_host_mtime(full, &t) && t > newest) newest = t;
+        }
+        closedir(dp);
+    }
+#endif
+    return newest;
+}
+
+typedef struct SaveDataSortEntry {
+    CellSaveDataDirList dir;
+    s64  mtime;
+    char subtitle[CELL_SAVEDATA_SYSP_SUBTITLE_SIZE];
+    u32  type;   /* the sortType, so the qsort comparator needs no global */
+    int  sign;   /* +1 ASCENT, -1 DESCENT */
+} SaveDataSortEntry;
+
+static int savedata_sort_cmp(const void* pa, const void* pb)
+{
+    const SaveDataSortEntry* a = (const SaveDataSortEntry*)pa;
+    const SaveDataSortEntry* b = (const SaveDataSortEntry*)pb;
+    int t = a->mtime < b->mtime ? -1 : a->mtime > b->mtime ? 1 : 0;
+    int s = strcmp(a->subtitle, b->subtitle);   /* bytes as unsigned char, as std::string's operator< */
+    int c = a->type == CELL_SAVEDATA_SORTTYPE_SUBTITLE ? (s ? s : t) : (t ? t : s);
+    if (!c) c = strncmp(a->dir.dirName, b->dir.dirName, CELL_SAVEDATA_DIRNAME_SIZE);
+    return a->sign * c;
+}
+
+static void savedata_sort_dirs(CellSaveDataDirList* all, u32 count, u32 sort_type, u32 sort_order)
+{
+    if (!all || count < 2) return;
+    SaveDataSortEntry* e = (SaveDataSortEntry*)calloc(count, sizeof(*e));
+    if (!e) return;
+    CellSaveDataSystemFileParam* sfo = (CellSaveDataSystemFileParam*)malloc(sizeof(*sfo));
+    if (!sfo) { free(e); return; }
+    for (u32 i = 0; i < count; i++) {
+        char path[1024];
+        e[i].dir = all[i];
+        build_save_path(path, sizeof(path), all[i].dirName);
+        e[i].mtime = savedata_dir_sort_time(path);
+        read_param_sfo(path, sfo);
+        snprintf(e[i].subtitle, sizeof(e[i].subtitle), "%.*s", (int)sizeof(sfo->subTitle) - 1, sfo->subTitle);
+        e[i].type = sort_type;
+        e[i].sign = sort_order == CELL_SAVEDATA_SORTORDER_ASCENT ? 1 : -1;
+    }
+    free(sfo);
+    qsort(e, count, sizeof(*e), savedata_sort_cmp);
+    for (u32 i = 0; i < count; i++) all[i] = e[i].dir;
+    printf("[cellSaveData] dirList sorted by %s %s (%u dirs): first='%s'\n",
+           sort_type == CELL_SAVEDATA_SORTTYPE_SUBTITLE ? "subtitle" : "mtime",
+           sort_order == CELL_SAVEDATA_SORTORDER_ASCENT ? "ascent" : "descent", count, all[0].dirName);
+    free(e);
+}
