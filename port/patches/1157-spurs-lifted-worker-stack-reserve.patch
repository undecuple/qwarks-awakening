@@ -0,0 +1,12 @@
+#include "../spu_host_stack.h"
+
+#include <stdio.h>
+
+int main(int argc, char** argv)
+{
+    if (argc != 2) return 2;
+    const size_t expected = (size_t)strtoull(argv[1], NULL, 0);
+    const size_t actual = spu_host_stack_bytes();
+    printf("SPU host stack: %zu bytes\n", actual);
+    return actual == expected ? 0 : 1;
+}
