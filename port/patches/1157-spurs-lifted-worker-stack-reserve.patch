diff --git a/tools/test_spu_host_stack.py b/tools/test_spu_host_stack.py
new file mode 100644
index 0000000..4d8e2b8
--- /dev/null
+++ b/tools/test_spu_host_stack.py
@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+"""Check the shared host-stack reservation used by lifted SPU threads."""
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+SPU = ROOT / "runtime/spu"
+cc = os.environ.get("CC")
+cache = ROOT / "build/CMakeCache.txt"
+if not cc and cache.is_file():
+    match = re.search(r"^CMAKE_C_COMPILER:[^=]+=([^\r\n]+)$", cache.read_text(), re.M)
+    if match:
+        cc = match[1]
+        if Path(cc).stem.lower() == "clang-cl":
+            cc = str(Path(cc).with_name("clang" + Path(cc).suffix))
+if not cc:
+    cc = shutil.which("clang") if os.name == "nt" else shutil.which("cc")
+if not cc:
+    raise SystemExit("FAILED: a C compiler is required")
+
+spurs = (ROOT / "libs/spurs/cellSpurs.c").read_text(encoding="utf-8")
+for target in ("spurs_kernel_thread", "kz3_lane_thread", "spurs_pm_worker", "jc_thread"):
+    call = re.compile(
+        r"CreateThread\(NULL,\s*spu_host_stack_bytes\(\),\s*" + target
+        + r",.*?SPURS_LIFTED_STACK_FLAGS",
+        re.S,
+    )
+    assert len(call.findall(spurs)) == 1, target + " must use the shared lifted-SPU stack reservation"
+
+with tempfile.TemporaryDirectory(prefix="spu-host-stack-") as temp:
+    binary = Path(temp) / ("test.exe" if os.name == "nt" else "test")
+    subprocess.run(
+        [
+            cc,
+            "-std=c11",
+            "-O2",
+            "-I" + str(SPU),
+            str(SPU / "tests/test_spu_host_stack.c"),
+            "-o",
+            str(binary),
+        ],
+        check=True,
+    )
+    env = dict(os.environ)
+    env.pop("SPU_HOST_STACK_BIG", None)
+    subprocess.run([str(binary), str(16 * 1024 * 1024)], env=env, check=True)
+    env["SPU_HOST_STACK_BIG"] = "1"
+    subprocess.run([str(binary), str(512 * 1024 * 1024)], env=env, check=True)
+print("PASS shared SPU host stack reservation")
