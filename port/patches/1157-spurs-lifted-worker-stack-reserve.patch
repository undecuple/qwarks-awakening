diff --git a/runtime/spu/spu_host_stack.h b/runtime/spu/spu_host_stack.h
new file mode 100644
index 0000000..608c92d
--- /dev/null
+++ b/runtime/spu/spu_host_stack.h
@@ -0,0 +1,16 @@
+#ifndef PS3RECOMP_SPU_HOST_STACK_H
+#define PS3RECOMP_SPU_HOST_STACK_H
+
+#include <stddef.h>
+#include <stdlib.h>
+
+/* Lifted SPU calls are host calls. A host-default stack can overflow during a
+ * valid guest call chain, so every ordinary and SPURS lifted-code thread uses
+ * this reservation. The larger setting is for diagnosing runaway chains. */
+static inline size_t spu_host_stack_bytes(void)
+{
+    return getenv("SPU_HOST_STACK_BIG") ? (size_t)512 * 1024 * 1024
+                                        : (size_t)16 * 1024 * 1024;
+}
+
+#endif
