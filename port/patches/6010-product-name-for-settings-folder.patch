+        _snwprintf(dir, 1024, L"%ls\\%hs", appdata, PS3RECOMP_PRODUCT_NAME);   /* patch 6010 */ dir[1023] = 0;
         CreateDirectoryW(dir, NULL);                  /* exists already = fine */
         _snwprintf(s_kb_path, 1024, L"%ls\\keybinds.ini", dir); s_kb_path[1023] = 0;
         return;
