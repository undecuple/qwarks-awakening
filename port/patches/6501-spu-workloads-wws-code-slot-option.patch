+#!/usr/bin/env python3
+"""build_spu_workloads --wws-code-slot: the generated registry sets a policy module's WWS code-buffer slot (patch 6501).
+
+Synthetic image names and fingerprints, no guest assets. Run: python3 tools/test_build_spu_workloads_wws_slot.py
+"""
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+TOOLS = Path(__file__).resolve().parent
+sys.path.insert(0, str(TOOLS))
+import build_spu_workloads as bsw  # noqa: E402
+
+
+class Args:
+    def __init__(self, out, slots=None):
+        self.out, self.title, self.register_fn, self.constructor = out, "test", "t_register_all", True
+        if slots is not None:
+            self.wws_code_slots = slots
+
+
+IMGS = [("elf_a", "elf_a_", 0x1111, 0x3000), ("pm_b", "pm_b_", 0x2222, 0xA00)]
+
+
+class WwsCodeSlot(unittest.TestCase):
+    def emit(self, slots, image_ids=None):
+        with tempfile.TemporaryDirectory() as d:
+            out = Path(d) / "spu_workloads.c"
+            bsw.write_registry(Args(str(out), slots), IMGS, {}, image_ids)
+            return out.read_text()
+
+    def test_default_emits_no_slot_call(self):
+        self.assertNotIn("spu_wws_set_code_buffer_slot", self.emit(None))
+        self.assertNotIn("spu_wws_set_code_buffer_slot", self.emit({}))
+
+    def test_slot_call_uses_the_policy_module_image_id(self):
+        text = self.emit({"pm_b": 0x1330}, {"elf_a": 30, "pm_b": 2})
+        self.assertEqual(text.count("spu_wws_set_code_buffer_slot"), 1)
+        lines = text.splitlines()
+        reg = next(i for i, l in enumerate(lines) if "spu_workload_register_img" in l and '"pm_b"' in l)
+        self.assertEqual(lines[reg + 1].strip(), "spu_wws_set_code_buffer_slot(2, 0x1330);")
+
+    def test_slot_call_with_positional_ids(self):
+        self.assertIn("spu_wws_set_code_buffer_slot(2, 0x1330);", self.emit({"pm_b": 0x1330}))
+
+    def test_unknown_image_is_refused(self):
+        with self.assertRaises(SystemExit):
+            self.emit({"pm_c": 0x1330})
+
+    def test_parse(self):
+        self.assertEqual(bsw.parse_wws_code_slots(["pm_b=0x1330", " elf_a = 4896 "]), {"pm_b": 0x1330, "elf_a": 0x1320})
+        for bad in (["pm_b"], ["pm_b=0x1334"], ["pm_b=0"], ["pm_b=0x40000"]):
+            with self.assertRaises(SystemExit):
+                bsw.parse_wws_code_slots(bad)
+
+
+if __name__ == "__main__":
+    unittest.main()
