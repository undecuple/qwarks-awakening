+def parse_wws_code_slots(specs):
+    """--wws-code-slot IMAGE=LSA values -> {image: lsa}; LSA must be a quadword address inside the 256 KB LS."""
+    slots = {}
+    for spec in specs or []:
+        if "=" not in spec:
+            sys.exit(f"[build_spu_workloads] --wws-code-slot wants IMAGE=LSA, got {spec!r}")
+        k, v = spec.split("=", 1)
+        lsa = int(v.strip(), 0)
+        if lsa & 0xF or not 0 < lsa < 0x40000:
+            sys.exit(f"[build_spu_workloads] --wws-code-slot {spec!r}: LSA must be a non-zero quadword address below 0x40000")
+        slots[k.strip()] = lsa
+    return slots
+
