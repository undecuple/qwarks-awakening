+/* R&C patch 7115: the SPU-thread local-store window.
+ *
+ * lv2 lets every SPU thread of a thread group reach the local store (and the
+ * problem-state registers) of the other threads of ITS group by DMA, at
+ *
+ *   0xF0000000 + n*0x100000 + 0x00000   LS of SPU thread n of the group (256 KB)
+ *   0xF0000000 + n*0x100000 + 0x40000   its problem state (SNR1 at +0x5400C,
+ *                                       SNR2 at +0x5C00C)
+ *
+ * n is the thread's number within the group (sys_spu_thread_initialize's
+ * thread_num; for a SPURS instance, its SPU index 0..nSpus-1). The window is
+ * relative to the ISSUING thread's group, so the same EA names different
+ * stores in different groups, and the PPU has no mapping there (it uses
+ * sys_spu_thread_read_ls / write_ls). A context's local store here is a host
+ * buffer (ls_store), not guest memory, so a DMA in this range must be served
+ * from the peer's buffer: through the plain path it read and wrote whatever
+ * vm_base held at 0xF0000000+ (a demand-committed zero page). Insomniac's ig
+ * collision jobs depend on it: the broadphase writes its candidate items to its
+ * own LS 0x7380 and publishes 0xF0000000 + 0x7380 as the cursor, and the narrow
+ * phase GETs the items from there (Nexus 1.01; docs: the RE notes).
+ *
+ * The runtime records which context is thread n of which group in a small
+ * table (spu_channels.c): lv2 groups at group_start, SPURS instances at each
+ * policy-module run (the context then on SPU n). An unknown issuer or an empty
+ * slot keeps the old plain-memory path and says so once. */
+#define SPU_THREAD_LS_BASE    0xF0000000u
+#define SPU_THREAD_LS_STRIDE  0x00100000u
+#define SPU_THREAD_LS_PROB    0x00040000u      /* LS below, problem state above */
+#define SPU_GROUP_LS_LV2      1u               /* key = lv2 SPU thread group id */
+#define SPU_GROUP_LS_SPURS    2u               /* key = SPURS instance EA */
+/* Bind ctx as thread `index` of group (kind, key); replaces the previous holder
+ * of that slot and any other slot ctx held. ctx NULL clears the slot. */
+void     spu_group_ls_bind(uint32_t kind, uint32_t key, uint32_t index, spu_context* ctx);
+/* Forget every slot ctx holds (before the context is freed). */
+void     spu_group_ls_unbind(const spu_context* ctx);
+/* Local store of thread n of the issuer's group, or NULL when the issuer is in
+ * no known group or slot n is empty. */
+uint8_t* spu_group_ls_peer(const spu_context* issuer, uint32_t n);
+
+/* Serve one transfer element whose EA is in [0xF0000000, 4 GB). Returns 0 when
+ * served, 1 to leave it to the plain path (not resolvable here). */
+static inline int mfc_thread_ls_window(spu_context* spu, uint32_t lsa, uint32_t ea,
+                                       uint32_t size, uint32_t cmd)
+{
+    const uint32_t n   = (ea - SPU_THREAD_LS_BASE) / SPU_THREAD_LS_STRIDE;
+    const uint32_t off = (ea - SPU_THREAD_LS_BASE) % SPU_THREAD_LS_STRIDE;
+    if (off >= SPU_THREAD_LS_PROB || size > SPU_THREAD_LS_PROB - off) {
+        /* Problem state (a sndsig to a peer's SNR, a register read) or a
+         * transfer running off the end of the LS: not modelled for SPU threads
+         * (the raw-SPU window's registers are served for PPU loads/stores only,
+         * spu_raw.c). The plain path keeps its old behaviour. */
+        static int _n = 0;
+        if (PS3_LOG_FIRST(_n, 4))
+            fprintf(stderr, "[spu-tlsw] UNSUPPORTED %s img=%d pc=0x%05X ea=0x%08X size=%u: SPU thread %u "
+                    "problem state (+0x%05X) is not modelled; plain memory\n",
+                    mfc_is_get(cmd) ? "GET" : "PUT", spu->image_id, (uint32_t)spu->pc & SPU_LS_MASK,
+                    ea, size, n, off);
+        return 1;
+    }
+    uint8_t* peer = spu_group_ls_peer(spu, n);
+    if (!peer) {
+        static int _n = 0;
+        if (PS3_LOG_FIRST(_n, 8))
+            fprintf(stderr, "[spu-tlsw] UNRESOLVED %s img=%d pc=0x%05X ea=0x%08X size=%u: no SPU thread %u "
+                    "known in this context's group; plain memory\n",
+                    mfc_is_get(cmd) ? "GET" : "PUT", spu->image_id, (uint32_t)spu->pc & SPU_LS_MASK,
+                    ea, size, n);
+        return 1;
+    }
+    uint8_t* mine = &spu->ls[lsa];
+    if (mfc_is_get(cmd)) {
+        memmove(mine, peer + off, size);       /* n may be the issuer itself */
+        extern void spu_overlay_note_get(spu_context*, uint32_t, const uint8_t*, uint32_t);
+        spu_overlay_note_get(spu, ea, (const uint8_t*)mine, size);
+    } else if (mfc_is_put(cmd)) {
+        memmove(peer + off, mine, size);
+    }
+    { static int _n = 0; static int s_all = -1;
+      if (s_all < 0) s_all = getenv("SPU_TLSW_LOG") ? 1 : 0;
+      if (s_all || PS3_LOG_FIRST(_n, 4))
+          fprintf(stderr, "[spu-tlsw] %s img=%d pc=0x%05X lsa=0x%05X <-> SPU thread %u LS 0x%05X size=%u\n",
+                  mfc_is_get(cmd) ? "GET" : "PUT", spu->image_id, (uint32_t)spu->pc & SPU_LS_MASK,
+                  lsa, n, off, size); }
+    return 0;
+}
