+/* R&C patch 7115: which context is SPU thread n of which group, for the SPU-thread LS window (spu_dma.h,
+ * mfc_thread_ls_window). A slot is (kind, key, index): kind SPU_GROUP_LS_LV2 keys an lv2 thread group by id,
+ * SPU_GROUP_LS_SPURS a SPURS instance by its EA (its SPU threads are the kernel's SPUs 0..nSpus-1). A context holds
+ * at most one slot. Lookups run only for DMAs into the window; writers are group_start / destroy and each
+ * policy-module run. Pointers stay valid while bound: lv2 unbinds before it frees a thread's context, and SPURS policy
+ * contexts are never freed. */
+#define SPU_GROUP_LS_MAX 128
+static struct { uint32_t kind, key, index; spu_context* ctx; } s_group_ls[SPU_GROUP_LS_MAX];
+static SRWLOCK s_group_ls_lock = SRWLOCK_INIT;
+void spu_group_ls_bind(uint32_t kind, uint32_t key, uint32_t index, spu_context* ctx)
+{
+    AcquireSRWLockExclusive(&s_group_ls_lock);
+    int slot = -1;
+    for (int i = 0; i < SPU_GROUP_LS_MAX; i++) {
+        if (!s_group_ls[i].ctx) { if (slot < 0) slot = i; continue; }
+        if ((ctx && s_group_ls[i].ctx == ctx) ||
+            (s_group_ls[i].kind == kind && s_group_ls[i].key == key && s_group_ls[i].index == index)) {
+            s_group_ls[i].ctx = NULL;
+            if (slot < 0) slot = i;
+        }
+    }
+    if (ctx && slot >= 0) {
+        s_group_ls[slot].kind = kind; s_group_ls[slot].key = key; s_group_ls[slot].index = index;
+        s_group_ls[slot].ctx = ctx;
+    }
+    ReleaseSRWLockExclusive(&s_group_ls_lock);
+    if (ctx && slot < 0) {
+        static int _n = 0;
+        if (PS3_LOG_FIRST(_n, 4))
+            fprintf(stderr, "[spu-tlsw] group table full (%d): thread %u of %s 0x%X not bound\n", SPU_GROUP_LS_MAX,
+                    index, kind == SPU_GROUP_LS_SPURS ? "SPURS" : "group", key);
+    }
+}
+void spu_group_ls_unbind(const spu_context* ctx)
+{
+    if (!ctx) return;
+    AcquireSRWLockExclusive(&s_group_ls_lock);
+    for (int i = 0; i < SPU_GROUP_LS_MAX; i++)
+        if (s_group_ls[i].ctx == ctx) s_group_ls[i].ctx = NULL;
+    ReleaseSRWLockExclusive(&s_group_ls_lock);
+}
+uint8_t* spu_group_ls_peer(const spu_context* issuer, uint32_t n)
+{
+    uint8_t* ls = NULL;
+    AcquireSRWLockShared(&s_group_ls_lock);
+    for (int i = 0; i < SPU_GROUP_LS_MAX; i++) {
+        if (s_group_ls[i].ctx != issuer) continue;
+        const uint32_t kind = s_group_ls[i].kind, key = s_group_ls[i].key;
+        for (int j = 0; j < SPU_GROUP_LS_MAX; j++)
+            if (s_group_ls[j].ctx && s_group_ls[j].kind == kind && s_group_ls[j].key == key &&
+                s_group_ls[j].index == n) { ls = s_group_ls[j].ctx->ls; break; }
+        break;
+    }
+    ReleaseSRWLockShared(&s_group_ls_lock);
+    return ls;
+}
