+void rsx_dispatch_destroy(rsx_dispatch* rsx)
+{
+    free(rsx->inline_data);
+    rsx->inline_data = NULL;
+    rsx->inline_cap = 0;
+    rsx->inline_len = 0;
+}
+
+/* Make room for `need` bytes (doubling from RSX_DSP_INLINE_MAX_BYTES). 0 on allocation failure or past 2 GB. */
+static int inline_reserve(rsx_dispatch* rsx, u32 need)
+{
+    if (need <= rsx->inline_cap) return 1;
+    u32 cap = rsx->inline_cap ? rsx->inline_cap : RSX_DSP_INLINE_MAX_BYTES;
+    while (cap < need) {
+        if (cap > 0x40000000u) return 0;
+        cap *= 2u;
+    }
+    u8* p = (u8*)realloc(rsx->inline_data, cap);
+    if (!p) return 0;
+    rsx->inline_data = p;
+    rsx->inline_cap = cap;
+    return 1;
+}
+
