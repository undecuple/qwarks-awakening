+
+/* ---- patch 7030: _cellSpursLFQueuePushBody (NID 0x8A85674D) ----
+ * Producer side of the guest-visible CellSyncLFQueue line (layout: Initialize above, evidence in the SPU consumer lifts).
+ * Indices run modulo 2*depth; the consumer finds data only through push-completed (+0x08) against pop-in-flight (+0x06). */
+#define RC_LFQ_ERR_AGAIN   0x80410901u   /* TASK-series AGAIN: the only non-zero func_00717068 maps to "full, retry" */
+#define RC_LFQ_ERR_PERM    0x80410109u
+#define RC_LFQ_ERR_ALIGN   0x80410110u
+#define RC_LFQ_ERR_NULL    0x80410111u
+
+/* Optional PPU stop request for a blocking push (the runtime has no such flag today: the process ends with exit()). */
+int (*g_rc_lfq_stop_requested)(void);
+
+static inline u16 rc_lfq_r16(u32 a) { return vm_read16(a); }
+/* Raw store: only under the line's lock (vm_write16 would take it again). */
+static inline void rc_lfq_w16(u32 a, u16 v) { u16 r = ps3_bswap16(v); memcpy(vm_ptr8(a), &r, 2); }
+
+static void rc_lfq_dump(const char* tag, u32 q)
+{
+    printf("[cellSpurs] LFQueuePush line %s q=0x%08X\n", tag, q);
+    for (u32 r = 0; r < 128; r += 16)
+        printf("[cellSpurs]   +%02X %08X %08X %08X %08X\n", r, vm_read32(q + r), vm_read32(q + r + 4), vm_read32(q + r + 8), vm_read32(q + r + 12));
+}
+
+/* Phase 1: reserve a slot. Returns 1 and the slot index, or 0 when full. */
+static int rc_lfq_reserve(u32 q, u32 depth, u32* slot)
+{
+    int ok = 0;
+    PPU_LL_DECL(llm, q, 128);
+    PPU_LL_LOCK(llm);
+    u32 h1 = rc_lfq_r16(q + 0x00), h8 = rc_lfq_r16(q + 0x0E), mod = 2 * depth;
+    if (((h8 + mod - h1) % mod) < depth) {
+        *slot = h8;
+        rc_lfq_w16(q + 0x0E, (u16)((h8 + 1) % mod));
+        if (spu_coh_is_reserved(q & ~127u)) spu_coh_notify_write(q & ~127u);
+        ok = 1;
+    }
+    PPU_LL_UNLOCK(llm);
+    return ok;
+}
+
+/* Phase 3: publish the slot (h5, out-of-order bitmap h6) and take one waiting consumer off the ring (pack at +0x30 for
+ * direction 2, +0x04 for direction 3 -- ASSUMPTION). Returns the waiter's task id, or -1 for none. */
+static int rc_lfq_publish(u32 q, u32 depth, u32 slot, u32 direction)
+{
+    int waiter = -1;
+    u32 mod = 2 * depth;
+    PPU_LL_DECL(llm, q, 128);
+    PPU_LL_LOCK(llm);
+    u32 h5 = rc_lfq_r16(q + 0x08), h6 = rc_lfq_r16(q + 0x0A);
+    u32 off = (slot + mod - h5) % mod;
+    /* bit k of R = slot h5+k completed (bit 0 = the pending slot h5); h6 stores R >> 1 */
+    u32 R = (h6 << 1) | (1u << off);
+    while (R & 1) { h5 = (h5 + 1) % mod; R >>= 1; }
+    rc_lfq_w16(q + 0x08, (u16)h5);
+    rc_lfq_w16(q + 0x0A, (u16)(R >> 1));
+    u32 pa = q + (direction == 3 ? 0x04 : 0x30), ids = q + 0x32;
+    u32 pack = rc_lfq_r16(pa), tail = pack & 0x1F, head = (pack >> 10) & 0x1F;
+    if (head != tail && head < 30) {
+        waiter = rc_lfq_r16(ids + 2 * (head >= 15 ? head - 15 : head));
+        head = head >= 29 ? 0 : head + 1;
+        rc_lfq_w16(pa, (u16)((pack & ~(0x1Fu << 10)) | (head << 10)));
+    }
+    if (spu_coh_is_reserved(q & ~127u)) spu_coh_notify_write(q & ~127u);
+    PPU_LL_UNLOCK(llm);
+    return waiter;
+}
+
+s32 _cellSpursLFQueuePushBody(u64 queue_ea, u64 elem_ea, u64 is_blocking)
+{
+    u32 q = (u32)queue_ea, src = (u32)elem_ea;
+    if (!q || !src) return (s32)RC_LFQ_ERR_NULL;
+    if ((q & 0x7F) || (src & 0xF)) return (s32)RC_LFQ_ERR_ALIGN;
+    u32 direction = vm_read32(q + 0x24);
+    if (direction != 2 && direction != 3) return (s32)RC_LFQ_ERR_PERM;   /* 0/1: SPU-side producers */
+    u32 size = vm_read32(q + 0x10), depth = vm_read32(q + 0x14);
+    u64 buf = vm_read64(q + 0x18) & ~1ull;
+    if (!size || !depth || depth > 15 || !buf) return (s32)RC_LFQ_ERR_PERM;   /* queue was never initialised */
+
+    static int _n = 0;
+    int logit = PS3_LOG_FIRST(_n, 3);
+    if (logit) rc_lfq_dump("before", q);
+
+    u32 slot = 0;
+    while (!rc_lfq_reserve(q, depth, &slot)) {
+        if (!(u32)is_blocking) return (s32)RC_LFQ_ERR_AGAIN;
+        if (g_rc_lfq_stop_requested && g_rc_lfq_stop_requested()) return (s32)RC_LFQ_ERR_AGAIN;
+#ifdef _WIN32
+        Sleep(1);
+#else
+        struct timespec ts = { 0, 200000 };
+        nanosleep(&ts, NULL);
+#endif
+    }
+    u32 dst = (u32)buf + size * (slot >= depth ? slot - depth : slot);
+    vm_memcpy_to(dst, vm_ptr8(src), size);     /* the element is in place before h5 can move past it */
+    int waiter = rc_lfq_publish(q, depth, slot, direction);
+    if (waiter >= 0) {
+        u32 owner = (u32)vm_read64(q + 0x70) & ~1u;
+        if (owner) spu_taskset_signal_task(owner, (u32)waiter);
+    }
+    if (logit) {
+        printf("[cellSpurs] LFQueuePush(q=0x%08X dir=%u slot=%u dst=0x%08X waiter=%d)\n", q, direction, slot, dst, waiter);
+        rc_lfq_dump("after", q);
+    }
+    return CELL_OK;
+}
