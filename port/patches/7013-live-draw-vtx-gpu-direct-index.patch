diff --git a/libs/video/rsx_vg_index.h b/libs/video/rsx_vg_index.h
new file mode 100644
index 0000000..1b54f39
--- /dev/null
+++ b/libs/video/rsx_vg_index.h
@@ -0,0 +1,51 @@
+/*
+ * R&C patch 7013: direct index buffers for GPU-fetch draws (LD_VTX_GPU_INDEX=1, with LD_VTX_GPU=1; default off).
+ *
+ * An indexed TRIANGLES draw on the GPU-fetch path (KZ3 patch 2076) used to turn every index occurrence into a
+ * {vertex_id, base_index} reference (refs), collapse them to unique vertices with a hash (remap), upload one u32
+ * element per unique vertex and an occurrence -> unique index buffer. With this path the guest index buffer itself
+ * becomes the D3D index buffer (big-endian u16/u32 -> little-endian u32), the vertex buffer is a fixed identity table
+ * (entry k = k) and the draw's BaseVertexLocation is the RSX base index, so the vertex shader receives
+ * element = index + base_index, exactly rsx_vg_element({index, base_index}) as long as index + base_index stays below
+ * 0x100000 (no 20-bit wrap; checked). The decode block covers [min, max] + base (rsx_vertex_fetch_plan_prepare over two
+ * references), which is the range the old path's references span. Not taken (old path): restart index present in the
+ * data, an index count that is not a multiple of 3, a wrap, other primitives, array or inline batches.
+ */
+#ifndef RSX_VG_INDEX_H
+#define RSX_VG_INDEX_H
+#include "rsx_vertex_compact.h"
+
+#define RSX_VG_ELEMENT_LIMIT 0x100000u   /* elements are 20 bits (rsx_vg_element) */
+
+/* Convert `count` guest indices (big-endian, 2 or 4 bytes) to little-endian u32 at out; track min and max.
+ * Returns 0 when the restart value occurs (restart enabled): the caller keeps the old path. */
+static inline int rsx_vg_index_convert(const u8* src, u32 count, int is_u32, int restart_enabled, u32 restart_value,
+                                       u32* out, u32* lo, u32* hi)
+{
+    u32 mn = 0xFFFFFFFFu, mx = 0;
+    if (is_u32) {
+        for (u32 i = 0; i < count; i++) {
+            const u8* s = src + (size_t)i * 4u;
+            const u32 v = ((u32)s[0] << 24) | ((u32)s[1] << 16) | ((u32)s[2] << 8) | s[3];
+            if (restart_enabled && v == restart_value) return 0;
+            out[i] = v; if (v < mn) mn = v; if (v > mx) mx = v;
+        }
+    } else {
+        for (u32 i = 0; i < count; i++) {
+            const u32 v = ((u32)src[i * 2u] << 8) | src[i * 2u + 1u];
+            if (restart_enabled && v == restart_value) return 0;
+            out[i] = v; if (v < mn) mn = v; if (v > mx) mx = v;
+        }
+    }
+    *lo = mn; *hi = mx;
+    return 1;
+}
+
+/* The element range the decode block must cover, or 0 when index + base would leave the 20-bit range. */
+static inline int rsx_vg_index_range(u32 lo, u32 hi, u32 base_index, u32* e_lo, u32* e_hi)
+{
+    if ((u64)hi + base_index >= RSX_VG_ELEMENT_LIMIT || lo > hi) return 0;
+    *e_lo = lo + base_index; *e_hi = hi + base_index;
+    return 1;
+}
+#endif
