diff --git a/libs/video/tests/test_live_draw_immediate_quads.c b/libs/video/tests/test_live_draw_immediate_quads.c
new file mode 100644
index 0000000..d40270f
--- /dev/null
+++ b/libs/video/tests/test_live_draw_immediate_quads.c
@@ -0,0 +1,91 @@
+/*
+ * D3D12 live-draw test (patch 6008): immediate-mode QUADS reach the screen.
+ *
+ * R&C ToD's main menu draws its movie background with register-based
+ * vertices: BEGIN QUADS, one DATA4UB colour (attr2), then per vertex DATA2F
+ * attr1, DATA2F attr3 and DATA2F attr0 (position) last. Live draw had no
+ * immediate-vertex sink, so these groups drew nothing. Each case clears a
+ * 16x16 target to black and draws one full-target quad whose colour is attr2
+ * (transform program: o[0] = v[0], o[1] = v[2]; fragment: r0 = col0):
+ *   DATA2F position, the menu's sequence   -> 256 pixels lit
+ *   DATA3F position (worked before)        -> 256 pixels lit
+ *   the menu's group outside BEGIN/END     -> 0 pixels lit
+ * Build and run: see live_draw_test_harness.h.
+ */
+#include "live_draw_test_harness.h"
+
+#define T "test_live_draw_immediate_quads"
+
+#define FP_COL  0x00001000u    /* main memory */
+#define ZETA24  0x00102000u    /* local memory */
+
+static const float s_pos[4][2] = { {-1, 1}, {1, 1}, {1, -1}, {-1, -1} };
+
+static void load_vp(void)
+{
+    u8 vp[32];
+    rsx_test_vp_mov_out(vp +  0, 0, RSX_TEST_VP_SWZ_IDENT, 0, 0);
+    rsx_test_vp_mov_out(vp + 16, 2, RSX_TEST_VP_SWZ_IDENT, 1, 1);
+    ldh_m(NV4097_SET_TRANSFORM_PROGRAM_LOAD, 0u);
+    for (u32 k = 0; k < sizeof vp / 4u; k++) {
+        const u8* w = vp + k * 4;
+        ldh_m(NV4097_SET_TRANSFORM_PROGRAM + k * 4,
+              (u32)w[0] | ((u32)w[1] << 8) | ((u32)w[2] << 16) | ((u32)w[3] << 24));
+    }
+    ldh_m(NV4097_SET_TRANSFORM_PROGRAM_START, 0u);
+    for (u32 a = 0; a < 16; a++)                       /* no vertex arrays */
+        ldh_m(NV4097_SET_VERTEX_DATA_ARRAY_FORMAT + a * 4, 2u);
+}
+
+/* 0 = DATA2F menu sequence, 1 = DATA3F position, 2 = menu writes with no BEGIN */
+static void draw_quad(int form)
+{
+    ldh_m(NV4097_SET_DEPTH_TEST_ENABLE, 0u);
+    ldh_m(NV4097_SET_SHADER_CONTROL, 0x40u);
+    ldh_m(NV4097_SET_SHADER_PROGRAM, FP_COL | 2u);
+    if (form != 2) ldh_m(NV4097_SET_BEGIN_END, RSX_PRIMITIVE_QUADS);
+    ldh_m(0x1948, 0xFFFFFFFFu);                        /* attr2 DATA4UB: white */
+    for (u32 i = 0; i < 4; i++) {
+        ldh_mf(0x1888, i & 1 ? 640.0f : 0.0f); ldh_mf(0x188C, i & 2 ? 360.0f : 0.0f);  /* attr1 */
+        ldh_mf(0x1898, i & 1 ? 1.0f : 0.0f);   ldh_mf(0x189C, i & 2 ? 1.0f : 0.0f);    /* attr3 */
+        if (form == 1) {
+            ldh_mf(0x1500, s_pos[i][0]); ldh_mf(0x1504, s_pos[i][1]); ldh_mf(0x1508, 0.0f);
+        } else {
+            ldh_mf(0x1880, s_pos[i][0]); ldh_mf(0x1884, s_pos[i][1]);
+        }
+    }
+    if (form != 2) ldh_m(NV4097_SET_BEGIN_END, 0u);
+}
+
+static void run_case(const char* name, u32 surf, int form, int want_lit)
+{
+    ldh_surface(0x8u | (2u << 5) | (0x1u << 8), surf, 64, ZETA24, 64, 16, 16);
+    ldh_m(NV4097_SET_COLOR_CLEAR_VALUE, 0xFF000000u);
+    ldh_m(NV4097_SET_ZSTENCIL_CLEAR_VALUE, 0xFFFFFF00u);
+    ldh_m(NV4097_CLEAR_SURFACE, 0xF3u);
+    draw_quad(form);
+    static uint8_t rgb[16 * 16 * 3];
+    u32 w = 0, h = 0;
+    char path[64];
+    snprintf(path, sizeof path, "immediate_quads_%08X.ppm", surf);
+    if (ldh_read_rgb(surf, path, rgb, 16, 16, &w, &h) != 0 || w != 16 || h != 16) {
+        printf("[" T "] %s: surface read back failed\n", name);
+        ldh_check(name, 0);
+        return;
+    }
+    int lit = 0;
+    for (u32 i = 0; i < 16u * 16u; i++) lit += rgb[i * 3] > 200 && rgb[i * 3 + 1] > 200 && rgb[i * 3 + 2] > 200;
+    printf("[" T "] %s: %d of 256 pixels drawn (want %d)\n", name, lit, want_lit ? 256 : 0);
+    ldh_check(name, want_lit ? lit == 256 : lit == 0);
+}
+
+int main(void)
+{
+    if (ldh_init(T) != 0) return 2;
+    rsx_test_fp_mov_r0_col0(ldh_main + FP_COL, RSX_TEST_FP_SWZ_IDENT);
+    load_vp();
+    run_case("DATA2F immediate QUADS (menu sequence) draw the quad", 0x00000000u, 0, 1);
+    run_case("DATA3F immediate QUADS still draw the quad",           0x00002000u, 1, 1);
+    run_case("the same writes outside BEGIN/END draw nothing",       0x00004000u, 2, 0);
+    return ldh_done(T);
+}
