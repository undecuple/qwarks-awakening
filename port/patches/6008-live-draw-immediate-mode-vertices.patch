diff --git a/libs/video/tests/test_rsx_immediate_vertex.c b/libs/video/tests/test_rsx_immediate_vertex.c
new file mode 100644
--- /dev/null
+++ b/libs/video/tests/test_rsx_immediate_vertex.c
@@ -0,0 +1,180 @@
+/*
+ * ps3recomp - immediate-mode (register-based) vertices out of the dispatcher
+ *
+ * Patch 6008. Inside BEGIN/END, the last word of ATTR0 written in any
+ * SET_VERTEX_DATA* format completes one vertex: the dispatcher calls
+ * sink.immediate_vertex with the attribute registers holding that vertex.
+ * Only DATA3F z and DATA4F w did so before; R&C ToD's main menu draws its
+ * movie background as QUADS whose position is DATA2F, and none of those
+ * vertices reached a renderer. The menu's exact sequence per group is
+ *   BEGIN QUADS, DATA4UB attr2 (colour),
+ *   4 x (DATA2F attr1, DATA2F attr3, DATA2F attr0), END.
+ *
+ * Dispatcher only: no GPU, no host graphics API.
+ *   gcc -std=gnu17 -Wall -Wextra -Wno-unused-parameter -I include -I libs/video \
+ *       -o /tmp/test_rsx_immediate_vertex libs/video/tests/test_rsx_immediate_vertex.c \
+ *       libs/video/rsx_dispatch.c
+ */
+#include "rsx_dispatch.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int g_failures;
+
+#define CHECK(cond, ...)                                                      \
+    do {                                                                      \
+        if (cond) {                                                           \
+            printf("[PASS] " __VA_ARGS__); printf("\n");                      \
+        } else {                                                              \
+            printf("[FAIL] " __VA_ARGS__);                                    \
+            printf("   (%s:%d)\n", __FILE__, __LINE__);                       \
+            g_failures++;                                                     \
+        }                                                                     \
+    } while (0)
+
+#define M_BEGIN_END 0x1808u
+#define M_DRAW_ARRAYS 0x1814u
+
+/* What the sink saw: ATTR0..3 current values at each completed position. */
+static struct {
+    u32 n_vertices, n_begin, n_end;
+    float v[16][4][4];
+} rec;
+
+static void rec_begin(void* user, const rsx_dispatch* rsx, u32 prim) { rec.n_begin++; }
+static void rec_end(void* user, const rsx_dispatch* rsx) { rec.n_end++; }
+static void rec_immediate(void* user, const rsx_dispatch* rsx)
+{
+    if (rec.n_vertices < 16)
+        for (u32 a = 0; a < 4; a++)
+            rsx_dsp_vertex_default(rsx, a, rec.v[rec.n_vertices][a]);
+    rec.n_vertices++;
+}
+
+static rsx_dispatch* g_rsx;
+
+static void m(u32 method, u32 arg) { rsx_dispatch_method(g_rsx, method, arg); }
+static void mf(u32 method, float f) { u32 w; memcpy(&w, &f, 4); m(method, w); }
+
+static void reset(void)
+{
+    rsx_dispatch_sink sink;
+    memset(&sink, 0, sizeof sink);
+    sink.begin = rec_begin;
+    sink.end = rec_end;
+    sink.immediate_vertex = rec_immediate;
+    rsx_dispatch_init(g_rsx, &sink);
+    memset(&rec, 0, sizeof rec);
+}
+
+static int near(float a, float b) { return a - b < 1e-6f && b - a < 1e-6f; }
+
+static int vec_is(const float* v, float x, float y, float z, float w)
+{
+    return near(v[0], x) && near(v[1], y) && near(v[2], z) && near(v[3], w);
+}
+
+/* The menu's group, values chosen so every component is distinguishable. */
+static void test_menu_quads(void)
+{
+    reset();
+    static const float pos[4][2] = { {-1, 1}, {1, 1}, {1, -1}, {-1, -1} };
+    static const float tc1[4][2] = { {0, 0}, {640, 0}, {640, 360}, {0, 360} };
+    static const float tc3[4][2] = { {0.25f, 0.5f}, {0.75f, 0.5f}, {0.75f, 1}, {0.25f, 1} };
+    m(M_BEGIN_END, 8u);                      /* QUADS */
+    m(0x1948, 0x80FF4000u);                  /* DATA4UB attr2: x is the low byte */
+    for (u32 i = 0; i < 4; i++) {
+        mf(0x1888, tc1[i][0]); mf(0x188C, tc1[i][1]);   /* DATA2F attr1 */
+        mf(0x1898, tc3[i][0]); mf(0x189C, tc3[i][1]);   /* DATA2F attr3 */
+        mf(0x1880, pos[i][0]);
+        CHECK(rec.n_vertices == i, "menu vertex %u: DATA2F attr0 x alone does not complete it", i);
+        mf(0x1884, pos[i][1]);                          /* DATA2F attr0 y: completes */
+    }
+    m(M_BEGIN_END, 0u);
+    CHECK(rec.n_vertices == 4, "menu QUADS group: 4 immediate vertices reach the sink (got %u)", rec.n_vertices);
+    CHECK(rec.n_begin == 1 && rec.n_end == 1, "menu group: one BEGIN and one END");
+    for (u32 i = 0; i < 4 && i < rec.n_vertices; i++) {
+        CHECK(vec_is(rec.v[i][0], pos[i][0], pos[i][1], 0, 1),
+              "menu vertex %u position (%g,%g,0,1), got (%g,%g,%g,%g)", i, pos[i][0], pos[i][1],
+              rec.v[i][0][0], rec.v[i][0][1], rec.v[i][0][2], rec.v[i][0][3]);
+        CHECK(vec_is(rec.v[i][1], tc1[i][0], tc1[i][1], 0, 1), "menu vertex %u attr1 (%g,%g,0,1)", i,
+              tc1[i][0], tc1[i][1]);
+        CHECK(vec_is(rec.v[i][3], tc3[i][0], tc3[i][1], 0, 1), "menu vertex %u attr3 (%g,%g,0,1)", i,
+              tc3[i][0], tc3[i][1]);
+        CHECK(vec_is(rec.v[i][2], 0x00 / 255.0f, 0x40 / 255.0f, 0xFF / 255.0f, 0x80 / 255.0f),
+              "menu vertex %u colour attr2 from DATA4UB 0x80FF4000 (0,0.251,1,0.502)", i);
+    }
+    /* The same writes outside BEGIN/END only set current values. */
+    const u32 before = rec.n_vertices;
+    mf(0x1880, 5); mf(0x1884, 6);
+    CHECK(rec.n_vertices == before, "DATA2F attr0 outside BEGIN/END emits nothing");
+}
+
+/* Each format emits exactly once per ATTR0, on its last word, and its
+ * non-ATTR0 forms never emit. */
+static void test_formats(void)
+{
+    struct { const char* name; u32 words[4]; u32 n; } f[] = {
+        { "DATA3F (z completes)",        { 0x1500, 0x1504, 0x1508 }, 3 },
+        { "DATA4F (w completes)",        { 0x1C00, 0x1C04, 0x1C08, 0x1C0C }, 4 },
+        { "DATA1F",                      { 0x1E40 }, 1 },
+        { "DATA2F (y completes)",        { 0x1880, 0x1884 }, 2 },
+        { "DATA2S",                      { 0x1900 }, 1 },
+        { "DATA4UB",                     { 0x1940 }, 1 },
+        { "DATA4S (second word)",        { 0x1980, 0x1984 }, 2 },
+        { "DATA_SCALED4S (second word)", { 0x0A80, 0x0A84 }, 2 },
+    };
+    for (u32 k = 0; k < sizeof f / sizeof f[0]; k++) {
+        reset();
+        m(M_BEGIN_END, 5u);
+        for (u32 v = 0; v < 3; v++)
+            for (u32 w = 0; w < f[k].n; w++) {
+                m(f[k].words[w], 0x3F800000u);   /* 1.0f, or packed 0x3F80/0x0000 halves, 0x00,0x00,0x80,0x3F bytes */
+                if (w + 1 < f[k].n && rec.n_vertices != v) {
+                    CHECK(0, "%s: word %u of vertex %u emitted early", f[k].name, w, v);
+                }
+            }
+        m(M_BEGIN_END, 0u);
+        CHECK(rec.n_vertices == 3, "%s: 3 positions emit 3 vertices (got %u)", f[k].name, rec.n_vertices);
+    }
+    /* DATA3F and DATA4F values, the forms that already worked. */
+    reset();
+    m(M_BEGIN_END, 5u);
+    mf(0x1500, 1); mf(0x1504, 2); mf(0x1508, 3);
+    mf(0x1C00, 4); mf(0x1C04, 5); mf(0x1C08, 6); mf(0x1C0C, 7);
+    m(M_BEGIN_END, 0u);
+    CHECK(rec.n_vertices == 2 && vec_is(rec.v[0][0], 1, 2, 3, 1) && vec_is(rec.v[1][0], 4, 5, 6, 7),
+          "DATA3F (1,2,3,1) then DATA4F (4,5,6,7) positions unchanged");
+    /* Packed attr0 forms decode as before. */
+    reset();
+    m(M_BEGIN_END, 5u);
+    m(0x1900, 0xFFFE0003u);                  /* DATA2S: x = 3, y = -2 */
+    m(0x1940, 0xFF000080u);                  /* DATA4UB */
+    m(M_BEGIN_END, 0u);
+    CHECK(rec.n_vertices == 2 && vec_is(rec.v[0][0], 3, -2, 0, 1) &&
+          vec_is(rec.v[1][0], 128 / 255.0f, 0, 0, 1),
+          "DATA2S (3,-2,0,1) and DATA4UB (0.502,0,0,1) positions");
+
+    /* Non-ATTR0 writes of every format never emit. */
+    reset();
+    m(M_BEGIN_END, 5u);
+    static const u32 others[] = { 0x1510, 0x1514, 0x1518, 0x1C10, 0x1C14, 0x1C18, 0x1C1C, 0x1E44,
+                                  0x1888, 0x188C, 0x1904, 0x1944, 0x1988, 0x198C, 0x0A88, 0x0A8C };
+    for (u32 i = 0; i < sizeof others / sizeof others[0]; i++) m(others[i], 0x3F800000u);
+    m(M_DRAW_ARRAYS, 0u);
+    m(M_BEGIN_END, 0u);
+    CHECK(rec.n_vertices == 0, "writes to ATTR1+ in every format emit no vertex");
+}
+
+int main(void)
+{
+    g_rsx = (rsx_dispatch*)calloc(1, sizeof(rsx_dispatch));
+    if (!g_rsx) { printf("[FAIL] alloc\n"); return 1; }
+    test_menu_quads();
+    test_formats();
+    free(g_rsx);
+    printf(g_failures ? "\n%d check(s) FAILED\n" : "\nall checks passed\n", g_failures);
+    return g_failures ? 1 : 0;
+}
