+/* Patch 6008: an immediate group's payload is its snapshots, in layout order (packed: layout->stride per vertex,
+ * one float4 per slot; legacy: the full vtx_t). One reference per vertex, never remapped, no restart cuts. */
+static void fetch_immediate(const rsx_vertex_layout_plan* layout, int packed_payload)
+{
+    dc.n_refs = dc.n_source_refs = dc.n_imm;
+    dc.refs_remapped = 0;
+    dc.n_cuts = 0;
+    if (packed_payload) {
+        if (!reserve_compact_vertices((u64)dc.n_imm * layout->stride)) { dc.fetch_ok = 0; return; }
+        for (u32 v = 0; v < dc.n_imm; v++)
+            for (u32 slot = 0; slot < layout->count; slot++)
+                memcpy(dc.compact_verts + (u64)v * layout->stride + slot * 16u, dc.imm[v][layout->attrs[slot]], 16u);
+    } else {
+        if (!reserve_legacy_vertices(dc.n_imm)) { dc.fetch_ok = 0; return; }
+        for (u32 v = 0; v < dc.n_imm; v++)
+            memcpy(dc.verts[v].a, dc.imm[v], sizeof(dc.verts[v].a));
+    }
+    dc.n_verts = dc.n_imm;
+}
