+/* Patch 6008: a completed ATTR0 inside BEGIN/END (the last word of any SET_VERTEX_DATA* encoding, rsx_dispatch.c)
+ * is one vertex made of the current attribute values. Snapshot all sixteen now, as rsx_draw_engine.c's
+ * sink_immediate_vertex does; later writes replace them for the next vertex. A written register is taken as written (W/alpha may be an explicit 0,
+ * which rsx_dsp_vertex_default reads as unwritten); an unwritten one gets the default a disabled array reads,
+ * including the white ATTR3 of rsx_vertex_fetch_plan_init. One packet per vertex in the packet ledger. */
+#define LD_MAX_IMMEDIATE_VERTICES 4096u
+static void sink_immediate_vertex(void* u, const rsx_dispatch* r)
+{
+    (void)u; g_ld_stats.packets_seen++;
+    if (g_ld_movie_mode && !ld_movie_composite_ui_enabled()) {
+        g_ld_stats.packets_movie++;
+        return;
+    }
+    dc.n_packets++;
+    if (dc.imm_refused) { g_ld_stats.packets_queue_full++; return; }
+    if (dc.n_imm == LD_MAX_IMMEDIATE_VERTICES) {
+        static u32 logged;
+        if (logged++ < 8)
+            fprintf(stderr, "[live-draw] immediate group passed %u vertices (prim %u): not drawn\n",
+                    LD_MAX_IMMEDIATE_VERTICES, r->current_primitive);
+        dc.imm_refused = 1;
+        g_ld_stats.packets_queue_full++;
+        return;
+    }
+    if (dc.n_imm == dc.cap_imm) {
+        const u32 next = dc.cap_imm ? dc.cap_imm * 2u : 64u;
+        void* p = realloc(dc.imm, (size_t)next * sizeof(*dc.imm));
+        if (!p) { dc.imm_refused = 1; g_ld_stats.packets_queue_full++; return; }
+        dc.imm = (float (*)[16][4])p;
+        dc.cap_imm = next;
+    }
+    for (u32 attr = 0; attr < 16; attr++) {
+        float* value = dc.imm[dc.n_imm][attr];
+        const u32 base = (0x1C00u + attr * 16u) >> 2;
+        if (r->seen[base] || r->seen[base + 1] || r->seen[base + 2] || r->seen[base + 3]) {
+            memcpy(value, &r->regs[base], 16u);
+            continue;
+        }
+        rsx_dsp_vertex_default(r, attr, value);
+        if (attr == 3 && value[0] == 0.0f && value[1] == 0.0f && value[2] == 0.0f && value[3] == 1.0f)
+            value[0] = value[1] = value[2] = 1.0f;
+    }
+    dc.n_imm++;
+    g_ld_stats.packets_queued++;
+}
