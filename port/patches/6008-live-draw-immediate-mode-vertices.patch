+/* Patch 6008: the last word of ATTR0 (position) in every SET_VERTEX_DATA* format completes an immediate vertex,
+ * not only DATA3F z and DATA4F w. R&C ToD's main menu draws its movie background as QUADS whose position is
+ * DATA2F (0x1880/0x1884), and none of its vertices reached the renderer. RPCS3 counts a vertex once ATTR0 has
+ * received all the dwords of its format (rsx_vertex_data.cpp get_vertex_id: dword count / vertex size in dwords),
+ * which is the word that completes it here. Bases: gcm_enums.h NV4097_SET_VERTEX_DATA*_M. */
+static int vtx_attr0_completes(u32 m)
+{
+    switch (m) {
+    case 0x1E40:   /* DATA1F x */
+    case 0x1884:   /* DATA2F y */
+    case 0x1508:   /* DATA3F z */
+    case 0x1C0C:   /* DATA4F w */
+    case 0x1900:   /* DATA2S xy (one word) */
+    case 0x1940:   /* DATA4UB xyzw (one word) */
+    case 0x1984:   /* DATA4S zw (second word) */
+    case 0x0A84:   /* DATA_SCALED4S zw (second word) */
+        return 1;
+    default:
+        return 0;
+    }
+}
