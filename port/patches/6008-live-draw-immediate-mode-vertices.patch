+        m(0x1898, f32_bits(tc[i][0])); m(0x189C, f32_bits(tc[i][1]));
+        m(0x1880, f32_bits(pos[i][0])); m(0x1884, f32_bits(pos[i][1]));
+    }
+    m(M_BEGIN_END, 0);
+    CHECK(stub.n_draw == 1 && stub.draw_vertices == 4 && stub.draw_indices == 6,
+          "DATA2F immediate quad draws 4 vertices/6 indices, got %u draw(s) %u/%u",
+          stub.n_draw, stub.draw_vertices, stub.draw_indices);
+    for (u32 i = 0; i < 4; i++) {
+        const float* v = stub.captured_vertices[i];
+        CHECK(v[0] == pos[i][0] && v[1] == pos[i][1] && v[2] == 0 && v[3] == 1 &&
+              v[4] == tc[i][0] * 640 && v[5] == tc[i][1] * 360 &&
+              v[12] == tc[i][0] && v[13] == tc[i][1] &&
+              v[8] == 0.0f && v[9] == 0x40 / 255.0f && v[10] == 1.0f && v[11] == 0x80 / 255.0f,
+              "DATA2F quad vertex %u: position, attr1, attr3 and DATA4UB colour", i);
+    }
+    engine_down();
+}
