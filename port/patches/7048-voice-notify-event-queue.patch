diff --git a/libs/audio/cellVoice.c b/libs/audio/cellVoice.c
index 2a50981..63077d6 100644
--- a/libs/audio/cellVoice.c
+++ b/libs/audio/cellVoice.c
@@ -22,6 +22,32 @@ typedef struct {
 
 static VoicePort s_ports[CELL_VOICE_PORT_MAX];
 
+/* Notify event queues attached with cellVoiceSetNotifyEventQueue (RPCS3
+ * cellVoice.cpp semantics: queue_keys, one entry per attached source; the
+ * same key may be attached more than once with different sources). The host
+ * has no voice device, but the service itself starts and stops, and those two
+ * transitions are the only events sent: SERVICE_ATTACHED when Start moves the
+ * service from stopped to started, SERVICE_DETACHED when Stop or End moves it
+ * back. Nothing else is ever reported (no port or data events are faked). */
+#define VOICE_NOTIFY_MAX 32
+typedef struct { u64 key; u64 source; } VoiceNotify;
+static VoiceNotify s_notify[VOICE_NOTIFY_MAX];
+static int s_notify_count = 0;
+static u32 s_source_next = 0;
+
+extern uint32_t sys_event_queue_create_direct(uint64_t key, int32_t size);
+extern uint32_t sys_event_find_queue_by_key(uint64_t key);
+extern int sys_event_queue_push_by_id(uint32_t queue_id, uint64_t source, uint64_t data1,
+                                      uint64_t data2, uint64_t data3);
+
+static void voice_notify_all(u64 event)
+{
+    for (int i = 0; i < s_notify_count; i++) {
+        uint32_t qid = sys_event_find_queue_by_key(s_notify[i].key);
+        if (qid) sys_event_queue_push_by_id(qid, s_notify[i].source, event, 0, 0);
+    }
+}
+
 /* API */
 
 s32 cellVoiceInit(const CellVoiceInitParam* param)
@@ -31,6 +57,7 @@ s32 cellVoiceInit(const CellVoiceInitParam* param)
     if (s_initialized)
         return (s32)CELL_VOICE_ERROR_ALREADY_INITIALIZED;
     memset(s_ports, 0, sizeof(s_ports));
+    s_notify_count = 0;
     s_initialized = 1;
     s_started = 0;
     return CELL_OK;
@@ -39,6 +66,8 @@ s32 cellVoiceInit(const CellVoiceInitParam* param)
 s32 cellVoiceEnd(void)
 {
     printf("[cellVoice] End()\n");
+    if (s_initialized && s_started) voice_notify_all(CELLVOICE_EVENT_SERVICE_DETACHED);
+    s_notify_count = 0;
     s_initialized = 0;
     s_started = 0;
     return CELL_OK;
@@ -87,7 +116,10 @@ s32 cellVoiceStart(void)
 {
     printf("[cellVoice] Start()\n");
     if (!s_initialized) return (s32)CELL_VOICE_ERROR_NOT_INITIALIZED;
-    s_started = 1;
+    if (!s_started) {
+        s_started = 1;
+        voice_notify_all(CELLVOICE_EVENT_SERVICE_ATTACHED);
+    }
     return CELL_OK;
 }
 
@@ -95,7 +127,10 @@ s32 cellVoiceStop(void)
 {
     printf("[cellVoice] Stop()\n");
     if (!s_initialized) return (s32)CELL_VOICE_ERROR_NOT_INITIALIZED;
-    s_started = 0;
+    if (s_started) {
+        s_started = 0;
+        voice_notify_all(CELLVOICE_EVENT_SERVICE_DETACHED);
+    }
     return CELL_OK;
 }
 
@@ -214,3 +249,51 @@ s32 cellVoiceGetSignalState(CellVoicePortId portId, u32 attr, void* attrValue)
     /* RPCS3 reports a detached microphone and does not write attrValue. */
     return (s32)CELL_VOICE_ERROR_DEVICE_NOT_PRESENT;
 }
+
+/* cellVoiceCreateNotifyEventQueue(sys_event_queue_t* id, u64* key)
+ *
+ * RPCS3 creates a FIFO PPU event queue of depth 0x40 under the first free key
+ * of 0x80004d494f323285 + 0..9 and writes the id and key; all ten taken is
+ * CELL_VOICE_ERROR_EVENT_QUEUE. It needs cellVoiceInit first. RPCS3 does not
+ * check the two pointers (it would fault); a null pointer is reported as
+ * ARGUMENT_INVALID here. ASSUMPTION: the argument error, and EVENT_QUEUE when
+ * the lv2 queue table is full. */
+s32 cellVoiceCreateNotifyEventQueue(u32* id, u64* key)
+{
+    if (!s_initialized) return (s32)CELL_VOICE_ERROR_NOT_INITIALIZED;
+    if (!id || !key) return (s32)CELL_VOICE_ERROR_ARGUMENT_INVALID;
+
+    for (u64 i = 0; i < 10; i++) {
+        u64 k = 0x80004d494f323285ull + i;
+        if (sys_event_find_queue_by_key(k)) continue;      /* EEXIST: try the next key */
+        uint32_t qid = sys_event_queue_create_direct(k, 0x40);
+        if (!qid) return (s32)CELL_VOICE_ERROR_EVENT_QUEUE;
+        vm_write32((u32)(uintptr_t)id, qid);
+        vm_write64((u32)(uintptr_t)key, k);
+        printf("[cellVoice] CreateNotifyEventQueue -> id=%u key=0x%llX\n",
+               qid, (unsigned long long)k);
+        return CELL_OK;
+    }
+    return (s32)CELL_VOICE_ERROR_EVENT_QUEUE;
+}
+
+/* cellVoiceSetNotifyEventQueue(u64 key, u64 source)
+ *
+ * Attaches an existing queue (by key) to the voice service. Attaching the same
+ * key again is allowed (a second source is queued); an unknown key is
+ * CELL_VOICE_ERROR_EVENT_QUEUE. A zero source gets a generated id, like a
+ * sys_event_port_send from an unnamed port. ASSUMPTION: the generated value
+ * ((1 << 32) | 0x0e000000 + n; RPCS3 uses the process id and its event port id
+ * counter), and RESOURCE_INSUFFICIENT when more than 32 sources are attached.
+ * No event is sent here: SERVICE_ATTACHED goes out from cellVoiceStart. */
+s32 cellVoiceSetNotifyEventQueue(u64 key, u64 source)
+{
+    if (!s_initialized) return (s32)CELL_VOICE_ERROR_NOT_INITIALIZED;
+    if (!sys_event_find_queue_by_key(key)) return (s32)CELL_VOICE_ERROR_EVENT_QUEUE;
+    if (s_notify_count >= VOICE_NOTIFY_MAX) return (s32)CELL_VOICE_ERROR_RESOURCE_INSUFFICIENT;
+    if (!source) source = (1ull << 32) | (u64)(0x0e000000u + s_source_next++);
+    s_notify[s_notify_count].key = key;
+    s_notify[s_notify_count].source = source;
+    s_notify_count++;
+    return CELL_OK;
+}
