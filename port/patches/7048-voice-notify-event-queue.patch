diff --git a/b/libs/audio/tests/voice_event_stubs.h b/libs/audio/tests/voice_event_stubs.h
new file mode 100644
index 0000000..ceaa0ab
--- /dev/null
+++ b/libs/audio/tests/voice_event_stubs.h
@@ -0,0 +1,38 @@
+/* Host stand-ins for the three lv2 event queue helpers cellVoice.c calls
+ * (runtime/syscalls/sys_event.c has the real ones): a small queue table that
+ * keeps the key, the depth and the events pushed, so a test can read them back. */
+#ifndef VOICE_EVENT_STUBS_H
+#define VOICE_EVENT_STUBS_H
+#include <stdint.h>
+#include <string.h>
+
+typedef struct { uint64_t source, d1, d2, d3; } stub_evt;
+typedef struct { int active; uint64_t key; int depth; int n; stub_evt ev[128]; } stub_queue;
+static stub_queue g_stub_q[8];
+
+uint32_t sys_event_queue_create_direct(uint64_t key, int32_t size)
+{
+    for (int i = 0; i < 8; i++)
+        if (!g_stub_q[i].active) {
+            memset(&g_stub_q[i], 0, sizeof g_stub_q[i]);
+            g_stub_q[i].active = 1; g_stub_q[i].key = key; g_stub_q[i].depth = size;
+            return (uint32_t)(i + 1);
+        }
+    return 0;
+}
+uint32_t sys_event_find_queue_by_key(uint64_t key)
+{
+    if (!key) return 0;
+    for (int i = 0; i < 8; i++)
+        if (g_stub_q[i].active && g_stub_q[i].key == key) return (uint32_t)(i + 1);
+    return 0;
+}
+int sys_event_queue_push_by_id(uint32_t id, uint64_t s, uint64_t d1, uint64_t d2, uint64_t d3)
+{
+    if (id == 0 || id > 8 || !g_stub_q[id - 1].active) return -1;
+    stub_queue* q = &g_stub_q[id - 1];
+    if (q->n >= q->depth) return -1;
+    q->ev[q->n++] = (stub_evt){ s, d1, d2, d3 };
+    return 0;
+}
+#endif
diff --git a/b/tools/test_voice_notify_queue.py b/tools/test_voice_notify_queue.py
new file mode 100644
index 0000000..96759c2
--- /dev/null
+++ b/tools/test_voice_notify_queue.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+"""cellVoiceCreateNotifyEventQueue and cellVoiceSetNotifyEventQueue.
+
+Both were unresolved NIDs (Deadlocked HD, Ratchet & Clank 3), answered with a
+default CELL_OK that gave the game no queue. This builds
+libs/audio/tests/test_voice_notify_queue.c and runs it.
+
+It needs a host C compiler (under CI=1 a missing one fails instead of
+skipping).
+
+Usage:
+    python3 tools/test_voice_notify_queue.py
+"""
+
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(TOOLS)
+TESTS = os.path.join(ROOT, "libs", "audio", "tests")
+SOURCES = [os.path.join(TESTS, "test_voice_notify_queue.c")]
+
+
+def _cc():
+    return (shutil.which(os.environ.get("CC", "cc")) or shutil.which("clang")
+            or shutil.which("gcc"))
+
+
+def main():
+    cc = _cc()
+    if cc is None:
+        if os.environ.get("CI"):
+            print("FAIL: no C compiler found")
+            return 1
+        print("skip test_voice_notify_queue: no C compiler")
+        return 0
+    with tempfile.TemporaryDirectory() as td:
+        exe = os.path.join(td, "test_voice_notify_queue")
+        cmd = [cc, "-std=gnu17", "-w", "-I" + os.path.join(ROOT, "include"),
+               "-o", exe] + SOURCES
+        r = subprocess.run(cmd, capture_output=True, text=True)
+        if r.returncode != 0:
+            print("FAIL: fixture did not build")
+            print((r.stdout + r.stderr)[-4000:])
+            return 1
+        r = subprocess.run([exe], capture_output=True, text=True)
+        sys.stdout.write(r.stdout)
+        return r.returncode
+
+
+if __name__ == "__main__":
+    sys.exit(main())
