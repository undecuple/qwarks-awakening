+s32 cellVoiceCreateNotifyEventQueue(u32* id, u64* key);
+s32 cellVoiceSetNotifyEventQueue(u64 key, u64 source);
+
 s32 cellVoiceSetCallback(CellVoiceEventCallback callback, void* arg);
 
 #ifdef __cplusplus
diff --git a/b/libs/audio/tests/test_voice_notify_queue.c b/libs/audio/tests/test_voice_notify_queue.c
new file mode 100644
index 0000000..cf626be
--- /dev/null
+++ b/libs/audio/tests/test_voice_notify_queue.c
@@ -0,0 +1,99 @@
+/*
+ * test_voice_notify_queue - cellVoiceCreateNotifyEventQueue and
+ * cellVoiceSetNotifyEventQueue.
+ *
+ * Both were unresolved NIDs (Deadlocked HD, Ratchet & Clank 3): the default
+ * CELL_OK handed the game no queue id, so it waited on an id it never owned.
+ * The functions are declared weak so a build without them reports them missing.
+ *
+ *   cc -std=gnu17 -I include -o test_voice_notify_queue libs/audio/tests/test_voice_notify_queue.c
+ * Driven by tools/test_voice_notify_queue.py.
+ */
+#include "../cellVoice.h"
+s32 cellVoiceCreateNotifyEventQueue(u32*, u64*) __attribute__((weak));
+s32 cellVoiceSetNotifyEventQueue(u64, u64) __attribute__((weak));
+#include "../cellVoice.c"
+#include <stdlib.h>
+#include "voice_event_stubs.h"
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+
+static int fails = 0;
+#define CHECK(c, ...) do { int ok_ = (c); printf(ok_ ? "[PASS] " : "[FAIL] "); printf(__VA_ARGS__); \
+                           printf("\n"); if (!ok_) fails++; } while (0)
+
+enum { MEM = 1 << 16, INIT = 0x100, ID = 0x200, KEY = 0x208 };
+#define U(x) ((u32)(x))
+
+int main(void)
+{
+    vm_base = calloc(1, MEM);
+    ppu_vm_size = MEM;
+    if (!cellVoiceCreateNotifyEventQueue || !cellVoiceSetNotifyEventQueue) {
+        CHECK(0, "cellVoiceCreateNotifyEventQueue/SetNotifyEventQueue are defined");
+        return 1;
+    }
+
+    /* Before cellVoiceInit: LIBVOICE_NOT_INIT. */
+    CHECK(U(cellVoiceCreateNotifyEventQueue((u32*)(uintptr_t)ID, (u64*)(uintptr_t)KEY)) == 0x80310801u,
+          "Create before Init -> NOT_INIT");
+    CHECK(U(cellVoiceSetNotifyEventQueue(0x80004d494f323285ull, 0)) == 0x80310801u,
+          "Set before Init -> NOT_INIT");
+    CHECK(sys_event_find_queue_by_key(0x80004d494f323285ull) == 0, "no queue created before Init");
+
+    CHECK(cellVoiceInit((const CellVoiceInitParam*)(uintptr_t)INIT) == CELL_OK, "Init");
+
+    /* Bad arguments. */
+    CHECK(U(cellVoiceCreateNotifyEventQueue(NULL, (u64*)(uintptr_t)KEY)) == 0x80310805u, "Create(id NULL)");
+    CHECK(U(cellVoiceCreateNotifyEventQueue((u32*)(uintptr_t)ID, NULL)) == 0x80310805u, "Create(key NULL)");
+    CHECK(U(cellVoiceSetNotifyEventQueue(0x1234, 0)) == 0x8031080fu, "Set(unknown key) -> EVENT_QUEUE");
+    CHECK(U(cellVoiceSetNotifyEventQueue(0, 0)) == 0x8031080fu, "Set(key 0) -> EVENT_QUEUE");
+
+    /* Create: a queue of depth 0x40 under the first key, id and key written. */
+    CHECK(cellVoiceCreateNotifyEventQueue((u32*)(uintptr_t)ID, (u64*)(uintptr_t)KEY) == CELL_OK, "Create");
+    u32 qid = vm_read32(ID);
+    u64 key = vm_read64(KEY);
+    CHECK(qid != 0 && key == 0x80004d494f323285ull, "Create wrote id=%u key=0x%llx", qid, (unsigned long long)key);
+    CHECK(qid && g_stub_q[qid - 1].depth == 0x40, "queue depth 0x40");
+    CHECK(sys_event_find_queue_by_key(key) == qid, "queue found by key");
+
+    /* A second queue gets the next key. */
+    CHECK(cellVoiceCreateNotifyEventQueue((u32*)(uintptr_t)ID, (u64*)(uintptr_t)KEY) == CELL_OK, "Create #2");
+    CHECK(vm_read64(KEY) == 0x80004d494f323286ull && vm_read32(ID) != qid, "Create #2 -> next key, new id");
+
+    /* Attach: no event yet; the service has not started. */
+    CHECK(cellVoiceSetNotifyEventQueue(key, 0x77) == CELL_OK, "Set(key, source 0x77)");
+    CHECK(g_stub_q[qid - 1].n == 0, "no event before the service starts");
+
+    /* Start sends exactly the attach event: data1 = SERVICE_ATTACHED (8), data2/3 = 0, the source given. */
+    CHECK(cellVoiceStart() == CELL_OK, "Start");
+    stub_queue* q = &g_stub_q[qid - 1];
+    CHECK(q->n == 1, "one event after Start (got %d)", q->n);
+    CHECK(q->n >= 1 && q->ev[0].d1 == 8 && q->ev[0].d2 == 0 && q->ev[0].d3 == 0 && q->ev[0].source == 0x77,
+          "event: source 0x77, data1 SERVICE_ATTACHED, data2/3 zero");
+    CHECK(cellVoiceStart() == CELL_OK && q->n == 1, "a second Start sends nothing");
+
+    /* A zero source gets a generated, non-zero id; the same key may be attached twice. */
+    CHECK(cellVoiceSetNotifyEventQueue(key, 0) == CELL_OK, "Set(key, source 0) again");
+
+    /* Stop reports the detach to both sources; End after Stop sends nothing more. */
+    CHECK(cellVoiceStop() == CELL_OK, "Stop");
+    CHECK(q->n == 3 && q->ev[1].d1 == 16 && q->ev[2].d1 == 16, "Stop -> two SERVICE_DETACHED (n=%d)", q->n);
+    CHECK(q->n == 3 && q->ev[1].source == 0x77 && q->ev[2].source != 0 && q->ev[2].source != 0x77,
+          "detach events carry the given source and a generated non-zero one");
+    cellVoiceEnd();
+    CHECK(q->n == 3, "End after Stop sends nothing");
+    CHECK(U(cellVoiceSetNotifyEventQueue(key, 0)) == 0x80310801u, "Set after End -> NOT_INIT");
+
+    printf(fails ? "FAILED (%d)\n" : "OK\n", fails);
+    return fails ? 1 : 0;
+}
