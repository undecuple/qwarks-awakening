+        CHECK(s_import.entry == prog_a, "import of A not found (shoff %02X%02X)", e[0x22], e[0x23]);
         uint32_t i1 = create();
         st = run(i1);
         CHECK(s_ran[0] == before_a + 1, "imported A ran %d times", s_ran[0] - before_a);
diff --git a/runtime/spu/tests/test_spu_raw_two_spus.c b/runtime/spu/tests/test_spu_raw_two_spus.c
new file mode 100644
index 0000000..0abd0be
--- /dev/null
+++ b/runtime/spu/tests/test_spu_raw_two_spus.c
@@ -0,0 +1,153 @@
+/* test_spu_raw_two_spus.c -- each raw SPU runs the image that reached ITS local store (spu_raw_resolve.h, patch 6503).
+ *
+ * The case that broke: two raw SPUs streamed in sequence by proxy GETs (Tools of Destruction: igcollspu on spu0,
+ * then igCollBroadSpu on spu1, the second registered by a fingerprint window). raw_spu_start kept the resolved
+ * entry in one file-scope variable and only looked GET runs up while it was empty, so spu1 skipped its lookup and
+ * ran spu0's image (log: "spu1 START ... image=40", no proxy-loaded line). This replays the same sequence plus a
+ * restart, an unregistered stream, the image-import/image-load path (an import is consumed by the start that uses
+ * it, as upstream's PR #473), and a program registered with its parameter area masked (upstream PR #538), which is
+ * looked up before the windows.
+ *
+ *   gcc -std=gnu17 -Wall -Wextra -Wno-unused-parameter -Wno-unused-function -I include -I runtime/spu \
+ *       -o t runtime/spu/tests/test_spu_raw_two_spus.c && ./t
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "spu_raw_resolve.h"
+
+spu_raw_fp_window g_spu_raw_fp_windows[SPU_RAW_FP_WINDOW_MAX];
+unsigned          g_spu_raw_fp_window_count;
+
+static int g_pass, g_fail;
+#define CHECK(c, what) do { if (c) g_pass++; else { g_fail++; printf("FAIL %s (line %d)\n", what, __LINE__); } } while (0)
+
+static void SPU_ABI img_a(spu_context* c) { (void)c; }
+static void SPU_ABI img_b(spu_context* c) { (void)c; }
+static void SPU_ABI img_x(spu_context* c) { (void)c; }
+static void SPU_ABI img_m(spu_context* c) { (void)c; }
+
+/* A tiny registry with spu_workload_find_img's contract, and spu_workload_fingerprint's algorithm. */
+static struct { uint64_t fp; spu_lifted_entry_fn fn; int id; } reg[8];
+static int nreg;
+static spu_lifted_entry_fn find(uint64_t fp, int* id)
+{
+    for (int i = 0; i < nreg; i++) if (reg[i].fp == fp) { *id = reg[i].id; return reg[i].fn; }
+    *id = 0; return NULL;
+}
+static uint64_t fnv(const void* d, size_t n)
+{
+    const uint8_t* p = (const uint8_t*)d; uint64_t h = 1469598103934665603ULL;
+    for (size_t i = 0; i < n; i++) { h ^= p[i]; h *= 1099511628211ULL; }
+    return h;
+}
+
+/* spu_workload_find_img_masked's contract for one program: a run of exactly its size, fingerprinted with its
+ * parameter area [0x100, 0x150) zeroed. */
+#define M_SIZE 0x800u
+static uint64_t m_fp;
+static spu_lifted_entry_fn find_masked(const void* d, size_t n, uint64_t* fp_out, int* id)
+{
+    static uint8_t tmp[M_SIZE];
+    *id = 0;
+    if (n != M_SIZE) return NULL;
+    memcpy(tmp, d, n); memset(tmp + 0x100, 0, 0x50);
+    uint64_t fp = fnv(tmp, n);
+    if (fp != m_fp) return NULL;
+    if (fp_out) *fp_out = fp;
+    *id = 60; return img_m;
+}
+
+/* Guest-side images in "main memory" and one local store per raw SPU. */
+static uint8_t imgA[0x9000], imgB[0x2000], junk[0x1000], imgM[M_SIZE];
+static uint8_t ls[5][0x40000];
+
+/* What raw_spu_start does with a raw SPU's state: resolve, then reset the per-start inputs, consume an import it
+ * used, keep the choice. */
+typedef struct { spu_raw_get_runs gets; spu_raw_image_ref loaded, current; } raw;
+static raw spu[5];
+static spu_raw_image_ref s_import;
+
+static void stream(int n, uint32_t lsa, const uint8_t* src, uint32_t size)   /* proxy GETs of 0x4000 at most */
+{
+    for (uint32_t off = 0; off < size; off += 0x4000) {
+        uint32_t c = size - off < 0x4000 ? size - off : 0x4000;
+        memcpy(ls[n] + lsa + off, src + off, c);
+        spu_raw_note_get(&spu[n].gets, lsa + off, c);
+    }
+}
+static int start(int n, spu_raw_image_ref* out)
+{
+    int src = spu_raw_resolve_image((unsigned)n, ls[n], &spu[n].gets, &spu[n].loaded, &spu[n].current, &s_import,
+                                    find, find_masked, fnv, 0, NULL, stdout, out);
+    spu[n].gets.n = 0;
+    spu[n].loaded.entry = NULL;
+    if (src == SPU_RAW_SRC_IMPORT) s_import.entry = NULL;
+    if (src != SPU_RAW_SRC_NONE) spu[n].current = *out;
+    return src;
+}
+
+int main(void)
+{
+    for (unsigned i = 0; i < sizeof imgA; i++) imgA[i] = (uint8_t)(i * 31u + 7u);
+    for (unsigned i = 0; i < sizeof imgB; i++) imgB[i] = (uint8_t)(i * 17u + 3u);
+    for (unsigned i = 0; i < sizeof junk; i++) junk[i] = (uint8_t)(i ^ 0x5Au);
+    /* A: registered by its whole image (igcollspu). B: by the window before its 0x50-byte parameter block. */
+    reg[nreg].fp = fnv(imgA, sizeof imgA); reg[nreg].fn = img_a; reg[nreg++].id = 40;
+    reg[nreg].fp = fnv(imgB, sizeof imgB - 0x50); reg[nreg].fn = img_b; reg[nreg++].id = 41;
+    CHECK(spu_raw_add_fp_window(0x60, sizeof imgB - 0x50), "window");
+    spu_raw_image_ref r;
+
+    /* spu0: A streamed, started */
+    stream(0, 0x60, imgA, sizeof imgA);
+    CHECK(start(0, &r) == SPU_RAW_SRC_PROXY && r.entry == img_a && r.image_id == 40, "spu0 runs A");
+
+    /* spu1: the caller fills B's parameter block in main memory, then B is streamed: must be B, not spu0's A */
+    for (unsigned i = sizeof imgB - 0x50; i < sizeof imgB; i++) imgB[i] = (uint8_t)(0xC0 + i);
+    stream(1, 0x60, imgB, sizeof imgB);
+    CHECK(start(1, &r) == SPU_RAW_SRC_PROXY && r.entry == img_b && r.image_id == 41, "spu1 runs B (its own lookup)");
+
+    /* spu1 restarted with nothing new (stop-and-signal, run again): keeps B */
+    CHECK(start(1, &r) == SPU_RAW_SRC_KEPT && r.entry == img_b && r.image_id == 41, "spu1 restart keeps B");
+    /* spu0: a data GET between runs, then a restart: keeps A */
+    stream(0, 0x20000, junk, sizeof junk);
+    CHECK(start(0, &r) == SPU_RAW_SRC_KEPT && r.entry == img_a, "spu0 keeps A after a data GET");
+
+    /* spu2 never ran: an unregistered program streamed must not run anyone else's image */
+    stream(2, 0x60, junk, sizeof junk);
+    CHECK(start(2, &r) == SPU_RAW_SRC_NONE && r.entry == NULL, "spu2 unregistered stream does not run A or B");
+
+    /* the import path: import X, image_load into spu3 binds it; spu4 neither loaded nor streamed gets the import */
+    s_import.entry = img_x; s_import.image_id = 50; s_import.elf_entry = 0x80;
+    spu[3].loaded = s_import;
+    CHECK(start(3, &r) == SPU_RAW_SRC_LOADED && r.entry == img_x && r.elf_entry == 0x80, "spu3 runs the loaded import");
+    CHECK(s_import.entry == img_x, "a bound import is not consumed");
+    CHECK(start(4, &r) == SPU_RAW_SRC_IMPORT && r.entry == img_x, "spu4 runs the latest import");
+    CHECK(s_import.entry == NULL, "the start that used the import consumed it");
+    /* ...so a fresh SPU with nothing loaded or streamed does not run it again */
+    spu[2].current.entry = NULL;
+    CHECK(start(2, &r) == SPU_RAW_SRC_NONE, "a consumed import does not run twice");
+    /* a pending import does not hide a stream: the streamed program runs, the import stays pending */
+    s_import.entry = img_x; s_import.image_id = 50; s_import.elf_entry = 0x80;
+    stream(2, 0x60, imgB, sizeof imgB);
+    CHECK(start(2, &r) == SPU_RAW_SRC_PROXY && r.entry == img_b, "stream before a pending import");
+    CHECK(s_import.entry == img_x, "the import stays pending");
+    /* ...and a stream into a fresh SPU that matches nothing does not fall back to the import */
+    spu[2].current.entry = NULL;
+    stream(2, 0x60, junk, sizeof junk);
+    CHECK(start(2, &r) == SPU_RAW_SRC_NONE, "unmatched stream ignores the import");
+    /* a later stream of A into spu3 replaces X */
+    stream(3, 0x60, imgA, sizeof imgA);
+    CHECK(start(3, &r) == SPU_RAW_SRC_PROXY && r.entry == img_a, "spu3 re-streamed runs A");
+
+    /* a masked registration: any parameter block resolves through find_masked, before the windows */
+    for (unsigned i = 0; i < sizeof imgM; i++) imgM[i] = (uint8_t)(i * 7u + 5u);
+    { uint8_t t[M_SIZE]; memcpy(t, imgM, sizeof t); memset(t + 0x100, 0, 0x50); m_fp = fnv(t, sizeof t); }
+    memset(imgM + 0x100, 0xAB, 0x50);
+    stream(0, 0x60, imgM, sizeof imgM);
+    CHECK(start(0, &r) == SPU_RAW_SRC_PROXY && r.entry == img_m && r.image_id == 60, "spu0 runs the masked program");
+
+    printf("%d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
