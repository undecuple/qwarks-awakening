diff --git a/runtime/spu/spu_raw_resolve.h b/runtime/spu/spu_raw_resolve.h
new file mode 100644
index 0000000..31fe35c
--- /dev/null
+++ b/runtime/spu/spu_raw_resolve.h
@@ -0,0 +1,135 @@
+/* spu_raw_resolve.h -- which lifted image a raw SPU runs when its run-control register is set (spu_raw.c).
+ *
+ * A raw SPU's local store is filled one of two ways, and the image must be chosen PER SPU from what reached
+ * THAT SPU's local store since its last start:
+ *   1. proxy GETs (the PPU streams the program with MFC proxy commands): each contiguous GET run is looked up by
+ *      its fingerprint, then (optional lookup) with its registered parameter area zeroed
+ *      (spu_workload_find_img_masked), then by each declared fingerprint window inside it (spu_raw.h);
+ *   2. sys_raw_spu_image_load: the image of the _sys_spu_image_import before it, bound to that SPU when it
+ *      was loaded into it.
+ * Streams come first: an import still pending when a program is streamed in does not hide the stream.
+ * A restart (run control set again, e.g. after a stop-and-signal) with nothing new resolved keeps the image the SPU
+ * already runs: its local store still holds it, and GETs of data between runs that match no image do not replace
+ * the code. Only when the SPU never had an image and nothing was streamed (the LS was written some other way) does
+ * the most recent import apply; the caller then consumes it (it belongs to that one start).
+ * A GET run that matches nothing does NOT fall back to an import or to an image resolved for another SPU: its local
+ * store holds code nobody registered, and running an earlier image's lifted code on it is wrong.
+ *
+ * Upstream (ps3recomp PR #473) consumes the import at the next start and keeps the SPU's image on a restart with
+ * nothing streamed; what this adds is the per-SPU image_load binding, streams before a pending import, the kept image
+ * after unmatched data GETs (upstream refuses to run), and no import fallback for an unmatched stream. Tools of
+ * Destruction streams igcollspu into raw SPU 0, then igCollBroadSpu (fingerprint window) into raw SPU 1, and
+ * restarts both after data GETs.
+ *
+ * Pure (lookups and fingerprint are passed in), so host tests use it without the runtime.
+ */
+#ifndef SPU_RAW_RESOLVE_H
+#define SPU_RAW_RESOLVE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "spu_raw.h"
+#include "spu_workload.h"
+
+#define SPU_RAW_GET_RUNS_MAX 8
+
+typedef struct {
+    spu_lifted_entry_fn entry;      /* NULL: nothing resolved */
+    int                 image_id;
+    uint32_t            elf_entry;  /* start pc when NPC is 0 (image imports only) */
+} spu_raw_image_ref;
+
+/* Contiguous LS ranges filled by proxy GETs since the SPU's last start. */
+typedef struct {
+    uint32_t lo[SPU_RAW_GET_RUNS_MAX], hi[SPU_RAW_GET_RUNS_MAX];
+    int      n;
+} spu_raw_get_runs;
+
+enum { SPU_RAW_SRC_NONE = 0, SPU_RAW_SRC_PROXY, SPU_RAW_SRC_LOADED, SPU_RAW_SRC_KEPT, SPU_RAW_SRC_IMPORT };
+
+/* Record one proxy GET of `size` bytes at `lsa` (extends the run it continues, else opens a new one). */
+static inline void spu_raw_note_get(spu_raw_get_runs* g, uint32_t lsa, uint32_t size)
+{
+    int r = 0;
+    while (r < g->n && g->hi[r] != lsa) r++;
+    if (r < g->n)                       g->hi[r] += size;
+    else if (r < SPU_RAW_GET_RUNS_MAX) { g->lo[r] = lsa; g->hi[r] = lsa + size; g->n++; }
+}
+
+typedef spu_lifted_entry_fn (*spu_raw_find_fn)(uint64_t fp, int* image_id);
+typedef spu_lifted_entry_fn (*spu_raw_find_masked_fn)(const void* data, size_t n, uint64_t* fp_out, int* image_id);
+typedef uint64_t (*spu_raw_fingerprint_fn)(const void* data, size_t n);
+
+/* Resolve the image for SPU `spu` whose local store is `ls`. `loaded` is the image bound by
+ * sys_raw_spu_image_load to this SPU since its last start (entry NULL if none), `current` the image the SPU ran
+ * at its previous start (entry NULL if it never ran), `import` the most recent _sys_spu_image_import (entry NULL
+ * once consumed). `find_masked` may be NULL. `npc` is only logged. A non-empty `dump_dir` writes each run that
+ * matched nothing to <dump_dir>/rawspu_<fp>_<lo>.bin, its bytes as they sit in local store at <lo>.
+ * Writes *out and returns the SPU_RAW_SRC_* it came from (NONE: the SPU cannot run).
+ * Logs each proxy lookup as "[spu-raw] spuN proxy-loaded LS lo..hi fp=.. npc=.. -> .." (and "   window" lines). */
+static inline int spu_raw_resolve_image(unsigned spu, const uint8_t* ls, const spu_raw_get_runs* g,
+                                        const spu_raw_image_ref* loaded, const spu_raw_image_ref* current,
+                                        const spu_raw_image_ref* import,
+                                        spu_raw_find_fn find, spu_raw_find_masked_fn find_masked,
+                                        spu_raw_fingerprint_fn fingerprint,
+                                        uint32_t npc, const char* dump_dir, FILE* log, spu_raw_image_ref* out)
+{
+    out->entry = NULL; out->image_id = 0; out->elf_entry = 0;
+    for (int r = 0; r < g->n; r++) {
+        const uint8_t* run = ls + g->lo[r];
+        const uint32_t run_len = g->hi[r] - g->lo[r];
+        int id = 0;
+        uint64_t fp = fingerprint(run, run_len);
+        uint64_t masked_fp = 0;
+        spu_lifted_entry_fn fn = find(fp, &id);
+        /* A program that carries a parameter block the PPU fills in before every load is registered with that
+         * area masked out. */
+        if (!fn && find_masked)
+            fn = find_masked(run, run_len, &masked_fp, &id);
+        if (log) {
+            char how[64] = "";
+            if (fn && masked_fp)
+                snprintf(how, sizeof how, " (fp=0x%016llX with its parameter area zeroed)",
+                         (unsigned long long)masked_fp);
+            fprintf(log, "[spu-raw] spu%u proxy-loaded LS 0x%05X..0x%05X fp=0x%016llX npc=0x%05X -> %s%s\n",
+                    spu, g->lo[r], g->hi[r], (unsigned long long)fp, npc,
+                    fn ? "lifted entry registered" : "no match", how);
+        }
+        /* Then each fingerprint window declared inside the run (patch 6502). */
+        if (!fn) {
+            spu_raw_fp_window rng[1 + SPU_RAW_FP_WINDOW_MAX];
+            unsigned nr = spu_raw_run_fp_ranges(g->lo[r], g->hi[r], rng, 1 + SPU_RAW_FP_WINDOW_MAX);
+            for (unsigned k = 1; !fn && k < nr; k++) {     /* rng[0] is the whole run */
+                uint64_t wfp = fingerprint(ls + rng[k].lo, rng[k].len);
+                fn = find(wfp, &id);
+                if (log)
+                    fprintf(log, "[spu-raw] spu%u   window LS 0x%05X..0x%05X fp=0x%016llX -> %s\n",
+                            spu, rng[k].lo, rng[k].lo + rng[k].len, (unsigned long long)wfp,
+                            fn ? "lifted entry registered" : "no match");
+            }
+        }
+        if (fn) { out->entry = fn; out->image_id = id; return SPU_RAW_SRC_PROXY; }
+        if (dump_dir && *dump_dir) {
+            char path[512];
+            snprintf(path, sizeof path, "%s/rawspu_%016llX_%05X.bin", dump_dir, (unsigned long long)fp, g->lo[r]);
+            FILE* f = fopen(path, "wb");
+            if (f) {
+                fwrite(run, 1, run_len, f);
+                fclose(f);
+                if (log) fprintf(log, "[spu-raw] dumped -> %s\n", path);
+            }
+        }
+    }
+    if (loaded && loaded->entry) { *out = *loaded; return SPU_RAW_SRC_LOADED; }
+    if (current && current->entry) {
+        if (log && g->n)
+            fprintf(log, "[spu-raw] spu%u keeps image %d (the GETs since its last start matched no image)\n",
+                    spu, current->image_id);
+        *out = *current; return SPU_RAW_SRC_KEPT;
+    }
+    if (g->n == 0 && import && import->entry) { *out = *import; return SPU_RAW_SRC_IMPORT; }
+    return SPU_RAW_SRC_NONE;
+}
+
+#endif /* SPU_RAW_RESOLVE_H */
