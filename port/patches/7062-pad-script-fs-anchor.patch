+static PadScript* volatile s_anchor_script;
+static void pad_script_fs_hook(const char* guest_path, const char* host_path)
+{
+    PadScript* s = s_anchor_script;
+    if (s) pad_anchor_note(&s->anchor, guest_path);
+    if (s_anchor_prev_hook) s_anchor_prev_hook(guest_path, host_path);
+}
+static void pad_script_anchor_install(PadScript* s)
+{
+    if (!s->anchor.set || s_anchor_script) return;
+    s_anchor_prev_hook = g_ps3_fs_preopen_hook;
+    s_anchor_script = s;
+    g_ps3_fs_preopen_hook = pad_script_fs_hook;
+}
+#else
+static void pad_script_anchor_install(PadScript* s) { (void)s; }
+#endif
