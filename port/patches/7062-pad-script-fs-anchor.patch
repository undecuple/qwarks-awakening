diff --git a/pb/libs/input/pad_script_anchor.h b/libs/input/pad_script_anchor.h
new file mode 100644
index 0000000..d9c594f
--- /dev/null
+++ b/libs/input/pad_script_anchor.h
@@ -0,0 +1,70 @@
+/* R&C patch 7062: PAD_SCRIPT anchors -- scripted input timed from a game event instead of the first pad poll.
+ *
+ * Why: ToD's scripted regression (tools/pad/tods-newgame-play.txt) plays its in-level inputs at fixed wall-clock
+ * seconds, but Metropolis' control starts at a different time in every build (281 s in tods-7049-reg, 247 s in
+ * tods-7054-reg: the PSO work before the first frame moves it). The same script then walks Ratchet into different
+ * places, so the restart / Lua-pair counts of tools/tod-regression.sh differ by build for reasons that are not the
+ * build's (base main also failed the gate, 2026-11-11). An anchor ties the in-level inputs to the level itself.
+ *
+ * Grammar (added to KZ3 3006's v2): a token "@fs:TEXT" starts the anchored part of the script. Every event written
+ * after it is timed in seconds after the anchor fires; events before it keep their seconds since the first pad poll.
+ * The anchor fires at the first pad poll after the game opens (cellFsOpen, found or not) a path that contains TEXT;
+ * only the first such open counts, and only once the script is loaded (its first pad poll). One anchor per script: a
+ * second "@" token is counted as unparsable. Until the anchor fires, anchored events wait (none fires early).
+ * Log: "[cellPad] script anchor '@fs:TEXT' fired at T s (pad clock)" once.
+ *
+ * The anchor is noted from the filesystem thread (pad_anchor_note: a flag) and resolved on the pad thread at its next
+ * poll (pad_anchor_poll), so the anchored times are on the pad clock (wall seconds or PAD_CLOCK=flips) like the rest.
+ * Pure C (host test port/rc/tests/run_pad_anchor_test.sh). */
+#ifndef PAD_SCRIPT_ANCHOR_H
+#define PAD_SCRIPT_ANCHOR_H
+#include <string.h>
+
+#define PAD_ANCHOR_MAX 192
+
+typedef struct {
+    char text[PAD_ANCHOR_MAX];   /* the substring an opened path must contain */
+    int set;                     /* an anchor was parsed */
+    volatile int hit;            /* the filesystem saw a matching open (set once, from any thread) */
+    int resolved;                /* the pad thread saw the hit ... */
+    double at;                   /* ... at this pad-clock second */
+} pad_anchor;                    /* all zero = no anchor (a static PadScript needs no init) */
+
+/* p at '@': parse "@fs:TEXT" (TEXT runs to a separator: space, tab, CR, LF, ',' or '#'). Returns the end of the
+ * token, or NULL when it is not a valid anchor (unknown kind, empty or too long TEXT, or a second anchor). */
+static inline const char* pad_anchor_parse(pad_anchor* a, const char* p)
+{
+    if (p[0] != '@' || strncmp(p + 1, "fs:", 3) != 0 || a->set) return NULL;
+    const char* t = p + 4;
+    size_t n = 0;
+    while (t[n] && t[n] != ' ' && t[n] != '\t' && t[n] != '\r' && t[n] != '\n' && t[n] != ',' && t[n] != '#') n++;
+    if (n == 0 || n >= PAD_ANCHOR_MAX) return NULL;
+    memcpy(a->text, t, n); a->text[n] = 0;
+    a->set = 1;
+    return t + n;
+}
+
+/* Filesystem thread: a path was opened. 1 when this open fired the anchor (the first match). */
+static inline int pad_anchor_note(pad_anchor* a, const char* path)
+{
+    if (!a->set || a->hit || !path || !strstr(path, a->text)) return 0;
+    a->hit = 1;
+    return 1;
+}
+
+/* Pad thread, every poll before the events: 1 when the anchor resolved at this poll (at = now). */
+static inline int pad_anchor_poll(pad_anchor* a, double now)
+{
+    if (!a->set || !a->hit || a->resolved) return 0;
+    a->at = now; a->resolved = 1;
+    return 1;
+}
+
+/* 1 when an event of time t is due at pad-clock second now: now >= t for an unanchored event; for an anchored one,
+ * the anchor resolved and now >= anchor + t (never before the anchor fired). */
+static inline int pad_anchor_due(const pad_anchor* a, int anchored, double t, double now)
+{
+    if (!anchored) return now >= t;
+    return a->resolved && now >= a->at + t;
+}
+#endif
