+/* R&C patch 7039: lifted code inside one of the context's bounded resident code spans, for an image -1 context. Only
+ * a resident span answers: such a context has no primary image whose functions could stand for the live bytes. */
+static inline int rc_interp_resident_rejoin(const spu_context* ctx, uint32_t pc) {
+    for (unsigned slot = 0; slot < 4; ++slot)
+        if (ctx->resident_code[slot].image_id && pc >= ctx->resident_code[slot].lsa &&
+            pc - ctx->resident_code[slot].lsa < ctx->resident_code[slot].size)
+            return spu_lifted_lookup(ctx, pc) != NULL;
+    return 0;
+}
