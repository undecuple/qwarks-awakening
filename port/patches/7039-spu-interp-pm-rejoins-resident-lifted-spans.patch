         if (ctx->image_id >= 0 && ((stop_lsa && ctx->pc == stop_lsa) || spu_interp_rejoin_lookup(ctx, ctx->pc))) { g_spu_interp_steps = steps; g_spu_interp_last_pc = ctx->pc; return ctx->pc; }  /* rejoin fast path */
+        /* R&C patch 7039: an image -1 context (an unlifted policy module, patch 7034) rejoins only lifted code that
