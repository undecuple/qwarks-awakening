Two-layer /dev_hdd0: PS3_HDD0_LOWER (a read-only lower, e.g. RPCS3's dev_hdd0 with a game's HDD install data) under
PS3_HDD0_ROOT (the writable upper). Reads fall through upper -> lower; every write, create, truncate, mkdir, rename and
delete happens in the upper; opening a lower-only file for writing copies it up (times kept); deletes of lower entries
leave whiteouts (<dir>/.wh.<name>), a directory re-created over one is opaque (.wh..opq); listings merge both layers. The
lower is never opened for writing and never renamed, unlinked or created in. Both file layers use it: the cellFs HLE
(ppu_fs.cpp host_path, cellFsOpen, cellFsOpendir/Readdir/GetDirectoryEntries, cellFsMkdir) and the lv2 syscalls
(sys_fs.c translate, open, opendir/readdir/closedir, mkdir, rename, unlink, rmdir). New header
runtime/syscalls/hdd0_overlay.h. Without PS3_HDD0_LOWER nothing changes. Host test: R&C port/rc/tests/run_hdd0_overlay_test.sh.

diff --git a/runtime/syscalls/hdd0_overlay.h b/runtime/syscalls/hdd0_overlay.h
new file mode 100644
--- /dev/null
+++ b/runtime/syscalls/hdd0_overlay.h
@@ -0,0 +1,394 @@
+/*
+ * R&C patch 7014: a two-layer /dev_hdd0 (PS3_HDD0_LOWER under PS3_HDD0_ROOT).
+ *
+ * PS3_HDD0_ROOT is the upper layer (writable; the port's own dev_hdd0). PS3_HDD0_LOWER, when set, is a read-only lower
+ * layer, e.g. RPCS3's dev_hdd0 with a game's HDD install data, used in place. Rules:
+ *  - a read of /dev_hdd0/<rel> takes the upper file if it exists, else the lower one if it exists and is not hidden;
+ *  - every write, create, truncate, mkdir, rename and delete happens in the upper only; opening a lower-only file for
+ *    writing (without truncate) copies it up first, keeping its access and modification times;
+ *  - deleting something that exists in the lower leaves a whiteout in the upper, "<dir>/.wh.<name>"; a directory
+ *    re-created over a whiteout is opaque ("<dir>/.wh..opq"): the lower's old contents stay hidden;
+ *  - directory listings merge both layers, the upper winning, without the markers;
+ *  - the lower is never opened for writing, and no unlink, rename, mkdir or utime ever touches it.
+ * With PS3_HDD0_LOWER unset nothing here is used (hdd0ov_match returns 0). Both file layers use it: the cellFs HLE
+ * (runtime/ppu/ppu_fs.cpp host_path) and the lv2 syscalls (runtime/syscalls/sys_fs.c sys_fs_translate_path).
+ * EDAT plaintext caches go to <upper>/.wh..edatcache (PS3_EDAT_CACHE, when not set), never beside a lower file.
+ * Host test: R&C port/rc/tests/run_hdd0_overlay_test.sh.
+ */
+#ifndef PS3RECOMP_HDD0_OVERLAY_H
+#define PS3RECOMP_HDD0_OVERLAY_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include "../platform/win32_dirent.h"
+#ifdef _WIN32
+#  include <direct.h>
+#  include <io.h>
+#  include <sys/utime.h>
+#  define HDD0OV_MKDIR(p)   _mkdir(p)
+#  define HDD0OV_RMDIR(p)   _rmdir(p)
+#  define HDD0OV_UNLINK(p)  _unlink(p)
+typedef struct _stat64 hdd0ov_stat_t;
+#  define HDD0OV_STAT(p, s) _stat64((p), (s))
+#  define HDD0OV_UTIME(p, t) _utime((p), (t))
+typedef struct _utimbuf hdd0ov_utimbuf;
+#else
+#  include <unistd.h>
+#  include <utime.h>
+#  define HDD0OV_MKDIR(p)   mkdir((p), 0777)
+#  define HDD0OV_RMDIR(p)   rmdir(p)
+#  define HDD0OV_UNLINK(p)  unlink(p)
+typedef struct stat hdd0ov_stat_t;
+#  define HDD0OV_STAT(p, s) stat((p), (s))
+#  define HDD0OV_UTIME(p, t) utime((p), (t))
+typedef struct utimbuf hdd0ov_utimbuf;
+#endif
+
+#define HDD0OV_PATH 1100
+#define HDD0OV_WH ".wh."
+#define HDD0OV_OPQ ".wh..opq"
+
+/* The two roots; 1 when the overlay is on (both set). Read once. */
+static inline int hdd0ov_roots(const char** upper, const char** lower)
+{
+    static const char* up = NULL; static const char* lo = NULL; static int init = 0;
+    if (!init) {
+        up = getenv("PS3_HDD0_ROOT"); lo = getenv("PS3_HDD0_LOWER");
+        if (up && !*up) up = NULL;
+        if (lo && !*lo) lo = NULL;
+        if (up && lo && !getenv("PS3_EDAT_CACHE")) {   /* EDAT plaintext beside a lower file would write the lower */
+            static char env[HDD0OV_PATH + 32];
+            snprintf(env, sizeof env, "PS3_EDAT_CACHE=%s/.wh..edatcache", up);
+            putenv(env);
+        }
+        if (up && lo) fprintf(stderr, "[hdd0-overlay] on: upper '%s', lower '%s' (read-only)\n", up, lo);
+        init = 1;
+    }
+    if (upper) *upper = up;
+    if (lower) *lower = lo;
+    return up && lo;
+}
+
+/* 1 when guest is under /dev_hdd0/ and the overlay is on; *rel = the part after "/dev_hdd0/". */
+static inline int hdd0ov_match(const char* guest, const char** rel)
+{
+    if (!guest || strncmp(guest, "/dev_hdd0/", 10) != 0 || !hdd0ov_roots(NULL, NULL)) return 0;
+    if (rel) *rel = guest + 10;
+    return 1;
+}
+
+static inline void hdd0ov_join(char* out, size_t cap, const char* root, const char* rel)
+{
+    while (*rel == '/' || *rel == '\\') rel++;
+    snprintf(out, cap, "%s/%s", root, rel);
+    for (char* p = out; *p; p++) if (*p == '\\') *p = '/';
+    size_t n = strlen(out);
+    while (n > 1 && out[n - 1] == '/') out[--n] = 0;   /* "dir/" -> "dir" (stat on Windows) */
+}
+
+/* 0 = missing, 1 = file, 2 = directory */
+static inline int hdd0ov_kind(const char* p)
+{
+    hdd0ov_stat_t st;
+    if (HDD0OV_STAT(p, &st) != 0) return 0;
+    return (st.st_mode & S_IFMT) == S_IFDIR ? 2 : 1;
+}
+
+/* The whiteout marker of rel (in the upper). */
+static inline void hdd0ov_wh(char* out, size_t cap, const char* rel)
+{
+    const char* up; hdd0ov_roots(&up, NULL);
+    char tmp[HDD0OV_PATH]; hdd0ov_join(tmp, sizeof tmp, up, rel);
+    char* slash = strrchr(tmp, '/');
+    if (!slash) { snprintf(out, cap, "%s", tmp); return; }
+    *slash = 0;
+    snprintf(out, cap, "%s/" HDD0OV_WH "%s", tmp, slash + 1);
+}
+
+/* 1 when the lower's rel is visible: no whiteout for rel or an ancestor, no opaque upper ancestor directory. */
+static inline int hdd0ov_lower_visible(const char* rel)
+{
+    const char* up; hdd0ov_roots(&up, NULL);
+    while (*rel == '/' || *rel == '\\') rel++;
+    char part[HDD0OV_PATH]; size_t n = strlen(rel);
+    if (n >= sizeof part) return 0;
+    for (size_t i = 0; i <= n; i++) {
+        if (i < n && rel[i] != '/' && rel[i] != '\\') continue;
+        memcpy(part, rel, i); part[i] = 0;
+        if (!i) continue;
+        char wh[HDD0OV_PATH]; hdd0ov_wh(wh, sizeof wh, part);
+        if (hdd0ov_kind(wh)) return 0;
+        if (i < n) {   /* a proper ancestor directory: opaque in the upper? */
+            char up_dir[HDD0OV_PATH], opq[HDD0OV_PATH + 16];
+            hdd0ov_join(up_dir, sizeof up_dir, up, part);
+            snprintf(opq, sizeof opq, "%s/" HDD0OV_OPQ, up_dir);
+            if (hdd0ov_kind(opq)) return 0;
+        }
+    }
+    return 1;
+}
+
+/* The host path a read of rel uses: the upper if it exists, else a visible lower, else the (missing) upper path. */
+static inline void hdd0ov_resolve(const char* rel, char* out, size_t cap)
+{
+    const char* up; const char* lo; hdd0ov_roots(&up, &lo);
+    hdd0ov_join(out, cap, up, rel);
+    if (hdd0ov_kind(out)) return;
+    char lp[HDD0OV_PATH]; hdd0ov_join(lp, sizeof lp, lo, rel);
+    if (hdd0ov_kind(lp) && hdd0ov_lower_visible(rel)) snprintf(out, cap, "%s", lp);
+}
+
+/* Merged kind of rel (0 missing, 1 file, 2 dir) */
+static inline int hdd0ov_merged_kind(const char* rel)
+{
+    char p[HDD0OV_PATH]; hdd0ov_resolve(rel, p, sizeof p);
+    return hdd0ov_kind(p);
+}
+
+static inline void hdd0ov_parent(const char* rel, char* out, size_t cap)
+{
+    while (*rel == '/' || *rel == '\\') rel++;
+    snprintf(out, cap, "%s", rel);
+    size_t n = strlen(out);
+    while (n && (out[n - 1] == '/' || out[n - 1] == '\\')) out[--n] = 0;
+    char* s = strrchr(out, '/'); char* b = strrchr(out, '\\'); if (b > s) s = b;
+    if (s) *s = 0; else out[0] = 0;
+}
+
+/* Make the upper's copy of directory rel (and its parents) exist; merged view unchanged. 0 = ok. */
+static inline int hdd0ov_upper_dirs(const char* rel)
+{
+    const char* up; hdd0ov_roots(&up, NULL);
+    char p[HDD0OV_PATH]; hdd0ov_join(p, sizeof p, up, rel);
+    size_t root_len = strlen(up);
+    for (char* c = p + root_len + 1; *c; c++)
+        if (*c == '/') { *c = 0; if (!hdd0ov_kind(p)) HDD0OV_MKDIR(p); *c = '/'; }
+    if (!hdd0ov_kind(p)) HDD0OV_MKDIR(p);
+    return hdd0ov_kind(p) == 2 ? 0 : -1;
+}
+
+/* Copy src to dst (new file), keeping src's access and modification times. 0 = ok. */
+static inline int hdd0ov_copy_file(const char* src, const char* dst)
+{
+    FILE* in = fopen(src, "rb");
+    if (!in) return -1;
+    FILE* out = fopen(dst, "wb");
+    if (!out) { fclose(in); return -1; }
+    char buf[65536]; size_t n; int ok = 1;
+    while ((n = fread(buf, 1, sizeof buf, in)) > 0) if (fwrite(buf, 1, n, out) != n) { ok = 0; break; }
+    fclose(in);
+    if (fclose(out) != 0) ok = 0;
+    if (ok) {
+        hdd0ov_stat_t st;
+        if (HDD0OV_STAT(src, &st) == 0) { hdd0ov_utimbuf t; t.actime = st.st_atime; t.modtime = st.st_mtime; HDD0OV_UTIME(dst, &t); }
+    }
+    return ok ? 0 : -1;
+}
+
+/* The upper path to open rel for writing. create: the open may create the file (O_CREAT); trunc: it truncates
+ * (O_TRUNC). A lower-only file is copied up first (its times kept), or created empty in the upper when truncated.
+ * Returns 0 with out set, -1 for ENOENT (no merged parent directory, or no file and no create). */
+static inline int hdd0ov_for_write(const char* rel, char* out, size_t cap, int create, int trunc)
+{
+    const char* up; const char* lo; hdd0ov_roots(&up, &lo);
+    char parent[HDD0OV_PATH]; hdd0ov_parent(rel, parent, sizeof parent);
+    if (parent[0] && hdd0ov_merged_kind(parent) != 2) return -1;
+    hdd0ov_join(out, cap, up, rel);
+    if (hdd0ov_kind(out)) return 0;
+    char lp[HDD0OV_PATH]; hdd0ov_join(lp, sizeof lp, lo, rel);
+    const int lower_kind = hdd0ov_lower_visible(rel) ? hdd0ov_kind(lp) : 0;
+    if (lower_kind == 2) return 0;   /* a directory: the caller's open fails as it would */
+    if (!lower_kind && !create) return -1;
+    if (parent[0] && hdd0ov_upper_dirs(parent) != 0) return -1;
+    if (lower_kind == 1) {
+        if (trunc) { FILE* f = fopen(out, "wb"); if (!f) return -1; fclose(f); return 0; }
+        return hdd0ov_copy_file(lp, out);
+    }
+    char wh[HDD0OV_PATH]; hdd0ov_wh(wh, sizeof wh, rel);
+    if (hdd0ov_kind(wh)) HDD0OV_UNLINK(wh);   /* created again: the whiteout goes */
+    return 0;
+}
+
+/* mkdir: 0 ok, 1 already exists (merged), -1 parent missing */
+static inline int hdd0ov_mkdir(const char* rel)
+{
+    if (hdd0ov_merged_kind(rel)) return 1;
+    char parent[HDD0OV_PATH]; hdd0ov_parent(rel, parent, sizeof parent);
+    if (parent[0] && hdd0ov_merged_kind(parent) != 2) return -1;
+    char wh[HDD0OV_PATH]; hdd0ov_wh(wh, sizeof wh, rel);
+    const int was_whited = hdd0ov_kind(wh) != 0;
+    if (hdd0ov_upper_dirs(rel) != 0) return -1;
+    if (was_whited) {   /* a lower directory of this name was deleted: keep its contents hidden */
+        HDD0OV_UNLINK(wh);
+        const char* up; hdd0ov_roots(&up, NULL);
+        char p[HDD0OV_PATH], opq[HDD0OV_PATH + 16]; hdd0ov_join(p, sizeof p, up, rel);
+        snprintf(opq, sizeof opq, "%s/" HDD0OV_OPQ, p);
+        FILE* f = fopen(opq, "wb"); if (f) fclose(f);
+    }
+    return 0;
+}
+
+static inline int hdd0ov_is_marker(const char* name) { return strncmp(name, HDD0OV_WH, 4) == 0; }
+
+/* Merged directory listing */
+typedef struct hdd0ov_entry { char name[256]; char path[HDD0OV_PATH]; int is_dir; } hdd0ov_entry;
+typedef struct hdd0ov_dir { hdd0ov_entry* e; int n, cap, pos; } hdd0ov_dir;
+
+static inline void hdd0ov_dir_add(hdd0ov_dir* d, const char* name, const char* dirpath)
+{
+    for (int i = 0; i < d->n; i++) if (!strcmp(d->e[i].name, name)) return;   /* the upper came first */
+    if (d->n == d->cap) {
+        int nc = d->cap ? d->cap * 2 : 64;
+        hdd0ov_entry* ne = (hdd0ov_entry*)realloc(d->e, (size_t)nc * sizeof *ne);
+        if (!ne) return;
+        d->e = ne; d->cap = nc;
+    }
+    hdd0ov_entry* x = &d->e[d->n++];
+    snprintf(x->name, sizeof x->name, "%s", name);
+    snprintf(x->path, sizeof x->path, "%s/%s", dirpath, name);
+    x->is_dir = hdd0ov_kind(x->path) == 2;
+}
+
+/* NULL when rel is not a directory in the merged view. Entries in upper-then-lower order, "." and ".." first. */
+static inline hdd0ov_dir* hdd0ov_opendir(const char* rel)
+{
+    if (hdd0ov_merged_kind(rel) != 2) return NULL;
+    const char* up; const char* lo; hdd0ov_roots(&up, &lo);
+    hdd0ov_dir* d = (hdd0ov_dir*)calloc(1, sizeof *d);
+    if (!d) return NULL;
+    char upath[HDD0OV_PATH], lpath[HDD0OV_PATH];
+    hdd0ov_join(upath, sizeof upath, up, rel); hdd0ov_join(lpath, sizeof lpath, lo, rel);
+    const int up_dir = hdd0ov_kind(upath) == 2;
+    char opq[HDD0OV_PATH + 16]; snprintf(opq, sizeof opq, "%s/" HDD0OV_OPQ, upath);
+    const int lower_shown = hdd0ov_kind(lpath) == 2 && hdd0ov_lower_visible(rel) && !(up_dir && hdd0ov_kind(opq));
+    hdd0ov_dir_add(d, ".", up_dir ? upath : lpath);
+    hdd0ov_dir_add(d, "..", up_dir ? upath : lpath);
+    if (up_dir) {
+        DIR* h = opendir(upath);
+        if (h) { struct dirent* x;
+            while ((x = readdir(h)) != NULL)
+                if (strcmp(x->d_name, ".") && strcmp(x->d_name, "..") && !hdd0ov_is_marker(x->d_name))
+                    hdd0ov_dir_add(d, x->d_name, upath);
+            closedir(h); }
+    }
+    if (lower_shown) {
+        DIR* h = opendir(lpath);
+        if (h) { struct dirent* x;
+            while ((x = readdir(h)) != NULL) {
+                if (!strcmp(x->d_name, ".") || !strcmp(x->d_name, "..") || hdd0ov_is_marker(x->d_name)) continue;
+                char wh[HDD0OV_PATH + 300], crel[HDD0OV_PATH + 300];
+                snprintf(crel, sizeof crel, "%s/%s", rel, x->d_name);
+                hdd0ov_wh(wh, sizeof wh, crel);
+                if (!hdd0ov_kind(wh)) hdd0ov_dir_add(d, x->d_name, lpath);
+            }
+            closedir(h); }
+    }
+    return d;
+}
+/* 1 with the next entry, 0 at the end */
+static inline int hdd0ov_readdir(hdd0ov_dir* d, const char** name, const char** path, int* is_dir)
+{
+    if (!d || d->pos >= d->n) return 0;
+    hdd0ov_entry* x = &d->e[d->pos++];
+    if (name) *name = x->name;
+    if (path) *path = x->path;
+    if (is_dir) *is_dir = x->is_dir;
+    return 1;
+}
+static inline void hdd0ov_closedir(hdd0ov_dir* d) { if (d) { free(d->e); free(d); } }
+
+/* unlink a file: 0 ok, -1 ENOENT, -2 is a directory */
+static inline int hdd0ov_unlink(const char* rel)
+{
+    const char* up; const char* lo; hdd0ov_roots(&up, &lo);
+    const int k = hdd0ov_merged_kind(rel);
+    if (!k) return -1;
+    if (k == 2) return -2;
+    char upath[HDD0OV_PATH], lpath[HDD0OV_PATH];
+    hdd0ov_join(upath, sizeof upath, up, rel); hdd0ov_join(lpath, sizeof lpath, lo, rel);
+    if (hdd0ov_kind(upath) == 1 && HDD0OV_UNLINK(upath) != 0) return -1;
+    if (hdd0ov_kind(lpath) && hdd0ov_lower_visible(rel)) {
+        char parent[HDD0OV_PATH]; hdd0ov_parent(rel, parent, sizeof parent);
+        if (parent[0]) hdd0ov_upper_dirs(parent);
+        char wh[HDD0OV_PATH]; hdd0ov_wh(wh, sizeof wh, rel);
+        FILE* f = fopen(wh, "wb"); if (!f) return -1; fclose(f);
+    }
+    return 0;
+}
+
+/* rmdir: 0 ok, -1 ENOENT, -2 not empty, -3 not a directory */
+static inline int hdd0ov_rmdir(const char* rel)
+{
+    const char* up; const char* lo; hdd0ov_roots(&up, &lo);
+    const int k = hdd0ov_merged_kind(rel);
+    if (!k) return -1;
+    if (k != 2) return -3;
+    hdd0ov_dir* d = hdd0ov_opendir(rel);
+    const int entries = d ? d->n - 2 : 0;
+    hdd0ov_closedir(d);
+    if (entries > 0) return -2;
+    char upath[HDD0OV_PATH], lpath[HDD0OV_PATH];
+    hdd0ov_join(upath, sizeof upath, up, rel); hdd0ov_join(lpath, sizeof lpath, lo, rel);
+    if (hdd0ov_kind(upath) == 2) {   /* drop the markers it holds, then the directory */
+        DIR* h = opendir(upath);
+        if (h) { struct dirent* x;
+            while ((x = readdir(h)) != NULL)
+                if (hdd0ov_is_marker(x->d_name)) { char m[HDD0OV_PATH + 300]; snprintf(m, sizeof m, "%s/%s", upath, x->d_name); HDD0OV_UNLINK(m); }
+            closedir(h); }
+        if (HDD0OV_RMDIR(upath) != 0) return -1;
+    }
+    if (hdd0ov_kind(lpath) == 2 && hdd0ov_lower_visible(rel)) {
+        char parent[HDD0OV_PATH]; hdd0ov_parent(rel, parent, sizeof parent);
+        if (parent[0]) hdd0ov_upper_dirs(parent);
+        char wh[HDD0OV_PATH]; hdd0ov_wh(wh, sizeof wh, rel);
+        FILE* f = fopen(wh, "wb"); if (!f) return -1; fclose(f);
+    }
+    return 0;
+}
+
+/* rename a -> b (files and directory trees): b is built in the upper from a's merged contents, then a is deleted in
+ * the merged view (upper copy removed, lower hidden by a whiteout). 0 ok, -1 ENOENT / failure. */
+static inline int hdd0ov_rename(const char* a, const char* b)
+{
+    const char* up; const char* lo; hdd0ov_roots(&up, &lo);
+    const int k = hdd0ov_merged_kind(a);
+    if (!k) return -1;
+    if (k == 1) {
+        if (hdd0ov_merged_kind(b) == 1 && hdd0ov_unlink(b) != 0) return -1;
+        char bpath[HDD0OV_PATH];
+        if (hdd0ov_for_write(b, bpath, sizeof bpath, 1, 1) != 0) return -1;
+        char ua[HDD0OV_PATH]; hdd0ov_join(ua, sizeof ua, up, a);
+        if (hdd0ov_kind(ua) == 1) {   /* upper file: a plain rename */
+            if (rename(ua, bpath) != 0) return -1;
+            char la[HDD0OV_PATH]; hdd0ov_join(la, sizeof la, lo, a);
+            if (hdd0ov_kind(la) && hdd0ov_lower_visible(a)) {   /* the lower one would show through: hide it */
+                char wh[HDD0OV_PATH]; hdd0ov_wh(wh, sizeof wh, a);
+                FILE* f = fopen(wh, "wb"); if (f) fclose(f);
+            }
+            return 0;
+        }
+        char src[HDD0OV_PATH]; hdd0ov_resolve(a, src, sizeof src);
+        if (hdd0ov_copy_file(src, bpath) != 0) return -1;
+        return hdd0ov_unlink(a);
+    }
+    /* directory: recreate b, move every child, remove a */
+    if (hdd0ov_merged_kind(b)) return -1;
+    if (hdd0ov_mkdir(b) != 0) return -1;
+    hdd0ov_dir* d = hdd0ov_opendir(a);
+    const char* name; int rc = 0;
+    while (d && hdd0ov_readdir(d, &name, NULL, NULL)) {
+        if (!strcmp(name, ".") || !strcmp(name, "..")) continue;
+        char ca[HDD0OV_PATH + 300], cb[HDD0OV_PATH + 300];
+        snprintf(ca, sizeof ca, "%s/%s", a, name); snprintf(cb, sizeof cb, "%s/%s", b, name);
+        if (hdd0ov_rename(ca, cb) != 0) rc = -1;
+    }
+    hdd0ov_closedir(d);
+    if (rc) return rc;
+    return hdd0ov_rmdir(a);
+}
+
+#endif /* PS3RECOMP_HDD0_OVERLAY_H */
diff --git a/runtime/ppu/ppu_fs.cpp b/runtime/ppu/ppu_fs.cpp
--- a/runtime/ppu/ppu_fs.cpp
+++ b/runtime/ppu/ppu_fs.cpp
@@ -26,6 +26,7 @@
 #include <atomic>
 #include <sys/stat.h>
 #include "../platform/win32_dirent.h"   /* <dirent.h>, or a Win32 stand-in */
+#include "../syscalls/hdd0_overlay.h"   /* R&C patch 7014: PS3_HDD0_LOWER under PS3_HDD0_ROOT */
 
 /* Guest-resolving host backtrace (ppu_loader.cpp). Must be declared at file scope:
