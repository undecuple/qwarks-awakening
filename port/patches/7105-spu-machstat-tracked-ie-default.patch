diff --git a/runtime/spu/spu_machstat.h b/runtime/spu/spu_machstat.h
new file mode 100644
index 0000000..6f78d26
--- /dev/null
+++ b/runtime/spu/spu_machstat.h
@@ -0,0 +1,41 @@
+/* R&C patch 7105: the value `rdch SPU_RdMachStat` returns.
+ *
+ * CBEA v1.02 s.9.8: SPU_RdMachStat bit 31 (value 0x1) is the SPU's interrupt-enable state, bit 30 (0x2) the
+ * isolation state (this runtime never runs isolated SPUs: 0), the rest reads 0. The interrupt-enable state is
+ * changed only by the E (0x40000, set) and D (0x80000, clear) bits of a taken bi, bisl, bisled, iret, biz, binz, bihz or
+ * bihnz, and cleared by interrupt entry; reading the channel changes nothing. The runtime already keeps that state in
+ * ctx->int_enable (the lift, spu_lifter.py `_ied`; the interpreter, spu_interp.c; the bi fallbacks in spu_channels.c;
+ * interrupt entry, spu_drain.c spu_take_interrupt).
+ *
+ * KZ3 patch 1061 returned the constant "1 while running" unless KZ3_SPU_MACHSTAT_IE=1. Insomniac's WWS job policy
+ * module (All 4 One pm 0xDAE900, Into the Nexus pm 0xD3F400: the audio job list, SPURS wid 4) asserts at its job-API
+ * entries that interrupts are off, `rdch SPU_RdMachStat; andi 1; brnz 0x1714`, and 0x1714 is a `stop 0` trap: with the
+ * constant 1 the audio job list stops there for good (status 0x2, pc 0x1714), the PPU's sound command ring at
+ * 0x00FF3B40 (A4O) fills, and the main thread then waits on it forever (SPU notes 2026-11-19).
+ * Pure header, host-testable (runtime/spu/tests/test_spu_machstat.c). */
+#ifndef SPU_MACHSTAT_H
+#define SPU_MACHSTAT_H
+
+#include <stdint.h>
+
+#define SPU_MACHSTAT_IE        0x1u   /* bit 31 in CBEA numbering: interrupts enabled */
+#define SPU_MACHSTAT_ISOLATED  0x2u   /* bit 30: isolation mode (never set here) */
+
+/* The architectural value (tracked = 1, the default) or the old KZ3 1061 rule (tracked = 0: 1 while running, for
+ * A/B runs only, KZ3_SPU_MACHSTAT_IE=0). */
+static inline uint32_t spu_machstat_value(uint32_t int_enable, int running, int tracked)
+{
+    if (!tracked) return running ? SPU_MACHSTAT_IE : 0u;
+    return int_enable ? SPU_MACHSTAT_IE : 0u;
+}
+
+/* The interrupt-enable effect of a TAKEN bi-family branch word (bi, bisl, bisled, iret, biz, binz, bihz, bihnz): E sets,
+ * D clears, neither leaves it. Same decode as the lift and the interpreter. */
+static inline uint32_t spu_ie_after_branch(uint32_t int_enable, uint32_t insn)
+{
+    if (insn & 0x40000u) return 1u;
+    if (insn & 0x80000u) return 0u;
+    return int_enable;
+}
+
+#endif /* SPU_MACHSTAT_H */
diff --git a/runtime/spu/tests/test_spu_machstat.c b/runtime/spu/tests/test_spu_machstat.c
new file mode 100644
index 0000000..5c41142
--- /dev/null
+++ b/runtime/spu/tests/test_spu_machstat.c
@@ -0,0 +1,107 @@
+/* R&C patch 7105 host test: what `rdch SPU_RdMachStat` returns, against the CBEA rule (bit 31 = the interrupt-enable
+ * state, set/cleared by the E/D bits of a taken bi-family branch, cleared by interrupt entry, unchanged by the read).
+ * A small SPU model runs the two guest shapes that read it:
+ *   1. Insomniac's WWS job policy module (A4O pm 0xDAE900, Nexus 0xD3F400): a job enters a job-API entry through bisld
+ *      (D bit: interrupts off), the entry does `rdch SPU_RdMachStat; andi 1; brnz 0x1714` and 0x1714 is `stop 0`.
+ *      Pass = the job API returns, the trap is never taken, for every job of the list.
+ *   2. A WWS AddJob that saves the state (`rdch; andi 1`), disables, and re-enables on exit only if it was set (KZ3's
+ *      shape, KZ3 patch 1061 note): entered with interrupts on, it must leave them on; entered with them off, off.
+ * Plus the plain rules: a context starts with IE clear, interrupt entry clears it, iret with E sets it, a stopped SPU
+ * keeps its IE bit, and reading changes nothing.
+ * Build with -DNO_7105 for the pre-patch value ("1 while running", KZ3 1061's default): this test FAILS.
+ *   cc -std=gnu17 -Wall -Wextra -I runtime/spu runtime/spu/tests/test_spu_machstat.c && ./a.out */
+#include <stdio.h>
+#include <stdint.h>
+#include "spu_machstat.h"
+
+#ifdef NO_7105
+#define TRACKED 0
+#else
+#define TRACKED 1
+#endif
+
+/* bi-family words with the E/D bits (opcode bits are irrelevant to the decode) */
+#define BR_PLAIN 0x35000000u          /* bi    */
+#define BR_E     (0x35000000u | 0x40000u)  /* bie / irete / bisle */
+#define BR_D     (0x35200000u | 0x80000u)  /* bid / bisld */
+
+typedef struct {
+    uint32_t int_enable, status_running, trapped, stopped_pc;
+} spu_t;
+
+static int fails, passes;
+#define CHECK(c, ...) do { if (c) passes++; else { fails++; printf("FAIL: " __VA_ARGS__); printf("\n"); } } while (0)
+
+static uint32_t rdch_machstat(spu_t* s)
+{
+    const uint32_t before = s->int_enable;
+    uint32_t v = spu_machstat_value(s->int_enable, s->status_running, TRACKED);
+    CHECK(s->int_enable == before, "reading SPU_RdMachStat changed the IE state");
+    return v;
+}
+static void branch(spu_t* s, uint32_t insn) { s->int_enable = spu_ie_after_branch(s->int_enable, insn); }
+static void take_interrupt(spu_t* s) { s->int_enable = 0; }   /* spu_take_interrupt: srr0 <- pc, IE <- 0 */
+
+/* WWS PM job-API entry (A4O 0x17D8, 0x1858, 0x18C0, ...): assert interrupts off, else stop 0 at 0x1714 */
+static int wws_job_api(spu_t* s)
+{
+    if (rdch_machstat(s) & 1u) { s->trapped = 1; s->status_running = 0; s->stopped_pc = 0x1714; return 0; }
+    return 1;
+}
+
+/* One job of the list: the PM's job loop runs with interrupts on between jobs (bie at its poll), the job calls the
+ * job API through bisld (D) and comes back by a plain bi. */
+static int run_job(spu_t* s)
+{
+    branch(s, BR_E);        /* PM poll window: interrupts on */
+    branch(s, BR_D);        /* bisld into the job (interrupts off) */
+    if (!wws_job_api(s)) return 0;
+    branch(s, BR_PLAIN);    /* bi $r0 back: IE unchanged */
+    return 1;
+}
+
+/* AddJob-like save/restore (KZ3 1061 note): save IE, disable, work, re-enable only if it was on */
+static void addjob(spu_t* s)
+{
+    const uint32_t saved = rdch_machstat(s) & 1u;
+    branch(s, BR_D);
+    branch(s, saved ? BR_E : BR_PLAIN);
+}
+
+int main(void)
+{
+    /* plain rules */
+    spu_t s = { 0, 1, 0, 0 };
+    CHECK(rdch_machstat(&s) == 0, "a fresh running context reads IE 1 (it starts with interrupts disabled)");
+    branch(&s, BR_E);
+    CHECK(rdch_machstat(&s) == 1, "bie did not set the IE bit");
+    take_interrupt(&s);
+    CHECK(rdch_machstat(&s) == 0, "interrupt entry left the IE bit set");
+    branch(&s, BR_E);       /* irete */
+    CHECK(rdch_machstat(&s) == 1, "irete did not set the IE bit");
+    branch(&s, BR_PLAIN);
+    CHECK(rdch_machstat(&s) == 1, "a plain bi changed the IE bit");
+    s.status_running = 0;
+    CHECK(rdch_machstat(&s) == 1, "the IE bit follows the run state instead of the interrupt-enable state");
+    CHECK((spu_machstat_value(1, 1, TRACKED) & ~SPU_MACHSTAT_IE) == 0, "bits other than IE are set (no isolation)");
+
+    /* 1. the audio job list: 64 jobs through the job API, never the stop-0 trap */
+    spu_t a = { 0, 1, 0, 0 };
+    int done = 0;
+    for (int j = 0; j < 64; j++) { if (!run_job(&a)) break; done++; }
+    CHECK(!a.trapped, "the WWS PM took its interrupts-off trap: stopped at pc 0x%04X after %d of 64 jobs",
+          a.stopped_pc, done);
+    CHECK(done == 64, "only %d of 64 jobs ran", done);
+    CHECK(a.status_running, "the job list is not running at the end");
+
+    /* 2. AddJob keeps the caller's state */
+    spu_t k = { 1, 1, 0, 0 };
+    addjob(&k);
+    CHECK(k.int_enable == 1, "AddJob entered with interrupts on left them off");
+    spu_t k0 = { 0, 1, 0, 0 };
+    addjob(&k0);
+    CHECK(k0.int_enable == 0, "AddJob entered with interrupts off turned them on");
+
+    printf("test_spu_machstat: %d passed, %d failed%s\n", passes, fails, TRACKED ? "" : " (NO_7105: pre-patch value)");
+    return fails ? 1 : 0;
+}
