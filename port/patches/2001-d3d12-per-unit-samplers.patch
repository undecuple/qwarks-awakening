+/* ---------------------------------------------------------------------------
+ * Guest sampler state -> D3D12 sampler descriptors
+ *
+ * Register layouts (libgcm cellGcmSetTexture* encodings, RPCS3 rsx::fragment_texture):
+ *   TEXTURE_FILTER   0x1A14: bias [12:0] signed 4.8 fixed, convolution kernel [15:13],
+ *                            min [18:16], mag [26:24], A/R/G/B signed [31:28]
+ *                            min: 1 NEAREST 2 LINEAR 3 NEAREST_NEAREST 4 LINEAR_NEAREST
+ *                                 5 NEAREST_LINEAR 6 LINEAR_LINEAR 7 CONVOLUTION
+ *                                 (in-level filter first, then between-mip filter)
+ *                            mag: 1 NEAREST 2 LINEAR 4 CONVOLUTION
+ *   TEXTURE_ADDRESS  0x1A08: wrap s [3:0], aniso bias [7:4], wrap t [11:8], unsigned remap [15:12],
+ *                            wrap r [19:16], gamma [23:20], signed remap [27:24], zfunc [31:28]
+ *                            wrap: 1 WRAP 2 MIRROR 3 CLAMP_TO_EDGE 4 BORDER 5 CLAMP
+ *                                  6 MIRROR_ONCE_CLAMP_TO_EDGE 7 MIRROR_ONCE_BORDER 8 MIRROR_ONCE_CLAMP
+ *   TEXTURE_CONTROL0 0x1A0C: enable [31], min LOD [30:19] and max LOD [18:7] unsigned 4.8,
+ *                            max aniso [6:4] (1,2,4,6,8,10,12,16x)
+ *   TEXTURE_BORDER_COLOR 0x1A1C: ARGB8
+ * Not mapped here: convolution kernels (taken as linear), per-channel signed
+ * reads, gamma, aniso bias, the depth compare function (no SampleCmp in the
+ * decompiled programs yet).
+ * ASSUMPTION: GL_CLAMP-style CLAMP (5) and MIRROR_ONCE_CLAMP (8) are taken as
+ * clamp-to-edge / mirror-once (no border blending at the edge).
+ * -----------------------------------------------------------------------*/
+static D3D12_TEXTURE_ADDRESS_MODE rsx_wrap_d3d(u32 w)
+{
+    switch (w) {
+    case 1: return D3D12_TEXTURE_ADDRESS_MODE_WRAP;
+    case 2: return D3D12_TEXTURE_ADDRESS_MODE_MIRROR;
+    case 3: return D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    case 4: return D3D12_TEXTURE_ADDRESS_MODE_BORDER;
+    case 5: return D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    case 6: case 7: case 8: return D3D12_TEXTURE_ADDRESS_MODE_MIRROR_ONCE;
+    default: return D3D12_TEXTURE_ADDRESS_MODE_WRAP;
+    }
+}
+
+static float rsx_fxp_s4_8(u32 v)   /* 13-bit signed 4.8 fixed point */
+{
+    int32_t s = (int32_t)(v & 0x1FFFu);
+    if (s & 0x1000) s -= 0x2000;
+    return (float)s / 256.0f;
+}
+
+static void rsx_sampler_desc(u32 filter, u32 address, u32 ctrl0, u32 border,
+                             D3D12_SAMPLER_DESC* d)
+{
+    static const u32 aniso_tab[8] = { 1, 2, 4, 6, 8, 10, 12, 16 };
+    const u32 minf = (filter >> 16) & 7u, magf = (filter >> 24) & 7u;
+    /* in-level min filter linear?  mip filter: 0 none, 1 point, 2 linear */
+    int min_lin = 1, mip = 0;
+    switch (minf) {
+    case 1: min_lin = 0; mip = 0; break;
+    case 2: min_lin = 1; mip = 0; break;
+    case 3: min_lin = 0; mip = 1; break;
+    case 4: min_lin = 1; mip = 1; break;
+    case 5: min_lin = 0; mip = 2; break;
+    case 6: min_lin = 1; mip = 2; break;
+    default: min_lin = 1; mip = 0; break;   /* 7 = convolution: approximated as linear */
+    }
+    const int mag_lin = (magf == 1) ? 0 : 1;  /* 2 linear, 4 convolution -> linear */
+    const u32 aniso = aniso_tab[(ctrl0 >> 4) & 7u];
+
+    memset(d, 0, sizeof *d);
+    if (aniso > 1 && min_lin) {
+        d->Filter = D3D12_FILTER_ANISOTROPIC;
+        d->MaxAnisotropy = aniso;
+    } else {
+        d->Filter = (D3D12_FILTER)(((u32)min_lin << 4) | ((u32)mag_lin << 2) | (mip == 2 ? 1u : 0u));
+        d->MaxAnisotropy = 1;
+    }
+    d->AddressU = rsx_wrap_d3d(address & 0xFu);
+    d->AddressV = rsx_wrap_d3d((address >> 8) & 0xFu);
+    d->AddressW = rsx_wrap_d3d((address >> 16) & 0xFu);
+    d->MipLODBias = rsx_fxp_s4_8(filter);
+    d->ComparisonFunc = D3D12_COMPARISON_FUNC_NEVER;
+    d->BorderColor[0] = (float)((border >> 16) & 0xFFu) / 255.0f;   /* R */
+    d->BorderColor[1] = (float)((border >>  8) & 0xFFu) / 255.0f;   /* G */
+    d->BorderColor[2] = (float)( border        & 0xFFu) / 255.0f;   /* B */
+    d->BorderColor[3] = (float)((border >> 24) & 0xFFu) / 255.0f;   /* A */
+    d->MinLOD = (float)((ctrl0 >> 19) & 0xFFFu) / 256.0f;
+    d->MaxLOD = (float)((ctrl0 >>  7) & 0xFFFu) / 256.0f;
+    if (d->MaxLOD < d->MinLOD) d->MaxLOD = d->MinLOD;
+    if (mip == 0) d->MaxLOD = d->MinLOD;      /* no mipmapping: one level only */
+}
+
+static void samp_write(u32 idx, const D3D12_SAMPLER_DESC* d)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    s_d3d.samp_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.samp_heap, &h);
+    h.ptr += (u64)idx * s_d3d.samp_inc;
+    s_d3d.device->lpVtbl->CreateSampler(s_d3d.device, d, h);
+}
+
+/* Create the shader-visible sampler heap and its two fixed entries. */
+static void samp_heap_init(void)
+{
+    D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER;
+    hd.NumDescriptors = SAMP_HEAP_SIZE;
+    hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    if (FAILED(s_d3d.device->lpVtbl->CreateDescriptorHeap(s_d3d.device, &hd,
+            &IID_ID3D12DescriptorHeap, (void**)&s_d3d.samp_heap))) {
+        printf("[D3D12] sampler heap creation failed\n");
+        s_d3d.samp_heap = NULL;
+        return;
+    }
+    s_d3d.samp_inc = s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+        s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER);
+    D3D12_SAMPLER_DESC d = {0};
+    d.Filter = D3D12_FILTER_MIN_MAG_MIP_POINT;
+    d.AddressU = d.AddressV = d.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    d.MaxAnisotropy = 1; d.ComparisonFunc = D3D12_COMPARISON_FUNC_NEVER;
+    d.MaxLOD = D3D12_FLOAT32_MAX;
+    samp_write(SAMP_POINT_CLAMP, &d);
+    d.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+    d.AddressU = d.AddressV = d.AddressW = D3D12_TEXTURE_ADDRESS_MODE_WRAP;
+    samp_write(SAMP_LINEAR_WRAP, &d);
+    s_d3d.samp_n = 2;
+    memset(s_d3d.samp_hash, 0, sizeof s_d3d.samp_hash);
+    /* Units the guest has not configured keep the old static-sampler defaults. */
+    for (int u = 0; u < RSX_D3D_TEX_UNITS; u++)
+        s_d3d.cur_samp[u] = (u == 0) ? SAMP_POINT_CLAMP : SAMP_LINEAR_WRAP;
+}
+
+/* Heap index of the sampler for one guest texture unit's registers. Distinct
+ * states are created once and kept (titles use a few dozen); when the heap is
+ * full, new states fall back to linear/wrap. */
+static u16 samp_get(const rsx_texture_state* tex)
+{
+    if (!s_d3d.samp_heap) return SAMP_LINEAR_WRAP;
+    if (tex->filter == 0) return SAMP_LINEAR_WRAP;   /* filter never written */
+    u32 k[4];
+    k[0] = tex->filter & 0x07071FFFu;                /* bias, min, mag */
+    k[1] = tex->address & 0x000F0F0Fu;               /* wrap s/t/r */
+    k[2] = tex->control0 & 0x7FFFFFF0u;              /* LOD range, max aniso */
+    {
+        const u32 ws = k[1] & 0xF, wt = (k[1] >> 8) & 0xF, wr = (k[1] >> 16) & 0xF;
+        k[3] = (ws == 4 || wt == 4 || wr == 4) ? tex->border_color : 0u;
+    }
+    u32 h = 2166136261u;
+    for (int i = 0; i < 4; i++) { h ^= k[i]; h *= 16777619u; h ^= h >> 15; }
+    for (u32 probe = 0; probe < SAMP_HASH_SIZE; probe++) {
+        u32 slot = (h + probe) & (SAMP_HASH_SIZE - 1u);
+        if (!s_d3d.samp_hash[slot].used) {
+            if (s_d3d.samp_n >= SAMP_HEAP_SIZE) {
+                static int warned = 0;
+                if (!warned++) printf("[D3D12] sampler heap full (%u states)\n", s_d3d.samp_n);
+                return SAMP_LINEAR_WRAP;
+            }
+            D3D12_SAMPLER_DESC d;
+            rsx_sampler_desc(k[0], k[1], k[2], k[3], &d);
+            u16 idx = (u16)s_d3d.samp_n++;
+            samp_write(idx, &d);
+            memcpy(s_d3d.samp_hash[slot].k, k, sizeof k);
+            s_d3d.samp_hash[slot].idx = idx;
+            s_d3d.samp_hash[slot].used = 1;
+            { static int n = 0; if (n++ < 16)
+                printf("[D3D12] sampler %u: filter=0x%08X address=0x%08X ctrl0=0x%08X"
+                       " -> D3D filter 0x%X wrap %u/%u/%u aniso %u bias %.3f lod %.2f..%.2f\n",
+                       idx, k[0], k[1], k[2], (unsigned)d.Filter, (unsigned)d.AddressU,
+                       (unsigned)d.AddressV, (unsigned)d.AddressW, d.MaxAnisotropy,
+                       d.MipLODBias, d.MinLOD, d.MaxLOD); }
+            return idx;
+        }
+        if (!memcmp(s_d3d.samp_hash[slot].k, k, sizeof k)) return s_d3d.samp_hash[slot].idx;
+    }
+    return SAMP_LINEAR_WRAP;
+}
+
+/* Bind root params 3..18 (s0-s15) to the given sampler-heap indices, skipping
+ * tables that already point there. last[] caches what is bound (0xFFFF = unknown). */
+static void samp_bind(const u16* idx, u16* last)
+{
+    if (!s_d3d.samp_heap) return;
+    D3D12_GPU_DESCRIPTOR_HANDLE base;
+    s_d3d.samp_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_d3d.samp_heap, &base);
+    for (int u = 0; u < RSX_D3D_TEX_UNITS; u++) {
+        if (last[u] == idx[u]) continue;
+        D3D12_GPU_DESCRIPTOR_HANDLE g = base;
+        g.ptr += (u64)idx[u] * s_d3d.samp_inc;
+        s_d3d.cmd_list->lpVtbl->SetGraphicsRootDescriptorTable(s_d3d.cmd_list, (UINT)(3 + u), g);
+        last[u] = idx[u];
+    }
+}
