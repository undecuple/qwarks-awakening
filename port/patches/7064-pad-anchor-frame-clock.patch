diff --git a/libs/input/pad_script_anchor.h b/libs/input/pad_script_anchor.h
index ac568d5..1c1b6c1 100644
--- a/libs/input/pad_script_anchor.h
+++ b/libs/input/pad_script_anchor.h
@@ -15,6 +15,11 @@
  *
  * The anchor is noted from the filesystem thread (pad_anchor_note: a flag) and resolved on the pad thread at its next
  * poll (pad_anchor_poll), so the anchored times are on the pad clock (wall seconds or PAD_CLOCK=flips) like the rest.
+ *
+ * R&C patch 7064: an optional frame clock for the anchored part (pad_anchor_frame_clock; cellPad.c turns it on from
+ * PAD_ANCHOR_CLOCK=flips[:N]). Anchored events then count guest flips since the anchor, N flips (default 60) = 1 s of
+ * script time, so an input lands at the same game frame after the level's control start whatever the fps; holds of
+ * anchored events ("for D s") count flips the same way. Unanchored events stay on the pad clock. Off (all zero) = 7062.
  * Pure C (host test port/rc/tests/run_pad_anchor_test.sh). */
 #ifndef PAD_SCRIPT_ANCHOR_H
 #define PAD_SCRIPT_ANCHOR_H
@@ -28,6 +33,10 @@ typedef struct {
     volatile int hit;            /* the filesystem saw a matching open (set once, from any thread) */
     int resolved;                /* the pad thread saw the hit ... */
     double at;                   /* ... at this pad-clock second */
+    int fclock;                  /* R&C patch 7064: anchored events on the frame clock ... */
+    double per_s;                /* ... this many flips = 1 s of script time */
+    double fnow;                 /* the flip count, set by the pad thread before each poll (pad_anchor_frames) */
+    double at_f;                 /* the flip count when the anchor resolved */
 } pad_anchor;                    /* all zero = no anchor (a static PadScript needs no init) */
 
 /* p at '@': parse "@fs:TEXT" (TEXT runs to a separator: space, tab, CR, LF, ',' or '#'). Returns the end of the
@@ -56,15 +65,35 @@ static inline int pad_anchor_note(pad_anchor* a, const char* path)
 static inline int pad_anchor_poll(pad_anchor* a, double now)
 {
     if (!a->set || !a->hit || a->resolved) return 0;
-    a->at = now; a->resolved = 1;
+    a->at = now; a->at_f = a->fnow; a->resolved = 1;
     return 1;
 }
 
+/* R&C patch 7064: the frame clock. flips_per_s <= 0 leaves it off. */
+static inline void pad_anchor_frame_clock(pad_anchor* a, double flips_per_s)
+{
+    a->fclock = flips_per_s > 0; a->per_s = flips_per_s > 0 ? flips_per_s : 0;
+}
+
+/* Pad thread, before each poll: the current guest flip count (only read when the frame clock is on). */
+static inline void pad_anchor_frames(pad_anchor* a, double flips) { a->fnow = flips; }
+
+/* The clock an event runs on, in script seconds: an unanchored event, the pad clock (now); an anchored one, seconds
+ * since the anchor resolved: flips since then / per_s on the frame clock, else now - at. Only meaningful for an
+ * anchored event once the anchor resolved. Holds compare two readings of the same event's clock. */
+static inline double pad_anchor_clock(const pad_anchor* a, int anchored, double now)
+{
+    if (!anchored) return now;
+    if (a->fclock) return (a->fnow - a->at_f) / a->per_s;
+    return now - a->at;
+}
+
 /* 1 when an event of time t is due at pad-clock second now: now >= t for an unanchored event; for an anchored one,
- * the anchor resolved and now >= anchor + t (never before the anchor fired). */
+ * the anchor resolved and its clock (pad_anchor_clock: now - anchor, or flips since the anchor / per_s) >= t (never
+ * before the anchor fired). */
 static inline int pad_anchor_due(const pad_anchor* a, int anchored, double t, double now)
 {
     if (!anchored) return now >= t;
-    return a->resolved && now >= a->at + t;
+    return a->resolved && pad_anchor_clock(a, 1, now) >= t;
 }
 #endif
