  * System cache
  * -----------------------------------------------------------------------*/
 
+/* RC patch 7110: the host side of the one system cache. PS3_HDD1_ROOT/cache holds
+ * at most one cache directory, the one last mounted. A mount with that same
+ * non-empty id gets it back with its files (CELL_SYSCACHE_RET_OK_RELAYED); any
+ * other mount (another id, an empty id, no cache yet, or a cache whose session
+ * did not end) empties PS3_HDD1_ROOT/cache, creates the new directory and
+ * answers CELL_SYSCACHE_RET_OK_CLEARED. The old code answered CLEARED and kept
+ * every file, so a title trusted a "fresh" cache that held whatever an earlier
+ * run (often one killed mid-write) had left in it.
+ *
+ * "Session did not end": while a cache is mounted, the file PS3_HDD1_ROOT +
+ * ".syscache-open" (next to the root, so the guest never sees it) names it; a
+ * normal end of the process (exit or a return from main; the host quit path
+ * ends with exit(0)) removes it. A run that was killed leaves it, and the next
+ * mount clears the cache instead of relaying half-written files. RPCS3 marks a
+ * mounted cache incomplete the same way and reuses only an unmarked one, keeps
+ * the cache when the id is the same and non-empty, clears it otherwise
+ * (cellSysCache.cpp, syscache_info / cellSysCacheMount; read for behaviour,
+ * nothing copied) [src:rpcs3-cellsyscache].
+ * ASSUMPTION: the console keeps the cache across boots of the same title (what
+ * RELAYED and the XMB's "delete system cache" boot option are for); RPCS3 itself
+ * deletes it at a normal stop unless it saves state. */
+static char s_cache_state[1100];   /* host path of the ".syscache-open" file */
+static int  s_cache_state_atexit;
+
+static void syscache_state_end(void)
+{
+    if (s_cache_state[0]) remove(s_cache_state);
+}
+
+/* Delete everything inside host directory `dir`; the directory itself stays.
+ * Returns the number of entries that could not be removed. */
+static int syscache_empty_dir(const char* dir)
+{
+    int failed = 0;
+    DIR* d = opendir(dir);
+    if (!d) return 0;
+    struct dirent* e;
+    while ((e = readdir(d)) != NULL) {
+        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+        char path[1100];
+        snprintf(path, sizeof path, "%s/%s", dir, e->d_name);
+        struct stat st;
+        if (stat(path, &st) != 0) { failed++; continue; }
+        if (S_ISDIR(st.st_mode)) {
+            failed += syscache_empty_dir(path);
+            if (rmdir(path) != 0) failed++;
+        } else if (remove(path) != 0) {
+            failed++;
+        }
+    }
+    closedir(d);
+    return failed;
+}
+
+static int syscache_is_dir(const char* path)
+{
+    struct stat st;
+    return stat(path, &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+/* A cache id is A-Z, 0-9, '-' and '_', not starting with '_' (the sysutil
+ * name-string rule; RPCS3 sysutil_check_name_string, read for behaviour). It is
+ * also a host directory name here, so this keeps '/', '.' and '\\' out of it. */
+static int syscache_id_valid(const char* id)
+{
+    if (id[0] == '_') return 0;
+    for (const char* c = id; *c; ++c)
+        if (!((*c >= 'A' && *c <= 'Z') || (*c >= '0' && *c <= '9') || *c == '-' || *c == '_'))
+            return 0;
+    return 1;
+}
+
 s32 cellSysCacheMount(char* param)
 {
     /* The argument is a GUEST EA of CellSysCacheParam:
@@ -584,6 +665,8 @@
     memcpy(cache_id, vm_base + ea, 32);
