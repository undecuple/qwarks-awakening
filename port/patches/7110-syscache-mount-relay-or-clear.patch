--- /dev/null
+++ b/libs/system/tests/test_syscache_mount.c
@@ -0,0 +1,173 @@
+/* cc -std=gnu17 -I include libs/system/tests/test_syscache_mount.c libs/system/cellSysutil.c
+ *    -pthread -Wl,--gc-sections -o /tmp/test_syscache_mount && /tmp/test_syscache_mount
+ * (tools/test_syscache_mount.py runs it on Linux and macOS.)
+ *
+ * RC patch 7110: cellSysCacheMount keeps the one system cache only for a mount
+ * with the same non-empty id after a session that ended (CELL_SYSCACHE_RET_OK_RELAYED)
+ * and otherwise empties PS3_HDD1_ROOT/cache before it answers
+ * CELL_SYSCACHE_RET_OK_CLEARED. Each "session" is a child process: a normal
+ * exit ends the session, _exit stands for a run that was killed. */
+#include "../cellSysutil.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef CELL_SYSCACHE_RET_OK_CLEARED
+#define CELL_SYSCACHE_RET_OK_CLEARED 0
+#endif
+#ifndef CELL_SYSCACHE_RET_OK_RELAYED
+#define CELL_SYSCACHE_RET_OK_RELAYED 1
+#endif
+#ifndef CELL_SYSCACHE_ERROR_PARAM
+#define CELL_SYSCACHE_ERROR_PARAM 0x8002bc03
+#endif
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+void np_psnr_pump(void) {}
+void cellMsgDialog_tick(void) {}
+void ps3_np_eula_tick(void) {}
+int ps3_savedata_busy(void) { return 0; }
+
+static char s_root[512];
+static const uint32_t PARAM_EA = 0x1000;   /* CellSysCacheParam in the fake guest memory */
+
+static s32 mount(const char* id)
+{
+    memset(vm_base + PARAM_EA, 0, 0x20 + 1055);
+    strncpy((char*)vm_base + PARAM_EA, id, 32);
+    return cellSysCacheMount((char*)(uintptr_t)PARAM_EA);
+}
+
+static void put_file(const char* rel)
+{
+    char p[700];
+    snprintf(p, sizeof p, "%s/%s", s_root, rel);
+    FILE* f = fopen(p, "wb");
+    if (!f) { printf("[FAIL] cannot write %s\n", p); _exit(2); }
+    fputs("data", f);
+    fclose(f);
+}
+
+static int exists(const char* rel)
+{
+    char p[700];
+    struct stat st;
+    snprintf(p, sizeof p, "%s/%s", s_root, rel);
+    return stat(p, &st) == 0;
+}
+
+static int s_fail;
+static void check(int ok, const char* what)
+{
+    printf("[%s] %s\n", ok ? "PASS" : "FAIL", what);
+    fflush(stdout);
+    if (!ok) s_fail++;
+}
+
+/* Run one session in a child; killed = end it with _exit (no atexit). */
+static void session(void (*body)(void), int killed)
+{
+    fflush(stdout);
+    pid_t pid = fork();
+    if (pid == 0) {
+        s_fail = 0;
+        body();
+        fflush(stdout);
+        if (killed) _exit(s_fail ? 1 : 0);
+        exit(s_fail ? 1 : 0);
+    }
+    int status = 0;
+    waitpid(pid, &status, 0);
+    if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) s_fail++;
+}
+
+static void s1_first_mount(void)
+{
+    check(mount("BCUS98127") == CELL_SYSCACHE_RET_OK_CLEARED, "first mount of BCUS98127: OK_CLEARED");
+    check(!strcmp((char*)vm_base + PARAM_EA + 0x20, "/dev_hdd1/cache/BCUS98127"),
+          "getCachePath = /dev_hdd1/cache/BCUS98127");
+    check(exists("cache/BCUS98127"), "host cache dir created");
+    put_file("cache/BCUS98127/cache.idx");
+    check(mount("BCUS98127") == CELL_SYSCACHE_RET_OK_RELAYED, "same id again in the same session: OK_RELAYED");
+    check(exists("cache/BCUS98127/cache.idx"), "...and its file is kept");
+}
+
+static void s2_same_id_next_session(void)
+{
+    check(mount("BCUS98127") == CELL_SYSCACHE_RET_OK_RELAYED,
+          "same id after a session that ended: OK_RELAYED");
+    check(exists("cache/BCUS98127/cache.idx"), "...and its file is kept");
+}
+
+static void s3_other_id(void)
+{
+    check(mount("OTHER-ID") == CELL_SYSCACHE_RET_OK_CLEARED, "another id: OK_CLEARED");
+    check(!exists("cache/BCUS98127"), "...the previous cache is gone");
+    check(exists("cache/OTHER-ID"), "...the new cache dir exists");
+    put_file("cache/OTHER-ID/f");
+    check(mount("BCUS98127") == CELL_SYSCACHE_RET_OK_CLEARED, "back to BCUS98127: OK_CLEARED");
+    check(!exists("cache/OTHER-ID") && exists("cache/BCUS98127") && !exists("cache/BCUS98127/cache.idx"),
+          "...OTHER-ID gone, BCUS98127 empty");
+    put_file("cache/BCUS98127/cache.idx");
+}
+
+static void s4_killed(void)
+{
+    check(mount("BCUS98127") == CELL_SYSCACHE_RET_OK_RELAYED, "same id after s3 ended: OK_RELAYED");
+    put_file("cache/BCUS98127/half-written");
+    /* killed: no normal end */
+}
+
+static void s5_after_kill(void)
+{
+    check(mount("BCUS98127") == CELL_SYSCACHE_RET_OK_CLEARED,
+          "same id after a killed session: OK_CLEARED");
+    check(exists("cache/BCUS98127") && !exists("cache/BCUS98127/half-written")
+          && !exists("cache/BCUS98127/cache.idx"), "...and the cache is empty");
+    put_file("cache/BCUS98127/cache.idx");
+}
+
+static void s6_empty_and_bad_ids(void)
+{
+    check(mount("") == CELL_SYSCACHE_RET_OK_CLEARED, "empty id: OK_CLEARED");
+    check(!exists("cache/BCUS98127"), "...the previous cache is gone");
+    check(mount("") == CELL_SYSCACHE_RET_OK_CLEARED, "empty id again: still OK_CLEARED (never relayed)");
+    check((uint32_t)mount("../x") == CELL_SYSCACHE_ERROR_PARAM, "id '../x': CELL_SYSCACHE_ERROR_PARAM");
+    check((uint32_t)mount("_LEAD") == CELL_SYSCACHE_ERROR_PARAM, "id '_LEAD': CELL_SYSCACHE_ERROR_PARAM");
+    check(!exists("x"), "...nothing created outside the cache");
+}
+
+static void s7_no_root(void)
+{
+    unsetenv("PS3_HDD1_ROOT");
+    check(mount("BCUS98127") == CELL_SYSCACHE_RET_OK_CLEARED, "no PS3_HDD1_ROOT: OK_CLEARED");
+}
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    vm_base = (uint8_t*)calloc(1, 0x4000);
+    const char* tmp = getenv("TMPDIR");
+    snprintf(s_root, sizeof s_root, "%s/syscache-XXXXXX", tmp && *tmp ? tmp : "/tmp");
+    if (!mkdtemp(s_root)) { puts("[FAIL] mkdtemp"); return 1; }
+    setenv("PS3_HDD1_ROOT", s_root, 1);
+
+    session(s1_first_mount, 0);
+    session(s2_same_id_next_session, 0);
+    session(s3_other_id, 0);
+    session(s4_killed, 1);
+    session(s5_after_kill, 0);
+    session(s6_empty_and_bad_ids, 0);
+    session(s7_no_root, 0);
+
+    char cmd[1200];
+    snprintf(cmd, sizeof cmd, "rm -rf '%s' '%s.syscache-open'", s_root, s_root);
+    if (system(cmd) != 0) puts("(could not remove the temp dir)");
+    printf("%s: cellSysCacheMount relay/clear rule\n", s_fail ? "FAIL" : "PASS");
+    return s_fail ? 1 : 0;
+}
diff --git a/tools/test_syscache_mount.py b/tools/test_syscache_mount.py
