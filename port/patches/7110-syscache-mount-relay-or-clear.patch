+    if (!syscache_id_valid(cache_id))
+        return (s32)CELL_SYSCACHE_ERROR_PARAM;
 
     snprintf(s_cache_path, CELL_SYSCACHE_PATH_MAX, "/dev_hdd1/cache/%s", cache_id);
     size_t n = strlen(s_cache_path);
@@ -594,23 +677,50 @@
 
     /* The guest path above is only half the mount: /dev_hdd1 must also exist as
      * a WRITABLE host directory, or a title's first cache open fails against the
-     * read-only disc root and it never creates its media threads. Create the
-     * cache directory under the same host root ppu_fs.cpp maps /dev_hdd1 to
-     * (PS3_HDD1_ROOT); without that root /dev_hdd1 is not remapped, so there is
-     * nothing to prepare. */
-    { const char* root = getenv("PS3_HDD1_ROOT");
-      if (root && *root) {
-          char hpath[512];
-          snprintf(hpath, sizeof hpath, "%s/cache", root);
-          mkdir(hpath, 0777);
-          snprintf(hpath, sizeof hpath, "%s/cache/%s", root, cache_id);
-          if (mkdir(hpath, 0777) == 0 || errno == EEXIST)
-              printf("[cellSysutil] SysCacheMount: host cache dir %s ready\n", hpath);
-          else
-              printf("[cellSysutil] SysCacheMount: host cache dir %s NOT created (errno=%d)\n",
-                     hpath, errno); } }
-
-    return CELL_OK;   /* CELL_SYSCACHE_RET_OK_CLEARED */
+     * read-only disc root and it never creates its media threads. The cache
+     * lives under the host root ppu_fs.cpp maps /dev_hdd1 to (PS3_HDD1_ROOT);
+     * without that root /dev_hdd1 is not remapped, nothing is kept, and every
+     * mount is a cleared one. */
+    const char* root = getenv("PS3_HDD1_ROOT");
+    if (!root || !*root)
+        return CELL_SYSCACHE_RET_OK_CLEARED;
+
+    char cdir[1100], hpath[1100], state[1100];
+    snprintf(cdir, sizeof cdir, "%s/cache", root);
+    snprintf(hpath, sizeof hpath, "%s/cache/%s", root, cache_id);
+    snprintf(state, sizeof state, "%s.syscache-open", root);
+    mkdir(cdir, 0777);
+
+    /* A state file left by an earlier process: that session never ended. The
+     * one this process wrote (s_cache_state) only marks the current mount. */
+    int unfinished = 0;
+    if (strcmp(s_cache_state, state) != 0) {
+        FILE* f = fopen(state, "rb");
+        if (f) { unfinished = 1; fclose(f); }
+    }
+
+    s32 ret;
+    if (cache_id[0] && !unfinished && syscache_is_dir(hpath)) {
+        printf("[cellSysutil] SysCacheMount: host cache dir %s kept -> OK_RELAYED\n", hpath);
+        ret = CELL_SYSCACHE_RET_OK_RELAYED;
+    } else {
+        int failed = syscache_empty_dir(cdir);
+        if (cache_id[0]) mkdir(hpath, 0777);
+        if (syscache_is_dir(hpath))
+            printf("[cellSysutil] SysCacheMount: host cache dir %s cleared%s, %d entr%s not removed"
+                   " -> OK_CLEARED\n", hpath, unfinished ? " (the last session did not end)" : "",
+                   failed, failed == 1 ? "y" : "ies");
+        else
+            printf("[cellSysutil] SysCacheMount: host cache dir %s NOT created (errno=%d)\n",
+                   hpath, errno);
+        ret = CELL_SYSCACHE_RET_OK_CLEARED;
+    }
+
+    FILE* f = fopen(state, "wb");
+    if (f) { fputs(cache_id, f); fclose(f); }
+    snprintf(s_cache_state, sizeof s_cache_state, "%s", state);
+    if (!s_cache_state_atexit) { s_cache_state_atexit = 1; atexit(syscache_state_end); }
+    return ret;
 }
 
