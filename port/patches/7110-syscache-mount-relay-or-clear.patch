--- /dev/null
+++ b/tools/test_syscache_mount.py
@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+"""cellSysCacheMount (cellSysutil.c, RC patch 7110): OK_RELAYED keeps the cache
+for the same id after a session that ended; anything else empties it and
+answers OK_CLEARED. Host only, no game or GPU."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+
+if sys.platform == "win32":
+    print("SKIP: syscache fixture requires a POSIX C toolchain (fork)")
+    raise SystemExit(0)
+
+root = Path(__file__).resolve().parents[1]
+gc_flag = "-Wl,-dead_strip" if sys.platform == "darwin" else "-Wl,--gc-sections"
+with tempfile.TemporaryDirectory(prefix="syscache-") as temporary:
+    binary = Path(temporary) / "test_syscache_mount"
+    subprocess.run([
+        os.environ.get("CC", "cc"), "-std=gnu17", "-O1", "-UNDEBUG",
+        "-ffunction-sections", "-fdata-sections", "-I" + str(root / "include"),
+        str(root / "libs/system/tests/test_syscache_mount.c"),
+        str(root / "libs/system/cellSysutil.c"),
+        "-pthread", gc_flag, "-o", str(binary),
+    ], check=True, timeout=60, cwd=temporary)
+    env = dict(os.environ, TMPDIR=temporary)
+    env.pop("PS3_HDD1_ROOT", None)
+    result = subprocess.run([str(binary)], timeout=30, env=env, cwd=temporary,
+                            capture_output=True, text=True)
+    print(result.stdout.strip())
+    if result.returncode != 0 or "PASS: cellSysCacheMount" not in result.stdout:
+        raise SystemExit("test_syscache_mount failed (exit %d)" % result.returncode)
