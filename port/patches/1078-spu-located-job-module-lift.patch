 }
 
+/* KZ3 patch 1078: job modules lifted a second time at the LS base another job loads them to. KZ3's Amadeus mixer
+ * job (job_0127a180, run by the WWS policy module at LS 0x4000) loads a DSP plugin module (job_0129bd80, header
+ * base 0) at LS 0x8000 and calls into it through pointers. The plugin's own lift is at 0x4000 (the base a WWS
+ * job-list entry would give it), so every call into it missed and ran in the interpreter (patch 1069): ~10 ms of
+ * interpretation per mixer run, about one SPU of five in a level. The title registers the module's bytes (the
+ * lift's input; its first 16 bytes are the header), the LS address it is loaded at, its size and the image id of
+ * the lift at that address. A dispatch miss inside [lsa, lsa + span) dispatches the lifted function (exact image,
+ * no wildcard) only while LS still holds the module's header at lsa (the identification the WWS job-module match
+ * uses, spu_overlay_match_sig) AND the module's instruction word at pc: an SPU's LS outlives the job that loaded
+ * the module, so a later program could keep the header but hold other code at pc. KZ3_SPU_LOC=0 disables the
+ * lookup (the interpreter path again). */
+/* kz3-loc begin (tools/spu/test_spu_located.sh compiles this block) */
+#define SPU_LOC_MAX 8
+static struct { const uint8_t* code; uint32_t lsa, span; int image_id; unsigned hits; } s_loc[SPU_LOC_MAX];
+static int s_loc_n;
+void spu_overlay_register_located(const uint8_t* code, uint32_t lsa, uint32_t span, int image_id)
+{
+    if (s_loc_n >= SPU_LOC_MAX || !code || span < 16 || lsa >= SPU_LS_SIZE || span > SPU_LS_SIZE - lsa) return;
+    s_loc[s_loc_n].code = code;
+    s_loc[s_loc_n].lsa = lsa;
+    s_loc[s_loc_n].span = span;
+    s_loc[s_loc_n].image_id = image_id;
+    s_loc_n++;
+}
+int kz3_spu_loc_on(void)
+{
+    static int s = -1;
+    if (s < 0) { const char* e = getenv("KZ3_SPU_LOC"); s = (e && *e == '0') ? 0 : 1; }
+    return s;
+}
+spu_fn spu_lookup_located(const spu_context* ctx, uint32_t pc)
+{
+    if (!s_loc_n || !kz3_spu_loc_on()) return NULL;
+    pc &= SPU_LS_MASK;
+    for (int i = 0; i < s_loc_n; i++) {
+        const uint32_t off = pc - s_loc[i].lsa;
+        if (off >= s_loc[i].span || (pc & 3) || off + 4 > s_loc[i].span) continue;
+        if (memcmp(ctx->ls + s_loc[i].lsa, s_loc[i].code, 16) != 0) continue;
+        if (memcmp(ctx->ls + pc, s_loc[i].code + off, 4) != 0) continue;
+        spu_fn f = spu_lookup_ovl_exact(pc, s_loc[i].image_id);
+        if (f && s_loc[i].hits++ == 0)   /* racy count across lanes: only the first-hit log uses it */
+            fprintf(stderr, "[spu-loc] image %d at LS 0x%05X: first lifted dispatch pc=0x%05X (patch 1078)\n",
+                    s_loc[i].image_id, s_loc[i].lsa, pc);
+        if (f) return f;
+    }
+    return NULL;
+}
+/* kz3-loc end */
+
 /* Which image registered a function at this LS address, or -1 if none did.
  *
  * Deliberately NOT spu_lookup(addr, 0): that call means "dispatch here in a
