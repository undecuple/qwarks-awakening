cellSysutilAvc2: voice chat with no voice device and no peers (Full Frontal Assault 1.05, All 4 One 1.03).

NIDs: InitParam 0x89456724, StartStreaming 0x74D22119, StopStreaming 0x04E1E1E4, SetPlayerVoiceMuting 0x31FC8B92,
GetPlayerVoiceMuting 0x5F3811F8, SetAttribute 0xCCF0AEFF, GetPlayerInfo 0x02C5417A (FFA), SetStreamingTarget 0x3447668A (FFA),
Unload 0x38F33624. The library already accepted Load/Join/Leave silently; it now has the state those calls imply (loaded,
in a chat, streaming) and answers each call from it, instead of OK with nothing behind it:
  * InitParam(version, param*): NULL param is INVALID_ARGUMENT; else the version field (first u16) is written.
  * StartStreaming / StopStreaming / SetStreamingTarget: NOT_INITIALIZED before Load, NOT_ACTIVE outside a joined chat, else
    OK (there is nobody to stream to; the state is tracked, no audio moves).
  * Set/GetPlayerVoiceMuting, GetPlayerInfo: the room has no remote players and no local voice device, so every player id
    is unknown: INVALID_ARGUMENT, outputs untouched (NOT_ACTIVE outside a chat, NOT_INITIALIZED before Load).
  * SetAttribute: NULL is INVALID_ARGUMENT, NOT_INITIALIZED before Load, else OK (no device to apply it to).
  * Unload (the synchronous one): NOT_INITIALIZED if not loaded, else unloads without an event.
ASSUMPTION: the error values (0x8002B703 NOT_INITIALIZED, 0x8002B705 INVALID_ARGUMENT, 0x8002B708 NOT_ACTIVE: SDK header from
memory, RPCS3 used as reference only) and the InitParam layout beyond the version field (nothing else is written).

--- a/libs/network/cellSysutilAvc2.c
+++ b/libs/network/cellSysutilAvc2.c
@@ -39,9 +39,15 @@

 /* (version, CellSysutilAvc2InitParam* option): the title's defaults stand. */
-s32 cellSysutilAvc2InitParam(u16 version, u32 option)
-{
-    (void)version; (void)option;
-    return CELL_OK;
-}
+#define AVC2_ERR_NOT_INITIALIZED ((s32)0x8002B703)
+#define AVC2_ERR_INVALID_ARGUMENT ((s32)0x8002B705)
+#define AVC2_ERR_NOT_ACTIVE ((s32)0x8002B708)
+static int s_avc2_loaded, s_avc2_joined, s_avc2_streaming;
+
+s32 cellSysutilAvc2InitParam(u16 version, u32 option)
+{
+    if (!option) return AVC2_ERR_INVALID_ARGUMENT;
+    vm_write16(option, version);
+    return CELL_OK;
+}

 /* (ctxId, container, callback, userdata, initParam) */
@@ -50,4 +56,5 @@
     s_cb = callback;
     s_userdata = userdata;
+    s_avc2_loaded = 1;
     printf("[cellSysutilAvc2] LoadAsync: voice chat up, silent\n");
     avc2_event(AVC2_EVENT_LOAD_SUCCEEDED);
@@ -64,4 +71,5 @@
 s32 cellSysutilAvc2JoinChatRequest(u32 roomId)
 {
     (void)roomId;
+    s_avc2_joined = 1;
     avc2_event(AVC2_EVENT_JOIN_SUCCEEDED);
@@ -71,3 +79,4 @@
 s32 cellSysutilAvc2LeaveChatRequest(void)
 {
+    s_avc2_joined = s_avc2_streaming = 0;
     avc2_event(AVC2_EVENT_LEAVE_SUCCEEDED);
@@ -76,5 +85,66 @@

-s32 cellSysutilAvc2StartStreaming(void) { return CELL_OK; }
-s32 cellSysutilAvc2StopStreaming(void)  { return CELL_OK; }
+/* The state check shared by everything that needs a joined chat. */
+static s32 avc2_need_chat(void)
+{
+    if (!s_avc2_loaded) return AVC2_ERR_NOT_INITIALIZED;
+    return s_avc2_joined ? CELL_OK : AVC2_ERR_NOT_ACTIVE;
+}
+
+s32 cellSysutilAvc2StartStreaming(void)
+{
+    s32 r = avc2_need_chat();
+    if (r == CELL_OK) s_avc2_streaming = 1;
+    return r;
+}
+
+s32 cellSysutilAvc2StopStreaming(void)
+{
+    s32 r = avc2_need_chat();
+    if (r == CELL_OK) s_avc2_streaming = 0;
+    return r;
+}
+
+/* (const CellSysutilAvc2StreamingTarget* target) */
+s32 cellSysutilAvc2SetStreamingTarget(u32 target)
+{
+    s32 r = avc2_need_chat();
+    return r == CELL_OK && !target ? AVC2_ERR_INVALID_ARGUMENT : r;
+}
+
+/* (u16 playerId, u8 muting) / (u16 playerId, u8* muting) / (u16 playerId, CellSysutilAvc2PlayerInfo* info): no players. */
+s32 cellSysutilAvc2SetPlayerVoiceMuting(u16 playerId, u8 muting)
+{
+    (void)playerId; (void)muting;
+    s32 r = avc2_need_chat();
+    return r == CELL_OK ? AVC2_ERR_INVALID_ARGUMENT : r;
+}
+
+s32 cellSysutilAvc2GetPlayerVoiceMuting(u16 playerId, u32 muting)
+{
+    (void)playerId; (void)muting;
+    s32 r = avc2_need_chat();
+    return r == CELL_OK ? AVC2_ERR_INVALID_ARGUMENT : r;
+}
+
+s32 cellSysutilAvc2GetPlayerInfo(u16 playerId, u32 info)
+{
+    (void)playerId; (void)info;
+    s32 r = avc2_need_chat();
+    return r == CELL_OK ? AVC2_ERR_INVALID_ARGUMENT : r;
+}
+
+/* (CellSysutilAvc2Attribute* attr) */
+s32 cellSysutilAvc2SetAttribute(u32 attr)
+{
+    if (!s_avc2_loaded) return AVC2_ERR_NOT_INITIALIZED;
+    return attr ? CELL_OK : AVC2_ERR_INVALID_ARGUMENT;
+}
+
+s32 cellSysutilAvc2Unload(void)
+{
+    if (!s_avc2_loaded) return AVC2_ERR_NOT_INITIALIZED;
+    s_avc2_loaded = s_avc2_joined = s_avc2_streaming = 0;
+    return CELL_OK;
+}

 s32 cellSysutilAvc2EnableVoiceDetection(u8 enable, u8 level) { (void)enable; (void)level; return CELL_OK; }
