+/* R&C patch 7120: the return address an interpreter handoff stops at is the innermost OPEN call bracket's (hop_ret_pc).
+ * A lifted brsl/bisl publishes hop_ret_pc before it invokes its callee, spu_drain_call_full keeps it while the callee
+ * drains, and the bracket restores the outer one when it closes; drain_ret_pc is only set by a drain step, so for an
+ * immediate `bisl` into unlifted code (the generated bracket calls spu_indirect_branch before spu_drain_call) it still
+ * names the OUTER bracket, or 0 after the inline fast drain. Without this stop an interpreted callee's return to its
+ * caller ran on through the caller's continuation (interpreted, inside the callee's host frame) to the next lifted
+ * entry, whose code the bracket's drain then ran as callee work: one host frame leaked per call, until the depth guard
+ * halted the SPU (ToD PhysColl: `bisl $0,$91` at LS 0xA3FC calls a plugin at 0x1B360, link 0xA400; the ring showed
+ * N:1B360/d J:0A410/d with d one higher per loop pass). RC_SPU_OWNED_STOP=0 restores the old stops (A/B only). */
+static int rc_spu_owned_stop_on(void)
+{
+    static int s = -1;
+    if (s < 0) { const char* e = getenv("RC_SPU_OWNED_STOP"); s = (e && *e == '0') ? 0 : 1; }
+    return s;
+}
+/* R&C patch 7120: one log line per stop the old rule would have missed (first 8): the run shows the fix engaging. The old
+ * rule also stopped at old_stop and at every address the interpreter rejoins (a lifted or overlay entry: a bracket's
+ * return address can be one), so those are not logged. */
+static void rc_spu_owned_stop_note(const spu_context* ctx, uint32_t from, uint32_t old_stop)
+{
+    extern int rc_spu_interp_rejoins_at(const spu_context*, uint32_t);   /* spu_interp.c */
+    static int _n = 0;
+    const uint32_t pc = (uint32_t)ctx->pc & SPU_LS_MASK;
+    if (pc == ctx->hop_ret_pc && pc != old_stop && !rc_spu_interp_rejoins_at(ctx, pc) && PS3_LOG_FIRST(_n, 8))
+        fprintf(stderr, "[spu] owned-stop (R&C 7120): interpreted callee from 0x%05X returned to its open bracket's "
+                "0x%05X img=%d depth=%u ovl=%d (old stop 0x%05X)\n", from, pc, ctx->image_id, ctx->host_depth,
+                (int)ctx->resident_ovl, old_stop);
+}
