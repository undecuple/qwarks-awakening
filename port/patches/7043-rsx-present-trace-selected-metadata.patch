diff --git a/libs/video/rsx_target_trace.h b/libs/video/rsx_target_trace.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_target_trace.h
@@ -0,0 +1,81 @@
+#ifndef RSX_TARGET_TRACE_H
+#define RSX_TARGET_TRACE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+/* Diagnostic metadata only. Surface readers describe existing resources and
+ * never select, create, transition, fence or present one. */
+typedef struct {
+    uint32_t location, offset, pitch, width, height, dxgi_format;
+} rsx_tt_surface;
+
+typedef struct {
+    uint32_t location, offset, pitch, guest_format;
+    uint32_t clip_x, clip_y, clip_w, clip_h;
+} rsx_tt_current;
+
+typedef struct {
+    uint32_t location, offset, pitch, width, height;
+} rsx_tt_display;
+
+typedef int (*rsx_tt_surface_reader)(void*, uint32_t, rsx_tt_surface*);
+typedef int (*rsx_tt_display_reader)(void*, uint32_t, rsx_tt_display*);
+
+typedef struct {
+    const char* event;
+    uint32_t frame, target, arg;
+    int selected_valid, current_valid, is_present, display_valid;
+    rsx_tt_surface selected;
+    rsx_tt_current current;
+    rsx_tt_display display;
+} rsx_tt_record;
+
+static inline int rsx_tt_build(
+    int enabled, const char* event, uint32_t frame, uint32_t target,
+    uint32_t arg, uint32_t surface_count, uint32_t display_count,
+    const rsx_tt_current* current, rsx_tt_surface_reader read_surface,
+    rsx_tt_display_reader read_display, void* state, rsx_tt_record* record)
+{
+    if (!enabled || !record) return 0;
+    memset(record, 0, sizeof(*record));
+    record->event = event ? event : "unknown";
+    record->frame = frame;
+    record->target = target;
+    record->arg = arg;
+    record->is_present = event && strcmp(event, "present") == 0;
+    if (current) {
+        record->current = *current;
+        record->current_valid = 1;
+    }
+    if (target < surface_count && read_surface)
+        record->selected_valid = read_surface(state, target, &record->selected) != 0;
+    if (record->is_present && arg < display_count && read_display)
+        record->display_valid = read_display(state, arg, &record->display) != 0;
+    return 1;
+}
+
+static inline int rsx_tt_print(FILE* stream, const rsx_tt_record* r)
+{
+    return fprintf(stream,
+        "[rsx-target] frame=%u event=%s target=%u arg=0x%X "
+        "selected_valid=%d selected_loc=%u selected_off=0x%08X "
+        "selected_dxgi_fmt=%u selected_pitch=%u selected_size=%ux%u "
+        "current_valid=%d current_loc=%u current_off=0x%08X "
+        "current_guest_fmt=0x%X current_pitch=%u current_clip=%u,%u+%ux%u "
+        "buffer_id_valid=%d buffer_id=%u display_valid=%d display_loc=%u "
+        "display_off=0x%08X display_pitch=%u display_size=%ux%u\n",
+        r->frame, r->event, r->target, r->arg,
+        r->selected_valid, r->selected.location, r->selected.offset,
+        r->selected.dxgi_format, r->selected.pitch,
+        r->selected.width, r->selected.height,
+        r->current_valid, r->current.location, r->current.offset,
+        r->current.guest_format, r->current.pitch,
+        r->current.clip_x, r->current.clip_y, r->current.clip_w, r->current.clip_h,
+        r->is_present, r->is_present ? r->arg : 0u,
+        r->display_valid, r->display.location, r->display.offset,
+        r->display.pitch, r->display.width, r->display.height) >= 0;
+}
+
+#endif
