+        # R&C patch 7106: brsl/brasl addresses whose link register carries a continuation the callee calls back
+        # (compute_callback_brsls, --callback-brsl): lifted as `rN = link; branch`, no host call bracket.
+        self.callback_brsl: set = set()
 
