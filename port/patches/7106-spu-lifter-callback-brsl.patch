+def compute_callback_brsls(insns, bi_r0_jump=frozenset(), max_steps=4096) -> set:
+    """R&C patch 7106: `brsl $rN, T` (N != 0) whose callee never returns through rN but calls it back.
+
+    Sony's SPU compiler passes a CONTINUATION in a non-r0 link register: the ig skinning/packing job does
+    `brsl $r77, packer` and the packer (`bisl $r78, $r77` per batch: the producer loop after the brsl runs and
+    comes back with `bi $r78`) finally leaves with `bi $r0`, i.e. to the brsl's CALLER (Nexus 1.01 job 0x00C21400:
+    0x68A4/0x69B4 -> 0x5E40, `bi $r0` at 0x5E8C; A4O 1.03 0x00D3C580, FFA, ACiT 1.20: the same job, packer 0x6190
+    or 0x6450). On hardware that brsl is a branch that loads rN; nothing returns to brsl+4. Lifted as a host call
+    bracket, the bracket waits for brsl+4, gets the caller's return pc instead, and keeps running the rest of the job
+    inside it (patch 7039 interpreter fallback): host frames per packer call that never close. Nexus
+    prison_transport runs the packer often enough in one job that the SPU halts at host_depth 2000 (pc 0x4D10).
+
+    Classified as a callback brsl (lifted as `rN = link; branch T`, no bracket) only when, from T, every path the
+    callee can take (fallthrough, direct and conditional branches; calls are stepped over as returning) ends in a
+    `bi/biz/... $r0` that is a return (not a compute_bi_r0_jumps jump), rN is never written there and is the target
+    of at least one `bisl`. Anything else -- a `bi $rN` (the ordinary link-register return of
+    compute_link_returns), another indirect branch, iret/stop, a target outside the image or a walk longer than
+    max_steps -- keeps the call bracket. Returns the set of brsl/brasl addresses."""
+    by_addr = {i.addr: i for i in insns}
+    out = set()
+    for insn in insns:
+        if insn.mnemonic not in ("brsl", "brasl"):
+            continue
+        rn = insn.raw & 0x7F
+        if rn == 0:
+            continue
+        tgt = SPULifter._branch_target(insn)
+        if tgt is None or tgt in (insn.addr, insn.addr + 4):
+            continue
+        seen, work = set(), [tgt]
+        r0_return = calls_back = False
+        ok = True
+        while work and ok:
+            a = work.pop()
+            if a in seen:
+                continue
+            seen.add(a)
+            w = by_addr.get(a)
+            if w is None or len(seen) > max_steps:
+                ok = False
+                break
+            mn = w.mnemonic
+            if mn not in _NO_RT_WRITE and _dest_reg(w) == rn:
+                ok = False          # rN recomputed: not the caller's continuation any more
+                break
+            if mn in ("br", "bra") or mn in _COND_BR:
+                t = SPULifter._branch_target(w)
+                if t is None:
+                    ok = False
+                    break
+                work.append(t)
+                if mn in _COND_BR:
+                    work.append(a + 4)
+                continue
+            tr = _bi_target_reg(w)
+            if tr is not None:
+                if tr == "0" and a not in bi_r0_jump:
+                    r0_return = True
+                    if mn != "bi":
+                        work.append(a + 4)   # conditional return: the not-taken path goes on
+                    continue
+                ok = False                   # bi $rN (a real return through the link) or a computed jump
+                break
+            if mn in ("bisl", "bisled"):
+                if _reg(_ops(w.operands)[-1]) == str(rn):
+                    calls_back = True
+                work.append(a + 4)           # the callee comes back (its own bracket)
+                continue
+            if mn in ("iret", "stop", "stopd"):
+                ok = False
+                break
+            work.append(a + 4)               # straight-line code, brsl $r0 calls included
+        if ok and r0_return and calls_back:
+            out.add(insn.addr)
+    return out
+
+
 def compute_link_returns(insns, bounds) -> set:
     """A `bi $rN` / conditional `bi{z,nz,hz,hnz} $rC,$rN` with N != 0 is emitted
     as a generic indirect branch, but Sony's SPU compiler also uses a NON-r0
@@ -593,6 +670,9 @@ class SPULifter:
         # compute_link_returns(). Emitted as `return;` so they compose with the
         # brsl->C-call nesting instead of branching to an unregistered PC.
