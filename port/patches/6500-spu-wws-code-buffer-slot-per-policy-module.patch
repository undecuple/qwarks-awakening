diff --git a/runtime/spu/tests/test_spu_wws_code_slot.c b/runtime/spu/tests/test_spu_wws_code_slot.c
new file mode 100644
index 0000000..87f38f6
--- /dev/null
+++ b/runtime/spu/tests/test_spu_wws_code_slot.c
@@ -0,0 +1,111 @@
+/*
+ * The WWS job code-buffer slot is a property of the policy module (patch 6500).
+ *
+ * spu_indirect_branch identifies the job module resident in a WWS policy module's code buffer by reading the
+ * buffer's LS address from the module's code-buffer slot and matching the 16-byte header there against the
+ * registered job-module signatures (spu_wws_resident_job_image). The LBP and Killzone 3 policy modules keep that
+ * address at LS 0x1320; Ratchet & Clank: Tools of Destruction's keeps it at 0x1330 and stores an unrelated LS
+ * pointer at 0x1320. This test builds both local-store layouts with synthetic module headers (no title bytes) and
+ * checks that:
+ *   - the default slot is 0x1320 (existing ports unchanged),
+ *   - a policy module registered with slot 0x1330 resolves its resident job module, and before the registration
+ *     the same layout resolves nothing (the bug the patch fixes),
+ *   - the slot is per policy-module image id: registering one leaves another on the default,
+ *   - out-of-range image ids are ignored, a slot is masked to a quadword inside LS, and a buffer address past the
+ *     end of LS matches nothing.
+ * Host only: no SPU threads, no DMA, no guest memory. spu_overlay_match_sig is the runtime's in spu_channels.c;
+ * the test supplies a minimal registry with the same contract (16-byte header -> image id, 0 if none).
+ *
+ * Build and run (gcc or clang):
+ *   cc -std=gnu17 -Wall -Wextra -Wno-unused-parameter -Wno-unused-function -I include -I runtime/spu \
+ *      -o /tmp/test_spu_wws_code_slot runtime/spu/tests/test_spu_wws_code_slot.c && /tmp/test_spu_wws_code_slot
+ */
+#include "spu_context.h"
+#include <stdio.h>
+#include <string.h>
+
+/* Minimal signature registry with spu_overlay_match_sig's contract. */
+static struct { uint8_t sig[16]; int img; } s_sig[8];
+static int s_nsig;
+int spu_overlay_match_sig(const uint8_t hdr[16])
+{
+    for (int i = 0; i < s_nsig; i++)
+        if (memcmp(hdr, s_sig[i].sig, 16) == 0) return s_sig[i].img;
+    return 0;
+}
+static void reg_sig(const uint8_t sig[16], int img) { memcpy(s_sig[s_nsig].sig, sig, 16); s_sig[s_nsig++].img = img; }
+
+static int g_fail, g_pass;
+#define CHECK(cond, ...) do { if (cond) g_pass++; else { g_fail++; fprintf(stderr, "FAIL %s:%d: ", __FILE__, __LINE__); \
+                              fprintf(stderr, __VA_ARGS__); fputc('\n', stderr); } } while (0)
+
+static void put32(spu_context* c, uint32_t lsa, uint32_t v)
+{
+    c->ls[lsa] = (uint8_t)(v >> 24); c->ls[lsa + 1] = (uint8_t)(v >> 16); c->ls[lsa + 2] = (uint8_t)(v >> 8); c->ls[lsa + 3] = (uint8_t)v;
+}
+/* A synthetic job-module header: four `ila` words (opcode 0x21 in the top 7 bits) with distinct immediates. */
+static void make_sig(uint8_t out[16], uint32_t seed)
+{
+    for (int i = 0; i < 4; i++) {
+        const uint32_t w = (0x21u << 25) | (((seed * 4u + (uint32_t)i) & 0x3FFFFu) << 7) | (uint32_t)(2 + i);
+        out[i * 4] = (uint8_t)(w >> 24); out[i * 4 + 1] = (uint8_t)(w >> 16); out[i * 4 + 2] = (uint8_t)(w >> 8); out[i * 4 + 3] = (uint8_t)w;
+    }
+}
+
+static spu_context ctx;   /* 256 KB local store: static, not on the stack */
+
+int main(void)
+{
+    uint8_t sig_a[16], sig_b[16];
+    make_sig(sig_a, 0x1111); make_sig(sig_b, 0x2222);
+    reg_sig(sig_a, 200); reg_sig(sig_b, 201);
+    uint32_t cb = 0xFFFFFFFFu;
+
+    /* Defaults: every image on 0x1320. */
+    CHECK(spu_wws_code_buffer_slot(2) == 0x1320u, "default slot of image 2 = 0x%X", spu_wws_code_buffer_slot(2));
+    CHECK(spu_wws_code_buffer_slot(-1) == 0x1320u && spu_wws_code_buffer_slot(100000) == 0x1320u, "out-of-range ids");
+
+    /* 1. KZ3/LBP layout: LS[0x1320] = code buffer 0x4000 (page 0x10 << 10), module A resident there. */
+    spu_context_init(&ctx, 0); ctx.image_id = 2; ctx.policy_mode = 1;
+    put32(&ctx, 0x1320, 0x10u << 10);
+    memcpy(&ctx.ls[0x4000], sig_a, 16);
+    CHECK(spu_wws_code_buffer(&ctx) == 0x4000u, "KZ3 layout: code buffer 0x%X", spu_wws_code_buffer(&ctx));
+    CHECK(spu_wws_resident_job_image(&ctx, &cb) == 200 && cb == 0x4000u, "KZ3 layout: resident image (cb 0x%X)", cb);
+
+    /* 2. ToD layout: the policy module stores an LS pointer (its r28, the base of `lqd r4,0(r28)`) at 0x1320 and the
+     *    code buffer at 0x1330; module B is resident at 0x8000 (page 0x20). */
+    spu_context_init(&ctx, 0); ctx.image_id = 2; ctx.policy_mode = 1;
+    put32(&ctx, 0x1320, 0x2C80u);                    /* not a code buffer: nothing registered there */
+    put32(&ctx, 0x1330, 0x20u << 10);
+    memcpy(&ctx.ls[0x8000], sig_b, 16);
+    /* Before the policy module's slot is registered the runtime reads 0x1320 and finds no module: every job would
+     * fall to the interpreter. This is the behaviour before patch 6500 (the literal 0x1320). */
+    CHECK(spu_wws_resident_job_image(&ctx, &cb) == 0 && cb == 0x2C80u, "ToD layout, default slot: expected no match (cb 0x%X)", cb);
+    spu_wws_set_code_buffer_slot(2, 0x1330);
+    CHECK(spu_wws_code_buffer_slot(2) == 0x1330u, "registered slot of image 2 = 0x%X", spu_wws_code_buffer_slot(2));
+    CHECK(spu_wws_resident_job_image(&ctx, &cb) == 201 && cb == 0x8000u, "ToD layout, slot 0x1330: resident image (cb 0x%X)", cb);
+
+    /* 3. Per policy module: another policy-module image keeps the default and still resolves the KZ3 layout. */
+    spu_context_init(&ctx, 0); ctx.image_id = 3; ctx.policy_mode = 1;
+    put32(&ctx, 0x1320, 0x10u << 10);
+    put32(&ctx, 0x1330, 0x2C80u);
+    memcpy(&ctx.ls[0x4000], sig_a, 16);
+    CHECK(spu_wws_code_buffer_slot(3) == 0x1320u, "image 3 slot = 0x%X", spu_wws_code_buffer_slot(3));
+    CHECK(spu_wws_resident_job_image(&ctx, &cb) == 200 && cb == 0x4000u, "image 3 on the default slot (cb 0x%X)", cb);
+
+    /* 4. Bounds: an out-of-range id is ignored; a slot is masked to a quadword inside LS; a code-buffer address past
+     *    the end of LS (or one whose 16-byte header would cross it) matches nothing. */
+    spu_wws_set_code_buffer_slot(-1, 0x2000);
+    spu_wws_set_code_buffer_slot(SPU_WWS_SLOT_IMAGES, 0x2000);
+    CHECK(spu_wws_code_buffer_slot(SPU_WWS_SLOT_IMAGES - 1) == 0x1320u, "out-of-range set changed the table");
+    spu_wws_set_code_buffer_slot(5, 0x41337);
+    CHECK(spu_wws_code_buffer_slot(5) == 0x1330u, "masked slot = 0x%X", spu_wws_code_buffer_slot(5));
+    spu_context_init(&ctx, 0); ctx.image_id = 2; ctx.policy_mode = 1;
+    put32(&ctx, 0x1330, SPU_LS_SIZE - 8u);
+    CHECK(spu_wws_resident_job_image(&ctx, NULL) == 0, "header crossing the end of LS");
+    put32(&ctx, 0x1330, 0xFFFFFFF8u);
+    CHECK(spu_wws_resident_job_image(&ctx, NULL) == 0, "code buffer address that wraps");
+
+    printf("test_spu_wws_code_slot: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
