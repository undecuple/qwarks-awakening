index a6ec1c3..1175930 100644
--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -634,6 +634,44 @@ SPU_GATE SPU_READ_MOSTLY int g_spu_ls_probe   = -1;  /* spu_ls_read_probe (SPU_L
