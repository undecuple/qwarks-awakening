+/* WWS job code-buffer slot, per policy module. The WWS policy module keeps the LS address of the job code buffer in a
+ * fixed local-store slot and enters a job at LS[slot] + u32@(job header + 0x10). The slot is part of the policy module
+ * build, not of the runtime: 0x1320 in the LBP and Killzone 3 modules, 0x1330 in Ratchet & Clank: Tools of
+ * Destruction's (policy module EA 0x10053d00: `lqa $r2,0x1330` @LS 0x3024 reads it, `stqa $r3,0x1330` @LS 0x21AC
+ * writes it; that module stores an unrelated LS pointer at 0x1320 and never reads it back). Reading the wrong slot
+ * makes the overlay match in spu_indirect_branch miss every job module, and every job falls to the interpreter.
+ * The table is indexed by the policy module's image id (the id its registration gives the context, ctx->image_id);
+ * 0 = SPU_WWS_CODE_BUF_SLOT_DEFAULT, so a port that registers nothing behaves as before. A port whose policy module
+ * uses another slot calls spu_wws_set_code_buffer_slot(pm_image_id, lsa) from its SPU registration, before any
+ * workload runs. */
+#define SPU_WWS_CODE_BUF_SLOT_DEFAULT 0x1320u
+#define SPU_WWS_SLOT_IMAGES 256
+SPU_GATE SPU_READ_MOSTLY uint32_t g_spu_wws_code_buf_slot[SPU_WWS_SLOT_IMAGES];
+static inline void spu_wws_set_code_buffer_slot(int pm_image_id, uint32_t lsa)
+{
+    if ((unsigned)pm_image_id < SPU_WWS_SLOT_IMAGES)
+        g_spu_wws_code_buf_slot[pm_image_id] = lsa & (SPU_LS_SIZE - 16u);   /* a quadword slot in LS */
+}
+static inline uint32_t spu_wws_code_buffer_slot(int image_id)
+{
+    const uint32_t s = (unsigned)image_id < SPU_WWS_SLOT_IMAGES ? g_spu_wws_code_buf_slot[image_id] : 0u;
+    return s ? s : SPU_WWS_CODE_BUF_SLOT_DEFAULT;
+}
+/* The job code buffer's LS address as the policy module running in ctx stored it (word 0 of its slot, big-endian). */
+static inline uint32_t spu_wws_code_buffer(const spu_context* ctx)
+{
+    const uint8_t* p = &ctx->ls[spu_wws_code_buffer_slot(ctx->image_id)];
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+/* The lifted job module resident in ctx's code buffer: its overlay image id, matched by the 16-byte header signature
+ * registered with spu_overlay_register_sig, or 0 (no buffer address in LS range, or no registered module there). */
+static inline int spu_wws_resident_job_image(const spu_context* ctx, uint32_t* code_base)
+{
+    extern int spu_overlay_match_sig(const uint8_t hdr[16]);
+    const uint32_t cb = spu_wws_code_buffer(ctx);
+    if (code_base) *code_base = cb;
+    return cb <= SPU_LS_SIZE - 16u ? spu_overlay_match_sig(&ctx->ls[cb]) : 0;
+}
