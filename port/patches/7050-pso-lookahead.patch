new file mode 100644
index 0000000..bb8e428
--- /dev/null
+++ b/libs/video/rsx_fifo_ahead.h
@@ -0,0 +1,68 @@
+/* R&C patch 7050: read the command FIFO ahead of the walker, without consuming it.
+ *
+ * The walker builds a missing pipeline (PSO) when a draw needs it and waits for that build before it records the
+ * draw (KZ3 RSX pass 57: a draw is never skipped). At a cold level start ToD's first frame meets ~200 misses one
+ * after another, so the build workers run one job at a time and the frame takes tens of seconds. The commands that
+ * follow the current draw are already in memory up to `put`: decoding them ahead lets live draw submit the upcoming
+ * pipelines to the idle workers before it waits for the first.
+ *
+ * rsx_fifo_ahead decodes the words from `off` to `put` the way the walker does (NOP, old and new JUMP, CALL / RET,
+ * incrementing and non-incrementing method headers) and hands every method of subchannels 0 and 1 (the 3D object)
+ * to `on_method`, which returns non-zero to stop. It stops at the first flip word (0xFEADxxxx: the frame ends there),
+ * a semaphore acquire (0x68 on subchannel 0: what follows may wait for other producers), a JUMP to itself (a park),
+ * an unreadable word, a RET without a CALL, or after max_words words. Nothing is written. Returns the stop reason. */
+#ifndef RSX_FIFO_AHEAD_H
+#define RSX_FIFO_AHEAD_H
+#include <stdint.h>
+
+enum {
+    RSX_AHEAD_PUT = 0, RSX_AHEAD_FLIP, RSX_AHEAD_ACQUIRE, RSX_AHEAD_PARK, RSX_AHEAD_UNMAPPED,
+    RSX_AHEAD_RET, RSX_AHEAD_LIMIT, RSX_AHEAD_STOPPED, RSX_AHEAD_UNKNOWN
+};
+
+/* read: the word at IO offset `off`; returns 0 when the offset is not mapped. */
+typedef int (*rsx_ahead_read_fn)(void* u, uint32_t off, uint32_t* word);
+typedef int (*rsx_ahead_method_fn)(void* u, uint32_t method, uint32_t arg);
+
+static inline int rsx_fifo_ahead(uint32_t off, uint32_t put, uint32_t call_ret, uint32_t max_words,
+                                 rsx_ahead_read_fn rd, void* ru, rsx_ahead_method_fn fn, void* fu)
+{
+    while (off != put) {
+        uint32_t w;
+        if (!max_words) return RSX_AHEAD_LIMIT;
+        max_words--;
+        if (!rd(ru, off, &w)) return RSX_AHEAD_UNMAPPED;
+        if (!w) { off += 4u; continue; }
+        if ((w & 0xFFFF0000u) == 0xFEAD0000u) return RSX_AHEAD_FLIP;
+        if ((w & 3u) == 1u) w = 0x20000000u | (w & 0x1FFFFFFCu);   /* new-style JUMP (KZ3 2104) */
+        const uint32_t type = w >> 29;
+        if (type == 1u) {
+            const uint32_t tgt = w & 0x1FFFFFFCu;
+            if (tgt == off) return RSX_AHEAD_PARK;
+            off = tgt; continue;
+        }
+        if ((w & 3u) == 2u) { call_ret = off + 4u; off = w & 0x1FFFFFFCu; continue; }
+        if (w == 0x00020000u) {
+            if (!call_ret) return RSX_AHEAD_RET;
+            off = call_ret; call_ret = 0; continue;
+        }
+        if (type == 0u || type == 2u) {
+            const uint32_t count = (w >> 18) & 0x7FFu, method = w & 0x1FFCu, subch = (w >> 13) & 7u;
+            if (subch == 0u && method == 0x68u) return RSX_AHEAD_ACQUIRE;
+            if (subch <= 1u) {
+                for (uint32_t i = 0; i < count; i++) {
+                    uint32_t a;
+                    if (!rd(ru, off + 4u + i * 4u, &a)) return RSX_AHEAD_UNMAPPED;
+                    if (fn(fu, (subch << 13) | (type == 0u ? method + i * 4u : method), a)) return RSX_AHEAD_STOPPED;
+                }
+            }
+            if (max_words < count) return RSX_AHEAD_LIMIT;
+            max_words -= count;
+            off += 4u + count * 4u;
+            continue;
+        }
+        return RSX_AHEAD_UNKNOWN;
+    }
+    return RSX_AHEAD_PUT;
+}
+#endif
