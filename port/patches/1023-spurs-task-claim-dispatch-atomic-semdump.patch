+
+/* Claim and dispatch a taskset task atomically with the taskset scan (KZ3 patch 1023).
+ * cellSpursCreateTask used to set the task's enabled+ready bits, then the single-slot globals, then
+ * dispatch, while the running mark was only set later in spu_async_run on the new thread. A scan in
+ * that window (another task's exit, or an SPU PUTLLC in the taskset, patch 1022) saw the task enabled,
+ * ready and not running and started it a second time, and the two writers of the globals could hand a
+ * job the other's task id. KZ3's Havok ray-cast tasks (image 43) ran twice that way (spu-10g: 14
+ * dispatches for 11 creates+starts). Now the creator claims the slot (running bit) under the scan's lock
+ * before it sets the bits, and dispatches under the same lock with its own ids. */
+int spu_taskset_claim(uint32_t taskset_ea, uint32_t t, int on)
+{
+    if (!taskset_ea || t >= 128) return 0;
+    ts_lock();
+    uint8_t* r = ts_running(taskset_ea);
+    uint8_t m = (uint8_t)(0x80u >> (t & 7));
+    int was = r ? ((r[t / 8] & m) != 0) : 0;
+    if (r) { if (on) r[t / 8] |= m; else r[t / 8] &= (uint8_t)~m; }
+    ts_unlock();
+    return !was;
+}
+int spu_taskset_dispatch(uint32_t taskset_ea, uint32_t t, const uint8_t* image, uint32_t size, uint32_t ctx)
+{
+    extern uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+    ts_lock();
+    g_ydkj_real_taskset_ea = taskset_ea; g_ydkj_real_taskid = t;
+    int rc = spu_workload_dispatch_async(image, size, ctx);
+    if (!rc && taskset_ea && t < 128) {           /* not started: let a later scan try */
+        uint8_t* r = ts_running(taskset_ea);
+        if (r) r[t / 8] &= (uint8_t)~(0x80u >> (t & 7));
+    }
+    ts_unlock();
+    return rc;
 }
 
