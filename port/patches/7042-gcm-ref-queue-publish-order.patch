 {
     u32 h = s_ref_qhead;
-    if (h == s_ref_qtail) return;
+    if (h == __atomic_load_n(&s_ref_qtail, __ATOMIC_ACQUIRE)) return;   /* patch 7042: slot visible once tail is */
