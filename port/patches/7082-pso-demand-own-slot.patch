diff --git a/libs/video/rsx_pso_slot.h b/libs/video/rsx_pso_slot.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_pso_slot.h
@@ -0,0 +1,26 @@
+/* R&C patch 7082: a PSO miss waits for its own cache slot, not for the last slot.
+ *
+ * get_pso appends the draw's pending entry at slot n, then (R&C patch 7050, LD_PSO_AHEAD=1) runs the FIFO lookahead,
+ * whose nested get_pso calls append more pending entries for upcoming draws. The old tail then awaited slot
+ * n_psos - 1, which after a scan that submitted builds is the LAST lookahead entry: the draw that missed was drawn
+ * with, and kept, another draw's pipeline (other shaders, input layout, GPU-fetch variant) while its root
+ * parameters, vertex buffers and constants were its own. FFA's first 3D frame (9 misses in a row, ffa-base-1) lost
+ * the device that way, and the walker's fence wait never returned.
+ *
+ * The caller passes the slot it filled. Entries are only ever appended (a full cache returns NULL before the store),
+ * so the index stays valid across the scan and the worker merges (RSX_APSO_MERGE matches by key). Header-only so the
+ * host test (port/rc/tests/test_pso_demand_slot.c) compiles the code that ships. */
+#ifndef RSX_PSO_SLOT_H
+#define RSX_PSO_SLOT_H
+#include <stdint.h>
+
+/* The tail of a miss whose build is pending. ahead_active: called from inside a lookahead scan, which only submits
+ * (NULL, no nested scan). Otherwise the upcoming misses are queued first and the draw then waits for `slot`. */
+static inline void* rsx_pso_demand_tail(uint32_t slot, int ahead_active, void (*scan)(void),
+                                        void* (*await_slot)(uint32_t))
+{
+    if (ahead_active) return NULL;
+    scan();
+    return await_slot(slot);
+}
+#endif
