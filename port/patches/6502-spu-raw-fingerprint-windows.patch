diff --git a/runtime/spu/spu_raw.h b/runtime/spu/spu_raw.h
index 4ce2f39..6a25d45 100644
--- a/runtime/spu/spu_raw.h
+++ b/runtime/spu/spu_raw.h
@@ -64,6 +64,57 @@ static inline int spu_raw_is_reg(uint32_t ea)
     return off < SPU_RAW_SPAN && (off & (SPU_RAW_STRIDE - 1)) >= SPU_RAW_PROB_OFF;
