+/* Fingerprint windows for programs streamed in by proxy DMA.
+ *
+ * A program the PPU streams into local store with proxy GETs (no
+ * _sys_spu_image_import) is resolved at run time by fingerprinting each
+ * contiguous GET run (raw_spu_start). That fails when the guest writes into the
+ * IMAGE in main memory before it streams it: a loader that fills a parameter
+ * block inside the program's own data (pointers, sizes, floats of the current
+ * scene) makes the run's bytes differ from any offline image, and from scene to
+ * scene. A port then registers the program under the fingerprint of a WINDOW of
+ * local store that holds only bytes the guest never patches, and declares that
+ * window here; each GET run containing a declared window is also looked up by
+ * the window's fingerprint, after the whole run missed.
+ *
+ * Windows are LS ranges [lo, lo+len). Declaring one twice is a no-op. Returns 1
+ * if the window is (now) declared, 0 if it is invalid or the table is full. */
+#define SPU_RAW_FP_WINDOW_MAX 16u
+typedef struct { uint32_t lo, len; } spu_raw_fp_window;
+extern spu_raw_fp_window g_spu_raw_fp_windows[SPU_RAW_FP_WINDOW_MAX];
+extern unsigned          g_spu_raw_fp_window_count;
+
+static inline int spu_raw_add_fp_window(uint32_t lo, uint32_t len)
+{
+    if (!len || lo >= SPU_RAW_PROB_OFF || len > SPU_RAW_PROB_OFF - lo) return 0;
+    for (unsigned i = 0; i < g_spu_raw_fp_window_count; i++)
+        if (g_spu_raw_fp_windows[i].lo == lo && g_spu_raw_fp_windows[i].len == len) return 1;
+    if (g_spu_raw_fp_window_count >= SPU_RAW_FP_WINDOW_MAX) return 0;
+    g_spu_raw_fp_windows[g_spu_raw_fp_window_count].lo  = lo;
+    g_spu_raw_fp_windows[g_spu_raw_fp_window_count].len = len;
+    g_spu_raw_fp_window_count++;
+    return 1;
+}
+
+/* The LS ranges to fingerprint for one GET run [run_lo, run_hi), in lookup
+ * order: the whole run first (the behaviour without windows), then every
+ * declared window that lies inside the run and is not the whole run. Returns the
+ * count written to out (at most max). */
+static inline unsigned spu_raw_run_fp_ranges(uint32_t run_lo, uint32_t run_hi,
+                                             spu_raw_fp_window* out, unsigned max)
+{
+    unsigned n = 0;
+    if (!max || run_hi <= run_lo) return 0;
+    out[n].lo = run_lo; out[n].len = run_hi - run_lo; n++;
+    for (unsigned i = 0; i < g_spu_raw_fp_window_count && n < max; i++) {
+        const spu_raw_fp_window w = g_spu_raw_fp_windows[i];
+        if (w.lo >= run_lo && w.lo < run_hi && w.len <= run_hi - w.lo &&
+            !(w.lo == run_lo && w.len == run_hi - run_lo))
+            out[n++] = w;
+    }
+    return n;
+}
+
 /* Store side effects (run control, mailboxes, proxy DMA). The plain memory store
  * still happens in vm_write*; this runs after it. */
 void spu_raw_reg_store(uint32_t ea, uint32_t val, int width);
diff --git a/runtime/spu/tests/test_spu_raw_fp_window.c b/runtime/spu/tests/test_spu_raw_fp_window.c
new file mode 100644
index 0000000..b794f0d
--- /dev/null
+++ b/runtime/spu/tests/test_spu_raw_fp_window.c
@@ -0,0 +1,87 @@
+/* test_spu_raw_fp_window.c -- fingerprint windows for raw SPU programs streamed in by proxy DMA (spu_raw.h).
+ *
+ * A loader that writes a parameter block into the program image before it streams it makes the GET run's bytes
+ * differ from the offline image; the port registers the program under the fingerprint of an LS window that excludes
+ * the block. This checks the window table and the order raw_spu_start looks ranges up in, and, with a synthetic
+ * image and spu_workload_fingerprint's algorithm, that a window lookup survives any parameter block while the
+ * whole-run lookup does not.
+ *
+ *   gcc -std=gnu17 -Wall -Wextra -I include -I runtime/spu -o t runtime/spu/tests/test_spu_raw_fp_window.c && ./t
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "spu_raw.h"
+
+spu_raw_fp_window g_spu_raw_fp_windows[SPU_RAW_FP_WINDOW_MAX];
+unsigned          g_spu_raw_fp_window_count;
+
+static int g_pass, g_fail;
+#define CHECK(c, what) do { if (c) g_pass++; else { g_fail++; printf("FAIL %s (line %d)\n", what, __LINE__); } } while (0)
+
+/* Same algorithm as spu_workload_fingerprint (FNV-1a-64), kept local so the test links alone. */
+static uint64_t fnv(const uint8_t* p, uint32_t n)
+{
+    uint64_t h = 1469598103934665603ULL;
+    for (uint32_t i = 0; i < n; i++) { h ^= p[i]; h *= 1099511628211ULL; }
+    return h;
+}
+
+static uint8_t ls[0x40000];
+
+int main(void)
+{
+    spu_raw_fp_window r[1 + SPU_RAW_FP_WINDOW_MAX];
+
+    /* no windows: the whole run only (the behaviour before windows) */
+    CHECK(spu_raw_run_fp_ranges(0x60, 0x6E00, r, 17) == 1 && r[0].lo == 0x60 && r[0].len == 0x6DA0, "whole run only");
+    CHECK(spu_raw_run_fp_ranges(0x100, 0x100, r, 17) == 0, "empty run");
+    CHECK(spu_raw_run_fp_ranges(0x60, 0x6E00, r, 0) == 0, "max 0");
+
+    /* invalid windows are refused */
+    CHECK(!spu_raw_add_fp_window(0x60, 0), "len 0");
+    CHECK(!spu_raw_add_fp_window(0x40000, 0x10), "lo past LS");
+    CHECK(!spu_raw_add_fp_window(0x3FFF0, 0x20), "end past LS");
+    CHECK(g_spu_raw_fp_window_count == 0, "nothing stored");
+
+    /* a window, declared twice */
+    CHECK(spu_raw_add_fp_window(0x60, 0x6D50), "add");
+    CHECK(spu_raw_add_fp_window(0x60, 0x6D50), "add again");
+    CHECK(g_spu_raw_fp_window_count == 1, "deduplicated");
+
+    /* run containing it: whole run first, then the window */
+    unsigned n = spu_raw_run_fp_ranges(0x60, 0x6E00, r, 17);
+    CHECK(n == 2 && r[0].lo == 0x60 && r[0].len == 0x6DA0 && r[1].lo == 0x60 && r[1].len == 0x6D50, "run + window");
+    /* runs that do not contain it */
+    CHECK(spu_raw_run_fp_ranges(0x60, 0x6000, r, 17) == 1, "run shorter than the window");
+    CHECK(spu_raw_run_fp_ranges(0x100, 0x7000, r, 17) == 1, "run starting after the window");
+    /* a window equal to the run is not looked up twice */
+    CHECK(spu_raw_add_fp_window(0x200, 0x100), "add second");
+    CHECK(spu_raw_run_fp_ranges(0x200, 0x300, r, 17) == 1, "window == run");
+    /* max is honoured */
+    CHECK(spu_raw_run_fp_ranges(0x60, 0x6E00, r, 1) == 1, "max 1");
+
+    /* table full */
+    for (uint32_t i = 2; i < SPU_RAW_FP_WINDOW_MAX; i++) CHECK(spu_raw_add_fp_window(0x1000 + i * 0x10, 0x10), "fill");
+    CHECK(g_spu_raw_fp_window_count == SPU_RAW_FP_WINDOW_MAX, "full");
+    CHECK(!spu_raw_add_fp_window(0x8000, 0x10), "refused when full");
+    CHECK(spu_raw_add_fp_window(0x60, 0x6D50), "existing one still accepted when full");
+
+    /* a synthetic image with a parameter block at its end: the window resolves it, the whole run does not */
+    for (uint32_t a = 0x60; a < 0x6E00; a++) ls[a] = (uint8_t)(a * 13u + 1u);
+    const uint64_t reg = fnv(ls + 0x60, 0x6D50);          /* what the port registers */
+    const uint64_t clean_run = fnv(ls + 0x60, 0x6DA0);
+    for (int pat = 0; pat < 3; pat++) {
+        for (uint32_t a = 0x6DB0; a < 0x6E00; a++) ls[a] = (uint8_t)(pat == 0 ? 0 : pat == 1 ? 0xFF : a);
+        n = spu_raw_run_fp_ranges(0x60, 0x6E00, r, 17);
+        int hit = -1;
+        for (unsigned k = 0; k < n && hit < 0; k++) if (fnv(ls + r[k].lo, r[k].len) == reg) hit = (int)k;
+        CHECK(hit == 1, "the window lookup hits whatever the parameter block holds");
+        CHECK(fnv(ls + 0x60, 0x6DA0) != reg, "the whole run is not the registered fingerprint");
+    }
+    (void)clean_run;
+
+    printf("%d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
