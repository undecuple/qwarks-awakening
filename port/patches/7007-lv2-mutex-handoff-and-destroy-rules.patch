+void lv2_mtx_handoff_locked(sys_mutex_info* m)
+{
+    lv2_mtx_waiter* w = m->queue;
+    if (w) {
+        m->queue = w->next;
+        m->owner_tid = w->tid;
+        m->lock_count = w->count;
+        mtx_wake(m);
+    } else {
+        m->owner_tid = 0;
+        m->lock_count = 0;
+    }
+}
+
+void lv2_mtx_give_or_queue_locked(sys_mutex_info* m, lv2_mtx_waiter* w)
+{
+    w->next = NULL;
+    if (!m->owner_tid) {
+        m->owner_tid = w->tid;
+        m->lock_count = w->count;
+        mtx_wake(m);
+        return;
+    }
+    lv2_mtx_waiter** tail = &m->queue;
+    while (*tail) tail = &(*tail)->next;
+    *tail = w;
+}
+
+void lv2_mtx_wait_owner_locked(sys_mutex_info* m, uint64_t tid)
+{
+    while (m->owner_tid != tid) mtx_sleep(m, 0, 0);
+}
