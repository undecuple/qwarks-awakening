-#  define PPU_SJ_HOST_LONGJMP(b, v) longjmp((b), (v))
+/* R&C patch 7066: the frameless jump without the CRT (its longjmp refuses Frame == 0 under CFG on Windows). */
+#  include "../platform/host_jmp_win64.h"
+#  define PPU_SJ_HOST_SETJMP(b)    rc_host_setjmp(b)
+#  define PPU_SJ_HOST_LONGJMP(b, v) rc_host_longjmp((b), (v))
 #elif defined(_WIN32)
 #  define PPU_SJ_HOST_SETJMP(b)    setjmp(b)
 #  define PPU_SJ_HOST_LONGJMP(b, v) longjmp((b), (v))
