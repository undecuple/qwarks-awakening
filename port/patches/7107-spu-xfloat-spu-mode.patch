+/* RC patch 7107: MXCSR access for the SPU float mode (spu_fpmode.h): spu__mx_spu() = this thread runs SPU single-
+ * precision semantics (round toward zero); cold paths only. SPU__PIN keeps a value in place between two MXCSR writes. */
+#if defined(__SSE__) || defined(_M_X64)
+#include <xmmintrin.h>
+static inline unsigned spu__csr(void) { return _mm_getcsr(); }
+static inline void spu__setcsr(unsigned c) { _mm_setcsr(c); }
+#else
+static inline unsigned spu__csr(void) { return 0; }
+static inline void spu__setcsr(unsigned c) { (void)c; }
+#endif
+static inline int spu__mx_spu(void) { return (spu__csr() & 0x6000u) == 0x6000u; }
+#if defined(__GNUC__) || defined(__clang__)
+#  define SPU__PIN(d) __asm__ volatile("" : "+x"(d))
+#  define SPU__PIN_F(f) __asm__ volatile("" : "+x"(f))
+#else
+#  define SPU__PIN(d) ((void)0)
+#  define SPU__PIN_F(f) ((void)0)
+#endif
+/* RC patch 7107 (SPU float mode): the RESULT lanes the exact lane code must recompute are biased exponent 255 and the
+ * largest finite magnitude 0x7F7FFFFF. Under the SPU rounding (round toward zero, spu_fpmode.h RC_SPU_XFLOAT=1) an
+ * x86 overflow gives +-FLT_MAX instead of Inf, while the SPU result lies in the exponent-255 binade or saturates
+ * (ISA v1.2 s.9.1); a true result of exactly 0x7F7FFFFF is recomputed to the same value. Same cost as spu__xr_mask. */
+static inline unsigned spu__xr_mask_r(u128 v) {
+#if defined(__SSE2__)
+    __m128i V; memcpy(&V, &v, 16);
+    return (unsigned)_mm_movemask_ps(_mm_castsi128_ps(_mm_cmpgt_epi32(_mm_and_si128(V, _mm_set1_epi32(0x7FFFFFFF)),
+                                                                      _mm_set1_epi32(0x7F7FFFFE))));
+#else
+    unsigned m = 0; for (int i = 0; i < 4; i++) m |= ((v._u32[i] & 0x7FFFFFFFu) >= 0x7F7FFFFFu) << i; return m;
+#endif
+}
+/* RC patch 7107: "a zero result is always a positive zero" (ISA v1.2 s.9.1). The host gives -0 for a product of a zero
+ * and a negative operand, a -0 sum of two -0 terms, and an underflow of a negative value under FTZ; those lanes become
+ * +0 (two integer ops: the lane equal to 0x80000000 is cleared). */
+static inline u128 spu__pos0(u128 v) {
+#if defined(__SSE2__)
+    __m128i V; memcpy(&V, &v, 16);
+    V = _mm_andnot_si128(_mm_cmpeq_epi32(V, _mm_set1_epi32((int)0x80000000u)), V);
+    memcpy(&v, &V, 16); return v;
+#else
+    for (int i = 0; i < 4; i++) if (v._u32[i] == 0x80000000u) v._u32[i] = 0;
+    return v;
+#endif
+}
