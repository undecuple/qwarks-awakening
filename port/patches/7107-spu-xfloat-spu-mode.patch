+static int r_cmp(uint32_t x, uint32_t y, int mag) {
+    term a = r_dec(x), b = r_dec(y); if (mag) a.s = b.s = 0;
+    const int sa = !a.m ? 0 : a.s ? -1 : 1, sb = !b.m ? 0 : b.s ? -1 : 1;
+    if (sa != sb) return sa < sb ? -1 : 1;
+    if (!sa) return 0;
+    const uint32_t ka = (uint32_t)(a.e + 150) << 23 | (uint32_t)(a.m & 0x7FFFFF), kb = (uint32_t)(b.e + 150) << 23 | (uint32_t)(b.m & 0x7FFFFF);
+    const int c = ka == kb ? 0 : ka > kb ? 1 : -1; return sa > 0 ? c : -c; }
+static uint32_t r_fi(uint32_t ra, uint32_t rb) {
+    const uint32_t e = rb >> 23 & 0xFF, base = rb >> 10 & 0x1FFF, step = rb & 0x3FF, y = ra & 0x7FFFF;
+    const u128x mag = ((u128x)(8192 + base) << 19) - (u128x)step * y;     /* (1.Base - 0.000Step*Y) * 2^32 */
+    if (!e) return 0;   /* 2^-127 * (<2): below Smin */
+    return r_pack(rb & 0x80000000u, mag, (int)e - 127 - 32, 0); }
+static uint32_t r_cxflt(uint32_t v, int i8, int uns) {
+    uint32_t s = 0; uint64_t m = v; if (!uns && (int32_t)v < 0) { s = 0x80000000u; m = (uint64_t)(-(int64_t)(int32_t)v); }
+    return r_pack(s, m, -(155 - i8), 0); }
+static uint32_t r_cflx(uint32_t x, int i8, int uns) {
+    const term a = r_dec(x); if (!a.m) return 0;
+    const int sh = a.e + (173 - i8);
+    if (uns && a.s) return 0;
+    u128x v = sh >= 0 ? (sh > 100 ? ~(u128x)0 >> 1 : (u128x)a.m << sh) : (sh <= -64 ? 0 : (u128x)(a.m >> -sh));
+    if (uns) return v > 0xFFFFFFFFu ? 0xFFFFFFFFu : (uint32_t)v;
+    if (a.s) return v >= 0x80000000u ? 0x80000000u : 0u - (uint32_t)v;
+    return v > 0x7FFFFFFFu ? 0x7FFFFFFFu : (uint32_t)v; }
+
+/* ------------------------------------------------------------------ inputs */
+static const uint32_t edge[] = { 0x00000000, 0x00000001, 0x007FFFFF, 0x00400000, 0x00800000, 0x00800001, 0x00FFFFFF, 0x01000000,
+    0x0C000000, 0x1E800000, 0x33800000, 0x34000000, 0x3EAAAAAB, 0x3F000000, 0x3F7FFFFF, 0x3F800000, 0x3F800001, 0x3FFFFFFF,
+    0x40000000, 0x40400000, 0x40490FDB, 0x4B000000, 0x4B7FFFFF, 0x4F000000, 0x5F000000, 0x7E7FFFFF, 0x7E800000, 0x7F000000,
+    0x7F000001, 0x7F7FFFFE, 0x7F7FFFFF, 0x7F800000, 0x7F800001, 0x7FC00000, 0x7FFFFFFE, 0x7FFFFFFF };
+#define NEDGE ((int)(sizeof edge / sizeof edge[0]))
+static uint64_t rs = 0x2545F4914F6CDD1Dull;
+static uint64_t rnd(void) { rs ^= rs << 13; rs ^= rs >> 7; rs ^= rs << 17; return rs; }
+static uint32_t rword(void) {
+    const uint64_t r = rnd(); const uint32_t s = (uint32_t)(r & 1) << 31, f = (uint32_t)(r >> 9) & 0x7FFFFF;
+    switch ((r >> 1) & 7) {
+    case 0: return (uint32_t)(r >> 32);
+    case 1: return s | ((uint32_t)(r >> 40) % 3) << 23 | f;            /* exponent 0..2 */
+    case 2: return s | (253u + (uint32_t)(r >> 40) % 3) << 23 | f;     /* exponent 253..255 */
+    case 3: return s | edge[(r >> 40) % NEDGE];
+    default: return s | (110u + (uint32_t)(r >> 40) % 40) << 23 | f;   /* ordinary magnitudes */
+    }
+}
+
+/* ------------------------------------------------------------------ harness */
+enum { O_FA, O_FS, O_FM, O_FMA, O_FMS, O_FNMS, O_FCEQ, O_FCGT, O_FCMEQ, O_FCMGT, O_FI_REST, O_FI_RSQ, O_FI_ANY,
+       O_CSFLT, O_CUFLT, O_CFLTS, O_CFLTU, O_N };
+static const char* const oname[O_N] = { "fa", "fs", "fm", "fma", "fms", "fnms", "fceq", "fcgt", "fcmeq", "fcmgt",
+    "fi(frest)", "fi(frsqest)", "fi(any)", "csflt", "cuflt", "cflts", "cfltu" };
+enum { K_ZSIGN, K_DEN, K_ULP, K_RANGE, K_OTHER, K_N };
+static const char* const kname[K_N] = { "zero-sign", "denormal", "1ulp", "range", "other" };
+typedef struct { long n, bad, k[K_N]; uint32_t ex[3][5]; int nex; } stat;
+static stat st[O_N];
+static int isden(uint32_t x) { return !(x >> 23 & 0xFF) && (x & 0x7FFFFF); }
+static void note(int o, uint32_t a, uint32_t b, uint32_t c, int imm, uint32_t got, uint32_t want) {
+    stat* s = &st[o]; s->n++;
+    if (got == want) return;
+    int k;
+    const int64_t mg = got & 0x7FFFFFFF, mw = want & 0x7FFFFFFF;
+    if (!mg && !mw) k = K_ZSIGN;
+    else if (isden(a) || isden(b) || isden(c) || isden(got)) k = K_DEN;
+    else if ((got ^ want) >> 31 == 0 && (mg - mw == 1 || mw - mg == 1)) k = K_ULP;
+    else if (((got >> 23) & 0xFF) >= 254 || ((want >> 23) & 0xFF) >= 254) k = K_RANGE;
+    else k = K_OTHER;
+    s->bad++; s->k[k]++;
+    if (s->nex < 3) { uint32_t* e = s->ex[s->nex++]; e[0] = a; e[1] = b; e[2] = c; e[3] = got; e[4] = want; (void)imm; }
+}
+static void run4(int o, const uint32_t* A4, const uint32_t* B4, const uint32_t* C4, int imm) {
+    u128 A, B, C, R; memcpy(A._u32, A4, 16); memcpy(B._u32, B4, 16); memcpy(C._u32, C4, 16);
+    switch (o) {
+    case O_FA: R = spu_fa(A, B); break;          case O_FS: R = spu_fs(A, B); break;
+    case O_FM: R = spu_fm(A, B); break;          case O_FMA: R = spu_fma(A, B, C); break;
+    case O_FMS: R = spu_fms(A, B, C); break;     case O_FNMS: R = spu_fnms(A, B, C); break;
+    case O_FCEQ: R = spu_fceq(A, B); break;      case O_FCGT: R = spu_fcgt(A, B); break;
+    case O_FCMEQ: R = spu_fcmeq(A, B); break;    case O_FCMGT: R = spu_fcmgt(A, B); break;
+    case O_FI_REST: B = spu_frest(A); R = spu_fi(A, B); break;
+    case O_FI_RSQ: B = spu_frsqest(A); R = spu_fi(A, B); break;
+    case O_FI_ANY: R = spu_fi(A, B); break;
+    case O_CSFLT: R = spu_csflt(A, imm); break;  case O_CUFLT: R = spu_cuflt(A, imm); break;
+    case O_CFLTS: R = spu_cflts(A, imm); break;  case O_CFLTU: R = spu_cfltu(A, imm); break;
+    default: return;
+    }
+    for (int i = 0; i < 4; i++) {
+        const uint32_t a = A._u32[i], b = B._u32[i], c = C._u32[i];
+        uint32_t w;
+        switch (o) {
+        case O_FA: w = r_fa(a, b); break;   case O_FS: w = r_fs(a, b); break;   case O_FM: w = r_fm(a, b); break;
+        case O_FMA: w = r_fmx(a, b, c, 0, 0); break;
+        case O_FMS: w = r_fmx(a, b, c, 0, 0x80000000u); break;
+        case O_FNMS: w = r_fmx(a, b, c, 0x80000000u, 0); break;
+        case O_FCEQ: w = r_cmp(a, b, 0) == 0 ? ~0u : 0; break;   case O_FCGT: w = r_cmp(a, b, 0) > 0 ? ~0u : 0; break;
+        case O_FCMEQ: w = r_cmp(a, b, 1) == 0 ? ~0u : 0; break;  case O_FCMGT: w = r_cmp(a, b, 1) > 0 ? ~0u : 0; break;
+        case O_FI_REST: case O_FI_RSQ: case O_FI_ANY: w = r_fi(a, b); break;
+        case O_CSFLT: w = r_cxflt(a, imm, 0); break;  case O_CUFLT: w = r_cxflt(a, imm, 1); break;
+        case O_CFLTS: w = r_cflx(a, imm, 0); break;   default: w = r_cflx(a, imm, 1); break;
+        }
+        note(o, a, b, c, imm, R._u32[i], w);
+    }
+}
+static const int nin[O_N] = { 2, 2, 2, 3, 3, 3, 2, 2, 2, 2, 1, 1, 2, 1, 1, 1, 1 };
+static void sweep(long nrand) {
+    uint32_t A[4], B[4], C[4]; int k = 0;
+    static const int sc_xflt[] = { 28, 29, 100, 127, 150, 154, 155 }, sc_cfl[] = { 46, 47, 100, 150, 172, 173 };
+    for (int o = 0; o < O_N; o++) {
+        const int* scs = (o == O_CSFLT || o == O_CUFLT) ? sc_xflt : (o == O_CFLTS || o == O_CFLTU) ? sc_cfl : 0;
+        const int ns = scs == sc_xflt ? 7 : scs ? 6 : 1;
+        for (int si = 0; si < ns; si++) {
+            const int imm = scs ? scs[si] : 0;
+            k = 0;
+#define PUSH(x, y, z) do { A[k] = (x); B[k] = (y); C[k] = (z); if (++k == 4) { run4(o, A, B, C, imm); k = 0; } } while (0)
+            /* edges with both signs: all pairs (all triples for the fma family) */
+            for (int i = 0; i < 2 * NEDGE; i++) {
+                const uint32_t x = edge[i >> 1] | (uint32_t)(i & 1) << 31;
+                if (nin[o] == 1) { PUSH(x, 0, 0); continue; }
+                for (int j = 0; j < 2 * NEDGE; j++) {
+                    const uint32_t y = edge[j >> 1] | (uint32_t)(j & 1) << 31;
+                    if (nin[o] == 2) { PUSH(x, y, 0); continue; }
+                    for (int l = 0; l < 2 * NEDGE; l++) PUSH(x, y, edge[l >> 1] | (uint32_t)(l & 1) << 31);
+                }
+            }
+            /* integers for the int -> float conversions */
+            if (o == O_CSFLT || o == O_CUFLT) {
+                static const uint32_t iv[] = { 0, 1, 2, 3, 0x7FFFFF, 0x800000, 0xFFFFFF, 0x1000001, 0x7FFFFFFF, 0x80000000u,
+                    0x80000001u, 0xFFFFFFFFu, 0xFF000001u, 0x12345678u };
+                for (unsigned i = 0; i < sizeof iv / 4; i++) PUSH(iv[i], 0, 0);
+            }
+            for (long r = 0; r < nrand; r++) {
+                uint32_t x = rword(), y = rword(), z = rword();
+                switch (r & 3) {
+                case 1: y = (x ^ 0x80000000u) + (uint32_t)((int)(rnd() % 9) - 4); break;          /* cancellation */
+                case 2: z = r_fm(x, y) ^ 0x80000000u; z += (uint32_t)((int)(rnd() % 5) - 2); break;   /* fma cancels */
+                case 3: if (o == O_CSFLT || o == O_CUFLT) x = (uint32_t)rnd(); break;
+                }
+                PUSH(x, y, z);
+            }
+            while (k) PUSH(0, 0, 0);
+#undef PUSH
+        }
+    }
+}
+/* frest/frsqest + fi: the refined estimate's accuracy (bits), x normal */
+static int chain_bits(int rsq) {
+    int worst = 99;
+    for (int i = 0; i < 100000; i++) {
+        const uint32_t x = (uint32_t)(2 + rnd() % 248) << 23 | (uint32_t)(rnd() & 0x7FFFFF);
+        u128 A = spu_zero(); A._u32[0] = x;
+        const uint32_t y = spu_fi(A, rsq ? spu_frsqest(A) : spu_frest(A))._u32[0];
+        const term a = r_dec(x), b = r_dec(y);
+        if (!b.m) continue;
+        /* x*y (or x*y*y) against 1, exactly */
+        u128x P = (u128x)a.m * b.m; int e = a.e + b.e;
+        if (rsq) { P *= b.m; e += b.e; }
+        if (-e < 0 || -e > 126) continue;
+        const u128x one = (u128x)1 << -e, err = P > one ? P - one : one - P;
+        const int bits = err ? -e - (msb128(err) + 1) : 99;
+        if (bits < worst) worst = bits;
+    }
+    return worst;
+}
+/* double ops: under the SPU mode they must give the round-to-nearest results computed before the mode was set */
+typedef struct { double a, b, c; uint64_t sum, prod, fma; uint32_t frds; } dcase;
+static dcase dc[6];
+static void dcases_ref(void) {   /* under the default MXCSR */
+    static const double v[6][3] = { { 1.0, 0x1p-60, 0.0 }, { 1.0, 0x1.8p-53, 0.0 }, { 3.0, 1.0 / 3.0, -1.0 },
+        { -1.0, 0x1.0000000000001p-53, 0x1p-80 }, { 0x1.fffffffffffffp1023, 1.0, 0.0 }, { 0x1.000001fffffffp0, 1.0, 0.0 } };
+    for (int i = 0; i < 6; i++) {
+        volatile double a = v[i][0], b = v[i][1], c = v[i][2];
+        const double s = a + b, p = a * b, f = a * b + c; const float fr = (float)a;
+        dc[i].a = a; dc[i].b = b; dc[i].c = c;
+        memcpy(&dc[i].sum, &s, 8); memcpy(&dc[i].prod, &p, 8); memcpy(&dc[i].fma, &f, 8); memcpy(&dc[i].frds, &fr, 4);
+    }
+}
+static int dcases_check(void) {
+    int bad = 0;
+    for (int i = 0; i < 6; i++) {
+        u128 A = spu_zero(), B = spu_zero(), T = spu_zero();
+        spu__dset(&A, 0, dc[i].a); spu__dset(&A, 1, dc[i].a); spu__dset(&B, 0, dc[i].b); spu__dset(&B, 1, dc[i].b);
+        spu__dset(&T, 0, dc[i].c); spu__dset(&T, 1, dc[i].c);
+        const u128 S = spu_dfa(A, B), P = spu_dfm(A, B), F = spu_dfma(A, B, T), R = spu_frds(A);
+        for (int k = 0; k < 2; k++) {
+            uint64_t s, p, f; double d;
+            d = spu__dget(S, k); memcpy(&s, &d, 8); d = spu__dget(P, k); memcpy(&p, &d, 8); d = spu__dget(F, k); memcpy(&f, &d, 8);
+            if (s != dc[i].sum || p != dc[i].prod || f != dc[i].fma || R._u32[2 * k] != dc[i].frds) {
+                bad++; printf("  double case %d lane %d: dfa %016llx/%016llx dfm %016llx/%016llx dfma %016llx/%016llx frds %08x/%08x\n",
+                    i, k, (unsigned long long)s, (unsigned long long)dc[i].sum, (unsigned long long)p, (unsigned long long)dc[i].prod,
+                    (unsigned long long)f, (unsigned long long)dc[i].fma, R._u32[2 * k], dc[i].frds);
+            }
+        }
+    }
+    return bad;
+}
+
+static int report(const char* pass, int strict) {
+    long tot = 0;
+    printf("# pass %s: MXCSR %04x\n", pass, _mm_getcsr());
+    for (int o = 0; o < O_N; o++) {
+        const stat* s = &st[o];
+        printf("%-12s n=%-8ld mismatch=%-7ld", oname[o], s->n, s->bad);
+        for (int k = 0; k < K_N; k++) printf(" %s=%ld", kname[k], s->k[k]);
+        printf("\n");
+        for (int e = 0; e < s->nex; e++)
+            printf("  eg in=%08x,%08x,%08x helper=%08x spu=%08x\n", s->ex[e][0], s->ex[e][1], s->ex[e][2], s->ex[e][3], s->ex[e][4]);
+        tot += s->bad;
+    }
+    const int bf = chain_bits(0), bq = chain_bits(1);
+    printf("frest+fi accuracy %d bits, frsqest+fi %d bits (normal x)\n", bf, bq);
+    if (strict && (bf < 11 || bq < 11)) tot++;
+    return tot != 0;
+}
+
+int main(int argc, char** argv) {
+    long nrand = argc > 1 ? atol(argv[1]) : 200000;
+    int fail = 0;
+    dcases_ref();
+    /* host pass: the default MXCSR (no RC_SPU_XFLOAT), informational */
+    _mm_setcsr(0x1F80);
+    sweep(nrand);
+    report("host (default MXCSR, informational)", 0);
+    memset(st, 0, sizeof st);
+    /* spu pass: the thread mode as the SPU host threads set it */
+    setenv("RC_SPU_XFLOAT", "1", 1);
+#ifdef SPU_FPMODE_SPU
+    spu_fpmode_init_thread();
+    const char* how = "spu_fpmode_init_thread, RC_SPU_XFLOAT=1";
+#else
+    _mm_setcsr(0x1F80 | 0xE040);
+    const char* how = "set by hand: this tree has no RC_SPU_XFLOAT (negative control)";
+#endif
+    const unsigned csr = _mm_getcsr();
+    printf("# spu mode: %s\n", how);
+    if ((csr & 0xE040) != 0xE040) { printf("FAIL: MXCSR %04x lacks round-toward-zero|FTZ|DAZ\n", csr); fail = 1; }
+    sweep(nrand);
+    fail |= report("spu (strict)", 1);
+    const int dbad = dcases_check();
+    if ((_mm_getcsr() & ~0x3Fu) != (csr & ~0x3Fu)) { printf("FAIL: MXCSR control %04x after the double ops (was %04x)\n", _mm_getcsr() & ~0x3Fu, csr & ~0x3Fu); fail = 1; }
+    printf("double ops under the spu mode: %d lane mismatches against round to nearest\n", dbad);
+    fail |= dbad != 0;
+    printf("%s\n", fail ? "FAIL" : "PASS");
+    return fail;
+}
