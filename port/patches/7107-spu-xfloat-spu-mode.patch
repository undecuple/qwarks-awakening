@@ -0,0 +1,324 @@
+/* SPU single-precision mode (port patch 7107): the float helpers the Insomniac collision jobs use, against an exact
+ * reference of SPU ISA v1.2 chapter 9 [src:spu-isa-1.2], on boundary and random inputs.
+ *
+ * Build/run: tools/spu/run_spu_xfloat_test.sh (no game data). One binary, two passes:
+ *   spu  : RC_SPU_XFLOAT=1 and spu_fpmode_init_thread() (MXCSR round toward zero | FTZ | DAZ, as the SPU host threads
+ *          get it); every op must match the reference bit for bit (exit 1 otherwise).
+ *   host : default MXCSR (round to nearest, no flush), the runtime without RC_SPU_XFLOAT; mismatches are counted and
+ *          printed by class only (the known host deviations: rounding, denormals, zero sign).
+ * Ops: fa fs fm fma fms fnms fceq fcgt fcmeq fcmgt fi(frest/frsqest) csflt cuflt cflts cfltu (the collision jobs use all
+ * but cflts/cfltu, the RE notes s.37), and the double ops dfa/dfm/dfma/frds (must keep round-to-nearest in the SPU mode).
+ *
+ * Reference rules (ISA v1.2 s.9.1 p.195 and the instruction pages): biased exponent 255 is an ordinary binade, no
+ * Inf/NaN; magnitudes above Smax = 0x7FFFFFFF saturate to +-Smax; exponent 0 (zero, denorm) reads as zero; a result
+ * below Smin = 2^-126 is +0; "a zero result is always a positive zero"; the only rounding is truncation; fma's product
+ * is exact (p.208); fcgt: "Two zeros never compare greater than independent of their sign bits and fractions" (p.233);
+ * fi (p.219): (-1)^S * (1.Base - 0.000Step * Y) * 2^(E-127), Y = 0.RA[13:31]; csflt/cuflt (p.220-221): integer /
+ * 2^(155-I8), scale 0..127; cflts/cfltu: value * 2^(173-I8), truncated and saturated. The reference uses integers only.
+ * Without the patch (spu_fpmode.h has no SPU_FPMODE_SPU) the spu pass sets the same MXCSR by hand: that is the
+ * negative control (the unpatched helpers then give FLT_MAX for overflows, -0 results and a rounded fi). */
+#include "spu_helpers.h"
+#include "spu_fpmode.h"
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <xmmintrin.h>
+
+int g_kz3_spu_xr = 1, g_kz3_spu_xrq = 1, g_kz3_xr_stats = 0, g_kz3_spu_slowcg = 0, g_kz3_fma_stats = 0;
+void kz3_spu_xr_note(int op, unsigned m, const uint32_t* a, const uint32_t* b, const uint32_t* c, const uint32_t* r, const void* ra)
+{ (void)op; (void)m; (void)a; (void)b; (void)c; (void)r; (void)ra; }
+void kz3_spu_fma_note(const double s[4], int ftz) { (void)s; (void)ftz; }
+
+/* ------------------------------------------------------------------ exact reference */
+typedef unsigned __int128 u128x;
+static int msb128(u128x v) { const uint64_t hi = (uint64_t)(v >> 64); return hi ? 127 - __builtin_clzll(hi) : 63 - __builtin_clzll((uint64_t)v); }
+/* sign * (mag * 2^e2 - tiny), tiny > 0 far below one unit of mag when 'below' is set; truncated to 24 bits, SPU range */
+static uint32_t r_pack(uint32_t sign, u128x mag, int e2, int below) {
+    if (!mag) return 0;
+    int top = msb128(mag);
+    uint32_t kept; int dropped_nz;
+    if (top > 23) { kept = (uint32_t)(mag >> (top - 23)); dropped_nz = (mag & (((u128x)1 << (top - 23)) - 1)) != 0; }
+    else { kept = (uint32_t)(mag << (23 - top)); dropped_nz = 0; }
+    if (below && !dropped_nz) {                     /* exactly representable minus a sliver: one unit lower */
+        kept -= 1;
+        if (kept < (1u << 23)) { kept = (1u << 24) - 1; top -= 1; }
+    }
+    const int biased = top + e2 + 127;
+    if (biased > 255) return sign | 0x7FFFFFFFu;
+    if (biased < 1) return 0;
+    return sign | ((uint32_t)biased << 23) | (kept & 0x7FFFFFu);
+}
+typedef struct { uint32_t s; uint64_t m; int e; } term;   /* value = (-1)^s * m * 2^e, m = 0 for zero */
+static term r_dec(uint32_t x) { term t; t.s = x & 0x80000000u; const uint32_t be = x >> 23 & 0xFF;
+    t.m = be ? (x & 0x7FFFFFu) | 0x800000u : 0; t.e = (int)be - 150; return t; }
+static uint32_t r_add(term a, term b) {
+    if (!a.m && !b.m) return 0;
+    if (!a.m) return r_pack(b.s, b.m, b.e, 0);
+    if (!b.m) return r_pack(a.s, a.m, a.e, 0);
+    /* order by magnitude: compare m*2^e */
+    term hi = a, lo = b;
+    { const int ta = msb128(a.m) + a.e, tb = msb128(b.m) + b.e;
+      int swap = tb > ta;
+      if (ta == tb) { const int d = a.e - b.e;   /* same top bit: align the shorter */
+          const u128x A = d >= 0 ? (u128x)a.m << d : a.m, B = d >= 0 ? b.m : (u128x)b.m << -d; swap = B > A; }
+      if (swap) { hi = b; lo = a; } }
+    const int d = hi.e - lo.e;
+    if (d > 64 || d < -64) {                          /* lo is below 2^-16 units of hi's 48-bit window: a sliver */
+        if (d < 0) { fprintf(stderr, "r_add: unexpected order\n"); exit(2); }
+        return r_pack(hi.s, hi.m, hi.e, hi.s != lo.s);
+    }
+    const int eb = d >= 0 ? lo.e : hi.e;
+    const u128x H = d >= 0 ? (u128x)hi.m << d : hi.m, L = d >= 0 ? lo.m : (u128x)lo.m << -d;
+    if (hi.s == lo.s) return r_pack(hi.s, H + L, eb, 0);
+    if (H == L) return 0;
+    return r_pack(hi.s, H - L, eb, 0);              /* |hi| > |lo| */
+}
+static uint32_t r_fa(uint32_t x, uint32_t y) { return r_add(r_dec(x), r_dec(y)); }
+static uint32_t r_fs(uint32_t x, uint32_t y) { return r_add(r_dec(x), r_dec(y ^ 0x80000000u)); }
+static uint32_t r_fm(uint32_t x, uint32_t y) { const term a = r_dec(x), b = r_dec(y);
+    if (!a.m || !b.m) return 0; return r_pack(a.s ^ b.s, (u128x)a.m * b.m, a.e + b.e, 0); }
+static uint32_t r_fmx(uint32_t x, uint32_t y, uint32_t z, uint32_t negp, uint32_t negc) {
+    const term a = r_dec(x), b = r_dec(y); term c = r_dec(z); c.s ^= negc;
+    term p; p.s = (a.s ^ b.s) ^ negp; p.m = (a.m && b.m) ? a.m * b.m : 0; p.e = a.e + b.e;
+    return r_add(p, c); }
