+
+/* The library raises a maximum under 1500 bytes to 1500 ([src:rpcs3-cellhttp]). */
+s32 cellHttpClientSetResponseBufferMax(CellHttpClientId clientId, u32 max)
+{
+    HttpClientSlot* c; s32 r = http_client_get(clientId, &c);
+    if (r == CELL_OK) c->response_buffer_max = max < 1500u ? 1500u : max;
+    return r;
+}
+
+/* Timeouts are s64 microseconds; the transactions' sockets take them as u32. ASSUMPTION: a negative or > u32 value is
+ * INVALID_VALUE (the SDK's own check is not in the reference). */
+static s32 http_client_timeout(CellHttpClientId clientId, s64 usec, int which)
+{
+    HttpClientSlot* c; s32 r = http_client_get(clientId, &c);
+    if (r != CELL_OK) return r;
+    if (usec < 0 || usec > (s64)0xFFFFFFFFu) return (s32)CELL_HTTP_ERROR_INVALID_VALUE;
+    if (which == 0) c->connect_timeout = (u32)usec;
+    else if (which == 1) c->send_timeout = (u32)usec;
+    else c->recv_timeout = (u32)usec;
+    return CELL_OK;
+}
+s32 cellHttpClientSetConnTimeout(CellHttpClientId clientId, s64 usec) { return http_client_timeout(clientId, usec, 0); }
+s32 cellHttpClientSetSendTimeout(CellHttpClientId clientId, s64 usec) { return http_client_timeout(clientId, usec, 1); }
+s32 cellHttpClientSetRecvTimeout(CellHttpClientId clientId, s64 usec) { return http_client_timeout(clientId, usec, 2); }
+
+/* (clientId, CellHttpsSslCallback cbfunc, void* userArg): kept; it runs during a TLS handshake, which offline never
+ * happens. */
+s32 cellHttpClientSetSslCallback(CellHttpClientId clientId, u32 cbfunc, u32 userArg)
+{
+    HttpClientSlot* c; s32 r = http_client_get(clientId, &c);
+    if (r != CELL_OK) return r;
+    c->ssl_cb = cbfunc; c->ssl_cb_arg = userArg;
+    return CELL_OK;
+}
+
+s32 cellHttpClientCloseAllConnections(CellHttpClientId clientId)
+{
+    HttpClientSlot* c; s32 r = http_client_get(clientId, &c);
+    if (r != CELL_OK) return r;
+    for (u32 i = 0; i < CELL_HTTP_MAX_TRANSACTIONS; i++)
+        if (s_transactions[i].in_use && s_transactions[i].client == clientId)
+            http_close_slot_socket(&s_transactions[i]);
+    return CELL_OK;
+}
+
+/* (clientId, CellHttpTransId* transId, s64 usec): waits until one of the client's open connections is readable and
+ * names its transaction. With no open connection (always, offline) there is nothing to wait for: NO_CONNECTION and
+ * *transId untouched (ASSUMPTION: the SDK's answer for an idle client). A wait that times out is the select base with
+ * ETIMEDOUT (60) (ASSUMPTION). usec < 0 waits without a limit. */
+s32 cellHttpClientPollConnections(CellHttpClientId clientId, u32 transId, s64 usec)
+{
+    HttpClientSlot* c; s32 r = http_client_get(clientId, &c);
+    if (r != CELL_OK) return r;
+    if (!transId) return (s32)CELL_HTTP_ERROR_NO_BUFFER;   /* ASSUMPTION: as the other NULL out-params */
+    fd_set rd;
+    FD_ZERO(&rd);
+    int any = 0;
+    http_socket_t hi = 0;
+    for (u32 i = 0; i < CELL_HTTP_MAX_TRANSACTIONS; i++)
+        if (s_transactions[i].in_use && s_transactions[i].client == clientId && s_transactions[i].sock != HTTP_INVALID_SOCKET) {
+            FD_SET(s_transactions[i].sock, &rd);
+            if (s_transactions[i].sock > hi) hi = s_transactions[i].sock;
+            any = 1;
+        }
+    if (!any) return (s32)CELL_HTTP_ERROR_NO_CONNECTION;
+    struct timeval tv, *ptv = NULL;
+    if (usec >= 0) { tv.tv_sec = (long)(usec / 1000000); tv.tv_usec = (long)(usec % 1000000); ptv = &tv; }
+    int n = select((int)hi + 1, &rd, NULL, NULL, ptv);
+    if (n <= 0) return (s32)(CELL_HTTP_ERROR_NET_SELECT | 60u);
+    for (u32 i = 0; i < CELL_HTTP_MAX_TRANSACTIONS; i++)
+        if (s_transactions[i].in_use && s_transactions[i].client == clientId
+            && s_transactions[i].sock != HTTP_INVALID_SOCKET && FD_ISSET(s_transactions[i].sock, &rd)) {
+            vm_write32(transId, i);
+            return CELL_OK;
+        }
+    return (s32)CELL_HTTP_ERROR_NO_CONNECTION;
+}
+
+/* (transId, u64 totalSize): the SDK name of cellHttpSetRequestContentLength; BAD_TRANS for an unknown id. */
+s32 cellHttpRequestSetContentLength(CellHttpTransId transId, u64 totalSize)
+{
+    if (!s_http_initialized) return (s32)CELL_HTTP_ERROR_NOT_INITIALIZED;
+    if (transId >= CELL_HTTP_MAX_TRANSACTIONS || !s_transactions[transId].in_use) return (s32)CELL_HTTP_ERROR_BAD_TRANS;
+    s_transactions[transId].request_content_length     = totalSize;
+    s_transactions[transId].request_content_length_set = 1;
+    return CELL_OK;
+}
