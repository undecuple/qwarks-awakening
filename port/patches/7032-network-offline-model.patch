+
+/* (u32 ctx_id, const char* product_id, sys_memory_container_t container, const SceNpCommerce2ProductBrowseParam* param) */
+s32 sceNpCommerce2DoProductBrowseStartAsync(u32 ctx_id, u32 product_id, u32 container, u32 param)
+{
