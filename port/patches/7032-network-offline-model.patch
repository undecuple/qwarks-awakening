+s32 sceNpLookupNpIdAsync(s32 transId, u32 onlineId, u32 npId, s32 prio, u32 option)
+{
+    (void)prio; (void)option;
+    if (!s_lookup_init) return (s32)SCE_NP_COMMUNITY_ERROR_NOT_INITIALIZED;
+    if (!onlineId) return (s32)SCE_NP_COMMUNITY_ERROR_INSUFFICIENT_ARGUMENT;
+    if (!trans_ok(transId)) return (s32)SCE_NP_COMMUNITY_ERROR_INVALID_ID;
+    if (!np_signed_in()) return (s32)SCE_NP_COMMUNITY_ERROR_INVALID_ONLINE_ID;
+    if (npId) {
+        memset(vm_ptr8(npId), 0, 36);
+        memcpy(vm_ptr8(npId), vm_ptr8(onlineId), 16);
+    }
