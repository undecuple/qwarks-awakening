+/* ---------------------------------------------------------------------------
+ * R&C 7032: the game update check (cellGameUpdate*, exported by the cellNetCtl library; A Crack in Time 1.20,
+ * All 4 One 1.03, Into the Nexus 1.01, Full Frontal Assault 1.05 import it). Error names/values and the callback
+ * shape (status, error_code, userdata) as [src:rpcs3-cellnetctl]. The check asks the update server for a newer
+ * patch; with no link it cannot reach it, so the start callback reports RESULT_STATUS_ERROR with
+ * CELL_NET_CTL_ERROR_NET_NOT_CONNECTED (ASSUMPTION: the console's offline answer; RPCS3 answers NO_UPDATE without
+ * asking). With the online switch on there is still no update server for a port: NO_UPDATE (ASSUMPTION). Finish
+ * reports FINISHED. Callbacks run from the title's next cellSysutilCheckCallback, as the console's do.
+ * -----------------------------------------------------------------------*/
+#define CELL_GAMEUPDATE_ERROR_NOT_INITIALIZED      0x8002cc01
+#define CELL_GAMEUPDATE_ERROR_ALREADY_INITIALIZED  0x8002cc02
+#define CELL_GAMEUPDATE_ERROR_INVALID_ADDR         0x8002cc03
+#define CELL_GAMEUPDATE_ERROR_BUSY                 0x8002cc07
+#define CELL_GAMEUPDATE_ERROR_NOT_START            0x8002cc08
+#define CELL_GAMEUPDATE_RESULT_STATUS_NO_UPDATE    0
+#define CELL_GAMEUPDATE_RESULT_STATUS_ERROR        3
+#define CELL_GAMEUPDATE_RESULT_STATUS_FINISHED     5
+#define CELL_NET_CTL_ERROR_NET_NOT_CONNECTED_      0x80130182u
+
+static int s_gameupdate_init, s_gameupdate_started;
+
+static void gameupdate_callback(u32 cb, s32 status, u32 error_code, u32 userdata)
+{
+    const u64 args[8] = { (u64)(u32)status, (u64)error_code, (u64)userdata, 0, 0, 0, 0, 0 };
+    cellSysutilQueueGuestCallbackArgs(cb, args);
+}
+
+s32 cellGameUpdateInit(void)
+{
+    if (s_gameupdate_init) return (s32)CELL_GAMEUPDATE_ERROR_ALREADY_INITIALIZED;
+    s_gameupdate_init = 1;
+    s_gameupdate_started = 0;
+    return CELL_OK;
+}
+
+s32 cellGameUpdateTerm(void)
+{
+    if (!s_gameupdate_init) return (s32)CELL_GAMEUPDATE_ERROR_NOT_INITIALIZED;
+    s_gameupdate_init = s_gameupdate_started = 0;
+    return CELL_OK;
+}
+
+static s32 gameupdate_start(u32 cb_func, u32 userdata)
+{
+    if (!s_gameupdate_init) return (s32)CELL_GAMEUPDATE_ERROR_NOT_INITIALIZED;
+    if (!cb_func) return (s32)CELL_GAMEUPDATE_ERROR_INVALID_ADDR;
+    if (s_gameupdate_started) return (s32)CELL_GAMEUPDATE_ERROR_BUSY;   /* ASSUMPTION: one check at a time */
+    s_gameupdate_started = 1;
+    if (netctl_online())
+        gameupdate_callback(cb_func, CELL_GAMEUPDATE_RESULT_STATUS_NO_UPDATE, CELL_OK, userdata);
+    else
+        gameupdate_callback(cb_func, CELL_GAMEUPDATE_RESULT_STATUS_ERROR, CELL_NET_CTL_ERROR_NET_NOT_CONNECTED_, userdata);
+    printf("[cellNetCtl] GameUpdateCheckStart -> %s\n", netctl_online() ? "no update" : "error: not connected");
+    return CELL_OK;
+}
+
+/* (const CellGameUpdateParam* param, CellGameUpdateCallback cb_func, void* userdata) */
+s32 cellGameUpdateCheckStartAsync(u32 param, u32 cb_func, u32 userdata)
+{
+    (void)param;   /* { u32 size; u32 cid; }: only the dialog's look depends on it */
+    return gameupdate_start(cb_func, userdata);
+}
+
+/* (CellGameUpdateCallback cb_func, void* userdata) */
+s32 cellGameUpdateCheckStartWithoutDialogAsync(u32 cb_func, u32 userdata)
+{
+    return gameupdate_start(cb_func, userdata);
+}
+
+/* (CellGameUpdateCallback cb_func, void* userdata): ends a started check. */
+s32 cellGameUpdateCheckFinishAsync(u32 cb_func, u32 userdata)
+{
+    if (!s_gameupdate_init) return (s32)CELL_GAMEUPDATE_ERROR_NOT_INITIALIZED;
+    if (!cb_func) return (s32)CELL_GAMEUPDATE_ERROR_INVALID_ADDR;
+    if (!s_gameupdate_started) return (s32)CELL_GAMEUPDATE_ERROR_NOT_START;
+    s_gameupdate_started = 0;
+    gameupdate_callback(cb_func, CELL_GAMEUPDATE_RESULT_STATUS_FINISHED, CELL_OK, userdata);
+    return CELL_OK;
+}
