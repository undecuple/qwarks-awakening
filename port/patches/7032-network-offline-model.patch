+/* ---- R&C 7032: the client settings A Crack in Time 1.20, All 4 One 1.03, Into the Nexus 1.01 and Full Frontal Assault
+ * 1.05 import (NIDs = ps3_compute_nid(name)). Checks and error names as [src:rpcs3-cellhttp]: NOT_INITIALIZED before
+ * cellHttpInit, BAD_CLIENT for an id no cellHttpCreateClient returned, NO_BUFFER for a NULL string/header. Each
+ * setting is a local operation a console with no link performs too, so it is stored and answers CELL_OK; the
+ * transactions read the timeouts and the headers (the other settings only shape a connection that offline never
+ * opens). */
+static s32 http_client_get(CellHttpClientId clientId, HttpClientSlot** out)
+{
+    if (!s_http_initialized) return (s32)CELL_HTTP_ERROR_NOT_INITIALIZED;
+    if (clientId >= CELL_HTTP_MAX_CLIENTS || !s_clients[clientId].in_use) return (s32)CELL_HTTP_ERROR_BAD_CLIENT;
+    *out = &s_clients[clientId];
+    return CELL_OK;
+}
+
+/* Adds or replaces (case-insensitive name) one client header; the value is a guest string. */
+static s32 http_client_put_header(HttpClientSlot* c, const char* name, u32 value_ea)
+{
+    u32 i = 0;
+    while (i < c->header_count && http_name_eq(c->headers[i].name, name)) i++;
+    if (i == c->header_count) {
+        if (c->header_count >= CELL_HTTP_MAX_CLIENT_HEADERS) return (s32)CELL_HTTP_ERROR_NO_MEMORY;
+        c->header_count++;
+    }
+    snprintf(c->headers[i].name, sizeof(c->headers[i].name), "%s", name);
+    snprintf(c->headers[i].value, sizeof(c->headers[i].value), "%s", (const char*)vm_base + value_ea);
+    for (char* p = c->headers[i].value; *p; p++) if (*p == '\r' || *p == '\n') *p = ' ';   /* no header injection */
+    return CELL_OK;
+}
+
+/* (clientId, const char* userAgent) */
+s32 cellHttpClientSetUserAgent(CellHttpClientId clientId, u32 userAgent)
+{
+    HttpClientSlot* c; s32 r = http_client_get(clientId, &c);
+    if (r != CELL_OK) return r;
+    if (!userAgent) return (s32)CELL_HTTP_ERROR_NO_BUFFER;
+    return http_client_put_header(c, "User-Agent", userAgent);
+}
+
+/* (clientId, const CellHttpHeader* header): header = guest { u32 name; u32 value; } */
+s32 cellHttpClientSetHeader(CellHttpClientId clientId, u32 header)
+{
+    HttpClientSlot* c; s32 r = http_client_get(clientId, &c);
+    if (r != CELL_OK) return r;
+    if (!header) return (s32)CELL_HTTP_ERROR_NO_BUFFER;
+    u32 nea = vm_read32(header), vea = vm_read32(header + 4u);
+    if (!nea || !vea) return (s32)CELL_HTTP_ERROR_NO_BUFFER;   /* ASSUMPTION: a NULL field is the same NO_BUFFER */
+    char name[128];
+    snprintf(name, sizeof(name), "%s", (const char*)vm_base + nea);
+    if (!name[0] || strpbrk(name, ":\r\n")) return (s32)CELL_HTTP_ERROR_INVALID_VALUE;   /* ASSUMPTION */
+    return http_client_put_header(c, name, vea);
+}
+
+/* (clientId, const CellHttpUri* proxy): NULL clears the proxy; a proxy needs a host name. Offline nothing connects
+ * through it, so only the check is made (CellHttpUri: hostname EA at +4). */
+s32 cellHttpClientSetProxy(CellHttpClientId clientId, u32 proxy)
+{
+    HttpClientSlot* c; s32 r = http_client_get(clientId, &c);
+    if (r != CELL_OK) return r;
+    if (proxy) {
+        u32 host = vm_read32(proxy + 4u);
+        if (!host || !vm_read8(host)) return (s32)CELL_HTTP_ERROR_INVALID_URI;
+    }
+    return CELL_OK;
+}
+
+s32 cellHttpClientSetVersion(CellHttpClientId clientId, u32 major, u32 minor)
+{
+    HttpClientSlot* c; s32 r = http_client_get(clientId, &c);
+    if (r != CELL_OK) return r;
+    c->version_major = major; c->version_minor = minor;
+    return CELL_OK;
+}
+
+s32 cellHttpClientSetAutoRedirect(CellHttpClientId clientId, u32 enable)
+{
+    HttpClientSlot* c; s32 r = http_client_get(clientId, &c);
+    if (r == CELL_OK) c->auto_redirect = (u8)(enable & 0xFF) != 0;
+    return r;
+}
