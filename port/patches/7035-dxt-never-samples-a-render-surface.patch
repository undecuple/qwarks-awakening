--- /dev/null
+++ b/libs/video/rsx_dxt_alias.h
@@ -0,0 +1,25 @@
+/* R&C patch 7035: a block-compressed texture is never a render target's output.
+ *
+ * No RSX colour surface format is block-compressed (SURFACE_FORMAT colour formats are X1R5G5B5 .. A8B8G8R8, B8, G8B8,
+ * the float formats), so a DXT1/DXT23/DXT45 texture at a surface's address reads the guest bytes there as blocks; it
+ * never shows the surface's picture. Live draw's bind loop matched textures to colour surfaces by address alone and
+ * bound the whole surface. Tools of Destruction binds a 16x16 DXT1 at VRAM offset 0 (the display buffer 0:0x0, a
+ * 1280x704 surface) as the "no texture" unit of many scene materials (ToD Fastoon, tods-gfx-cap3 frame 10016:
+ * unit 2 of 562 draws of PSO 2e66e764, whose program writes the colour output's alpha from that unit's blue): the
+ * scene's alpha became the last frame's blue, the bloom bright pass (alpha-weighted) lit most of the frame, and wall
+ * panels that map the unit over their faces showed the last frame, HUD prompt included, upside down.
+ * Upstream ps3recomp PR #508 makes the same rule for rsx_draw_engine.c; this is live draw's bind loop.
+ * Pure function so a host test can check it (port/rc/tests/run_dxt_alias_test.sh). */
+#ifndef RSX_DXT_ALIAS_H
+#define RSX_DXT_ALIAS_H
+#include <stdint.h>
+
+/* 1 when a texture of this SET_TEXTURE_FORMAT format byte (LN/UN modifier bits allowed) may sample a render surface
+ * at its address; 0 for the compressed formats DXT1 (0x86), DXT23 (0x87), DXT45 (0x88). */
+static inline int ld_tex_may_alias_surface(uint32_t format)
+{
+    const uint32_t base = format & 0x9Fu;   /* RSX_TEX_FMT_BASE_MASK: the LN (0x20) and UN (0x40) bits off */
+    return !(base == 0x86u || base == 0x87u || base == 0x88u);
+}
+
+#endif
