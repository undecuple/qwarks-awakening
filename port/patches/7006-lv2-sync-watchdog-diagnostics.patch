+                fprintf(stderr, "[lv2-sync] destroy of a busy %s by tid %llu lr=0x%08X\n", mb,
+                        (unsigned long long)ctx->thread_id, (uint32_t)ctx->lr);
+            }
+        }
+    }
+    s_mtx_destroys[mutex_id - 1]++;
 #ifdef _WIN32
     DeleteCriticalSection(&m->cs);
     if (m->wait_handle) CloseHandle(m->wait_handle);
@@ -195,6 +271,7 @@
         return (int64_t)(int32_t)CELL_EDEADLK;
     }
 
+    lv2_sync_phase(caller_tid, 1, mutex_id);   /* patch 7006 */
 #ifdef _WIN32
     if (timeout_us == 0) {
         /* Infinite wait */
@@ -210,6 +287,7 @@
         int64_t deadline = lv2_usec_deadline(timeout_us);
         while (!TryEnterCriticalSection(&m->cs)) {
             if (lv2_deadline_passed(deadline)) {
+                lv2_sync_phase(caller_tid, 0, 0);
                 return (int64_t)(int32_t)CELL_ETIMEDOUT;
             }
             if (timeout_us < 1000) SwitchToThread();
@@ -230,11 +308,13 @@
         }
         int rc = pthread_mutex_timedlock(&m->mtx, &ts);
         if (rc == ETIMEDOUT) {
+            lv2_sync_phase(caller_tid, 0, 0);
             return (int64_t)(int32_t)CELL_ETIMEDOUT;
         }
     }
 #endif
 
+    lv2_sync_phase(caller_tid, 0, 0);
     m->owner_tid = caller_tid;
     m->lock_count++;
     return CELL_OK;
