+/* R&C patch 7099: unwindable call frames for a job kernel's job call.
+ *
+ * A lifted `bisl` is a host call bracket: host_depth++, the callee, then a drain that waits for the guest to come back
+ * at the bracket's return address. When a guest routine deeper inside the callee leaves through the return address
+ * of an OUTER bracket (a job's exit/yield path that branches to the kernel's job-call return, from two calls deep),
+ * the inner brackets' guest frames are gone but their host frames stay open: the drain continuation paths (the
+ * patch 7039 interpreter fallback, the resolver's) then run the kernel's code inside the innermost job bracket, and
+ * every later job call nests on top of it. A4O 1.03 luminopolis: lane 0's host_depth rose 351 -> 737 -> 1123 -> 1514
+ * at the kernel's idle (pc 0x3F750, sp 0x3F450 every time), ~386 per burst (SPU notes 2026-11-18).
+ *
+ * The fix: a bisl lifted with --framed-bisl (the ig job kernels') pushes a frame {return_pc, depth, jmp_buf} on the
+ * context; whenever the guest reaches the return pc of an open frame with host_depth above that frame's depth, the
+ * continuation paths longjmp to it: the dead host frames are dropped, the depth is the frame's again and the kernel
+ * continues in its own bracket. The innermost frame with a matching return pc decides (its own drain sees
+ * depth == frame depth: no unwind). Pure header: the frame list and the match, host-testable. */
+#ifndef SPU_CALL_FRAME_H
+#define SPU_CALL_FRAME_H
+
+#include <setjmp.h>
+#include <stdint.h>
+
+typedef struct spu_call_frame {
+    jmp_buf                env;
+    struct spu_call_frame* prev;
+    uint32_t               return_pc;     /* LS address, masked */
+    uint32_t               depth;         /* host_depth inside the bracket (after its ++) */
+    int                    image_id;
+    void*                  irq_frame;     /* ctx->irq_frame at entry: deeper drains' frames die with the unwind */
+    uint32_t               drain_ret_pc;  /* ctx->drain_ret_pc at entry */
+} spu_call_frame;
+
+/* The open frame the guest's arrival at `pc` (masked) with host depth `depth` unwinds to, or 0. */
+static inline spu_call_frame* spu_call_frame_match(spu_call_frame* top, uint32_t pc, uint32_t depth)
+{
+    for (spu_call_frame* f = top; f; f = f->prev)
+        if (f->return_pc == pc)
+            return depth > f->depth ? f : 0;
+    return 0;
+}
+
+#endif /* SPU_CALL_FRAME_H */
