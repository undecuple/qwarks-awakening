diff --git a/runtime/spu/tests/test_spu_call_frame.c b/runtime/spu/tests/test_spu_call_frame.c
new file mode 100644
index 0000000..c95305e
--- /dev/null
+++ b/runtime/spu/tests/test_spu_call_frame.c
@@ -0,0 +1,121 @@
+/* R&C patch 7099 host test: a synthetic job kernel whose job leaves through the kernel's job-call return
+ * (0x3F8F4) from two calls deep. The lifted shapes are modelled one to one: a bracket is host_depth++, the callee,
+ * a drain that waits for its return pc, host_depth--; SPU_RET publishes r0 and host-returns; the drain's
+ * continuation for a foreign pc (the patch 7039 interpreter fallback) runs the kernel on from 0x3F8F4 inside the
+ * bracket that saw it. With 7099 the kernel's job call is framed (spu_bisl_framed) and the drain unwinds to it
+ * (spu_call_frame_check), as in spu_drain.c. Build with -DNO_7099 for the pre-patch shape: host_depth at the
+ * kernel's idle grows by 2 per job, and this test FAILS. Without it: depth 0 at every idle, PASS.
+ *   cc -std=gnu17 -Wall -Wextra -I runtime/spu runtime/spu/tests/test_spu_call_frame.c && ./a.out */
+#include <setjmp.h>
+#include <stdio.h>
+#include <stdint.h>
+#include "spu_call_frame.h"
+
+#define KERNEL_JOBCALL_RET 0x3F8F4u
+#define JOB_A_RET 0x01010u
+#define JOB_B_RET 0x01020u
+#define NJOBS 6
+
+typedef struct {
+    uint32_t pc, r0, host_depth;
+    void* call_frame;
+    int jobs_left, done, idle_n, unwinds;
+    uint32_t idle_depth[NJOBS + 2];
+} ctx_t;
+
+static int fails, passes;
+#define CHECK(c, ...) do { if (c) passes++; else { fails++; printf("FAIL: " __VA_ARGS__); printf("\n"); } } while (0)
+
+static void kernel_after_job(ctx_t* ctx);
+
+#ifndef NO_7099
+/* spu_call_frame_check (spu_drain.c) */
+static void call_frame_check(ctx_t* ctx)
+{
+    spu_call_frame* f = spu_call_frame_match((spu_call_frame*)ctx->call_frame, ctx->pc, ctx->host_depth);
+    if (f) { ctx->unwinds++; longjmp(f->env, 1); }
+}
+#endif
+
+/* spu_drain_call_body: the callee came back; pc == return_pc ends the bracket, else the continuation runs here */
+static void drain(ctx_t* ctx, uint32_t return_pc)
+{
+#ifndef NO_7099
+    if (ctx->call_frame) call_frame_check(ctx);
+#endif
+    if (ctx->pc == return_pc || ctx->done) return;
+    if (ctx->pc == KERNEL_JOBCALL_RET)   /* no lifted entry there: interpret on into the lifted kernel loop */
+        kernel_after_job(ctx);
+}
+
+/* job helper B (two calls deep): the job's exit, `lqd $r0` from the job entry's frame, `bi $r0` (SPU_RET) */
+static void job_helper_b(ctx_t* ctx) { ctx->r0 = KERNEL_JOBCALL_RET; ctx->pc = ctx->r0; }
+static void job_helper_a(ctx_t* ctx)
+{
+    ctx->r0 = JOB_B_RET; ctx->host_depth++; job_helper_b(ctx); drain(ctx, JOB_B_RET); ctx->host_depth--;
+    ctx->pc = ctx->r0 = 0xDEAD0;   /* not reached on hardware: the guest left this frame */
+}
+static void job_entry(ctx_t* ctx)
+{
+    ctx->r0 = JOB_A_RET; ctx->host_depth++; job_helper_a(ctx); drain(ctx, JOB_A_RET); ctx->host_depth--;
+    ctx->pc = KERNEL_JOBCALL_RET;
+}
+
+#ifndef NO_7099
+/* spu_bisl_framed (spu_drain.c) */
+static void bisl_framed(ctx_t* ctx, uint32_t return_pc, void (*callee)(ctx_t*))
+{
+    spu_call_frame f;
+    f.prev = (spu_call_frame*)ctx->call_frame; f.return_pc = return_pc; f.depth = ctx->host_depth;
+    f.image_id = -1; f.irq_frame = 0; f.drain_ret_pc = 0;
+    ctx->call_frame = &f;
+    if (setjmp(f.env) == 0) callee(ctx);
+    else { ctx->host_depth = f.depth; ctx->pc = f.return_pc; }
+    ctx->call_frame = f.prev;
+}
+#endif
+
+/* the lifted kernel from its job-call return 0x3F8F4: idle, then the next job call (bisl @0x3F8F0) */
+static void kernel_after_job(ctx_t* ctx)
+{
+    for (;;) {
+        if (ctx->idle_n < NJOBS + 2) ctx->idle_depth[ctx->idle_n++] = ctx->host_depth;   /* pc 0x3F750 */
+        if (ctx->jobs_left == 0) { ctx->done = 1; return; }
+        ctx->jobs_left--;
+        ctx->r0 = KERNEL_JOBCALL_RET; ctx->host_depth++;
+#ifndef NO_7099
+        bisl_framed(ctx, KERNEL_JOBCALL_RET, job_entry);
+#else
+        job_entry(ctx);
+#endif
+        drain(ctx, KERNEL_JOBCALL_RET); ctx->host_depth--;
+        if (ctx->done) return;
+    }
+}
+
+int main(void)
+{
+    ctx_t c = {0};
+    c.jobs_left = NJOBS;
+    kernel_after_job(&c);
+    CHECK(c.done && c.jobs_left == 0, "all %d jobs ran (left %d)", NJOBS, c.jobs_left);
+    CHECK(c.idle_n == NJOBS + 1, "kernel idled %d times, want %d", c.idle_n, NJOBS + 1);
+    for (int i = 0; i < c.idle_n; i++)
+        CHECK(c.idle_depth[i] == 0, "host_depth at kernel idle %d is %u, want 0", i, c.idle_depth[i]);
+    CHECK(c.host_depth == 0, "host_depth after the kernel is %u, want 0", c.host_depth);
+    CHECK(c.call_frame == 0, "no frame left open");
+#ifndef NO_7099
+    CHECK(c.unwinds == NJOBS, "one unwind per job exit (%d)", c.unwinds);
+    {   /* the match: innermost frame with the pc decides; its own depth does not unwind */
+        spu_call_frame o = {0}, i = {0};
+        o.return_pc = KERNEL_JOBCALL_RET; o.depth = 1; i.prev = &o; i.return_pc = 0x2000; i.depth = 3;
+        CHECK(spu_call_frame_match(&i, KERNEL_JOBCALL_RET, 4) == &o, "outer frame found from depth 4");
+        CHECK(spu_call_frame_match(&i, KERNEL_JOBCALL_RET, 1) == 0, "own depth: no unwind");
+        CHECK(spu_call_frame_match(&i, 0x2000, 3) == 0, "inner frame at its own depth: no unwind");
+        CHECK(spu_call_frame_match(&i, 0x2000, 5) == &i, "inner frame from deeper");
+        CHECK(spu_call_frame_match(&i, 0x3000, 9) == 0, "unknown pc: no unwind");
+    }
+#endif
+    printf("%d passed, %d failed\n", passes, fails);
+    return fails ? 1 : 0;
+}
