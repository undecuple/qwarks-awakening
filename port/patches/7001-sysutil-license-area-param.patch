Report the licence area (system parameter 0x0122): without it the id fell to the unknown-id branch and read 0, which is
CELL_SYSUTIL_LICENSE_AREA_J, so a US disc picked the Japanese variants of its assets.
$PS3_LICENSE_AREA overrides; default North America (ASSUMPTION).

diff --git a/libs/system/cellSysutil.h b/libs/system/cellSysutil.h
--- a/libs/system/cellSysutil.h
+++ b/libs/system/cellSysutil.h
@@ -27,7 +27,17 @@
 #define CELL_SYSUTIL_SYSTEMPARAM_ID_TIMEZONE             0x0116
 #define CELL_SYSUTIL_SYSTEMPARAM_ID_SUMMERTIME           0x0117
 #define CELL_SYSUTIL_SYSTEMPARAM_ID_GAME_PARENTAL_LEVEL  0x0121
+#define CELL_SYSUTIL_SYSTEMPARAM_ID_LICENSE_AREA         0x0122
 #define CELL_SYSUTIL_SYSTEMPARAM_ID_GAME_PARENTAL_LEVEL0_RESTRICT  0x0123
+
+/* CELL_SYSUTIL_SYSTEMPARAM_ID_LICENSE_AREA values */
+#define CELL_SYSUTIL_LICENSE_AREA_J      0   /* SCEJ */
+#define CELL_SYSUTIL_LICENSE_AREA_A      1   /* SCEA (North America) */
+#define CELL_SYSUTIL_LICENSE_AREA_E      2   /* SCEE (Europe, Oceania, Russia) */
+#define CELL_SYSUTIL_LICENSE_AREA_H      3   /* SCEH */
+#define CELL_SYSUTIL_LICENSE_AREA_K      4   /* SCEK */
+#define CELL_SYSUTIL_LICENSE_AREA_C      5   /* SCH */
+#define CELL_SYSUTIL_LICENSE_AREA_OTHER  100
 #define CELL_SYSUTIL_SYSTEMPARAM_ID_CURRENT_USER_HAS_NP_ACCOUNT    0x0141
 #define CELL_SYSUTIL_SYSTEMPARAM_ID_CAMERA_PLFREQ        0x0151
 #define CELL_SYSUTIL_SYSTEMPARAM_ID_PAD_RUMBLE           0x0152
diff --git a/libs/system/cellSysutil.c b/libs/system/cellSysutil.c
--- a/libs/system/cellSysutil.c
+++ b/libs/system/cellSysutil.c
@@ -443,6 +443,13 @@
     case CELL_SYSUTIL_SYSTEMPARAM_ID_SUMMERTIME:     v = 0; break; /* No DST */
     case CELL_SYSUTIL_SYSTEMPARAM_ID_GAME_PARENTAL_LEVEL:           v = 0; break;
     case CELL_SYSUTIL_SYSTEMPARAM_ID_GAME_PARENTAL_LEVEL0_RESTRICT: v = 0; break;
+    case CELL_SYSUTIL_SYSTEMPARAM_ID_LICENSE_AREA: {
+        /* The console's licence area (a game picks region variants of its assets by it). $PS3_LICENSE_AREA (a number,
+         * the CELL_SYSUTIL_LICENSE_AREA_* values) wins; ASSUMPTION: without it, North America. */
+        const char* e = getenv("PS3_LICENSE_AREA");
+        v = (e && *e) ? (s32)atoi(e) : CELL_SYSUTIL_LICENSE_AREA_A;
+        break;
+    }
     case CELL_SYSUTIL_SYSTEMPARAM_ID_CURRENT_USER_HAS_NP_ACCOUNT:   v = 1; break;
     case CELL_SYSUTIL_SYSTEMPARAM_ID_CAMERA_PLFREQ:  v = 0; break; /* 60Hz */
     case CELL_SYSUTIL_SYSTEMPARAM_ID_PAD_RUMBLE:     v = 1; break; /* Rumble on */
