+/* R&C patch 7034: the signal notification registers of a SPURS instance's SPUs. On hardware every SPU of the
+ * instance is an SPU thread with its own SNR1/SNR2, and the PPU may write them with sys_spu_thread_write_snr on the
+ * thread ids cellSpursGetInfo returns (A Crack in Time writes SNR1 = i to SPU i, @0x0069546C, and its igPm policy
+ * module reads it with `rdch SPU_RdSigNotify1` as its SPU index). Here the SPUs are kernel threads that run policy
+ * modules in per-(workload, SPU) contexts, so the register lives in this table, per (instance, SPU): a write goes
+ * into the context running on that SPU (and wakes it), else it stays pending; a run takes the pending value into
+ * its context on entry and gives back what it did not read on exit. Overwrite mode unless or_mode (spu_cfg). */
+enum { SPURS_SNR_INST = 8, SPURS_SNR_SPU = 8 };
+static struct { uint32_t ea; uint32_t val[SPURS_SNR_SPU][2]; uint8_t pend[SPURS_SNR_SPU][2];
+                spu_context* cur[SPURS_SNR_SPU]; } s_snr[SPURS_SNR_INST];
+static volatile long s_snr_lock;
+#define SNR_LOCK()   while (__atomic_exchange_n(&s_snr_lock, 1, __ATOMIC_ACQUIRE)) {}
+#define SNR_UNLOCK() __atomic_store_n(&s_snr_lock, 0, __ATOMIC_RELEASE)
+static int spurs_snr_slot(uint32_t spurs_ea)   /* under the lock */
+{
+    for (int i = 0; i < SPURS_SNR_INST; i++) if (s_snr[i].ea == spurs_ea) return i;
+    for (int i = 0; i < SPURS_SNR_INST; i++) if (!s_snr[i].ea) { s_snr[i].ea = spurs_ea; return i; }
+    return -1;
+}
+static void spurs_snr_put(spu_channel* ch, uint32_t val, int or_mode)   /* a 1-deep register, not a queue */
+{
+    SPU_CH_LOCK(ch);
+    if (ch->count && or_mode) ch->value |= val; else ch->value = val;
+    ch->head = 0; ch->q[0] = ch->value; ch->count = 1;
+    SPU_CH_UNLOCK(ch);
+}
+int spurs_pm_snr_write(uint32_t spurs_ea, uint32_t spu, uint32_t num, uint32_t val, int or_mode)
+{
+    if (spu >= SPURS_SNR_SPU || num > 1) return -1;
+    SNR_LOCK();
+    const int s = spurs_snr_slot(spurs_ea);
+    if (s < 0) { SNR_UNLOCK(); return -1; }
+    spu_context* c = s_snr[s].cur[spu];
+    if (c) spurs_snr_put(&c->ch_sig_notify[num], val, or_mode);
+    else {
+        s_snr[s].val[spu][num] = (s_snr[s].pend[spu][num] && or_mode) ? (s_snr[s].val[spu][num] | val) : val;
+        s_snr[s].pend[spu][num] = 1;
+    }
+    SNR_UNLOCK();
+    if (c) { extern void spu_ch_wake(spu_context*); spu_ch_wake(c); }
+    return 0;
+}
+static void spurs_snr_enter(uint32_t spurs_ea, uint32_t spu, spu_context* ctx)
+{
+    if (spu >= SPURS_SNR_SPU) return;
+    SNR_LOCK();
+    const int s = spurs_snr_slot(spurs_ea);
+    if (s >= 0) {
+        s_snr[s].cur[spu] = ctx;
+        for (int n = 0; n < 2; n++) {
+            spu_channel* ch = &ctx->ch_sig_notify[n];
+            SPU_CH_LOCK(ch); ch->count = 0; ch->head = 0; SPU_CH_UNLOCK(ch);   /* the register belongs to the SPU */
+            if (s_snr[s].pend[spu][n]) { spurs_snr_put(ch, s_snr[s].val[spu][n], 0); s_snr[s].pend[spu][n] = 0; }
+        }
+    }
+    SNR_UNLOCK();
+}
+static void spurs_snr_leave(uint32_t spurs_ea, uint32_t spu, spu_context* ctx)
+{
+    if (spu >= SPURS_SNR_SPU) return;
+    SNR_LOCK();
+    const int s = spurs_snr_slot(spurs_ea);
+    if (s >= 0 && s_snr[s].cur[spu] == ctx) {
+        s_snr[s].cur[spu] = NULL;
+        for (int n = 0; n < 2; n++) {
+            spu_channel* ch = &ctx->ch_sig_notify[n];
+            SPU_CH_LOCK(ch);
+            if (ch->count) { s_snr[s].val[spu][n] = ch->value; s_snr[s].pend[spu][n] = 1; }
+            ch->count = 0; ch->head = 0;
+            SPU_CH_UNLOCK(ch);
+        }
+    }
+    SNR_UNLOCK();
+}
+#undef SNR_LOCK
+#undef SNR_UNLOCK
+
+/* R&C patch 7034: a policy module with no lift runs in the SPU interpreter from its load base, as the SPU would run
+ * it (cellSpurs.c spurs_resolve_pm gives it this entry and image id -1: pure interpretation, never a rejoin into
+ * another image's lifted functions). A Crack in Time's igPm workload (a 0x230-byte loader that DMAs Insomniac's job
+ * kernel to LS 0x3F580 and runs it) had no lift, so wid 2 of its "ig" instance never ran. */
+void SPU_ABI spurs_pm_interp_entry(spu_context* ctx)
+{
+    extern uint32_t spu_interp_run(spu_context*, uint32_t);
+    spu_interp_run(ctx, 0xA00);
+}
 void spu_pm_ctx_describe(void* p, char* out, int n)
 {
     spu_context* c = (spu_context*)p;
@@ -464,7 +551,9 @@
     g_kz3_pm_run_t0 = kz3_pm_run_budget_ms() ? kz3_pm_now_ms() : 0;   /* patch 1048 */
