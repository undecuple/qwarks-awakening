@@ -0,0 +1,41 @@
+/* R&C patch 7016: polygon offset as dynamic state (ID3D12GraphicsCommandList9::RSSetDepthBias).
+ *
+ * The PSO key held the raw float bits of POLY_OFFSET_SCALE / POLY_OFFSET_BIAS (patch 2006), and D3D12 bakes
+ * the depth bias into the PSO. A title that recomputes its shadow bias every frame (ToD's character shadow
+ * maps from frame ~2616 on Fastoon, tods-play-1140) then gets a new key, a new PSO and a create wait (~37 ms)
+ * on every changed value: 1,132 PSOs over 256 frames, 42 s of creates, no new shaders. With
+ * D3D12_OPTIONS16.DynamicDepthBiasSupported the PSO carries D3D12_PIPELINE_STATE_FLAG_DYNAMIC_DEPTH_BIAS and
+ * only "offset on" in its key; the values go to RSSetDepthBias per draw. Without the feature (or with
+ * LD_NO_DYN_BIAS=1) the key and the PSO are as before. Pure functions here so a host test can check them. */
+#ifndef RSX_DYN_BIAS_H
+#define RSX_DYN_BIAS_H
+#include <stdint.h>
+#include <string.h>
+
+#define LD_DYNB_KEY_TAG   0x44594E42u   /* "DYNB": key value for "offset on, values dynamic" */
+#define LD_PSO_FLAG_DYNAMIC_DEPTH_BIAS 0x4u   /* D3D12_PIPELINE_STATE_FLAG_DYNAMIC_DEPTH_BIAS (Agility 1.608+) */
+
+/* The key's view of the offset words: unchanged without dynamic bias; with it, one tag when the offset is on
+ * (any non-zero word) and zero when it is off, so every bias value maps to the same PSO. */
+static inline void ld_dynb_key_bits(uint32_t* scale_bits, uint32_t* bias_bits, int dynamic)
+{
+    if (!dynamic) return;
+    const int on = (*scale_bits | *bias_bits) != 0;
+    *scale_bits = on ? LD_DYNB_KEY_TAG : 0u;
+    *bias_bits = 0u;
+}
+
+/* The values patch 2006 bakes into D3D12_RASTERIZER_DESC, as RSSetDepthBias arguments: DepthBias is the
+ * units term rounded to an integer (the PSO field is an INT), SlopeScaledDepthBias the factor, no clamp.
+ * NaN or out-of-range words leave the term 0, as the PSO path does. */
+static inline void ld_dynb_values(uint32_t scale_bits, uint32_t bias_bits, float* depth_bias, float* slope)
+{
+    float scale, bias;
+    memcpy(&scale, &scale_bits, 4);
+    memcpy(&bias, &bias_bits, 4);
+    *slope = (scale == scale) ? scale : 0.0f;
+    *depth_bias = 0.0f;
+    if (bias == bias && bias > -2.0e9f && bias < 2.0e9f)
+        *depth_bias = (float)(int32_t)(bias < 0.0f ? bias - 0.5f : bias + 0.5f);
+}
+#endif
