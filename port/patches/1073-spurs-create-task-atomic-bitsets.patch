      * last task per slot id -- enough for JoinTask2's lookup; key it by
      * (taskset, id) if a title joins tasks in two tasksets at once. */
-    u32 free_slot = CELL_SPURS_MAX_TASK;
-    for (u32 t = 0; t < CELL_SPURS_MAX_TASK; t++)
-        if (!(vm_read8(taskset_ea + 0x30 + t / 8) & (0x80u >> (t % 8)))) { free_slot = t; break; }
+    u32 free_slot = kz3_ts_take_slot(taskset_ea);   /* KZ3 patch 1073: sets the enabled bit (atomic) */
     if (free_slot < CELL_SPURS_MAX_TASK) {
         u32 i = free_slot;
         {
@@ -1259,8 +1305,11 @@
             /* Claim the slot before its enabled+ready bits become visible to the taskset scan
              * (KZ3 patch 1023, spu_taskset_claim in spu_workload.c). */
             { extern int spu_taskset_claim(uint32_t, uint32_t, int); spu_taskset_claim(taskset_ea, i, 1); }
-            spurs_taskset_add_task(taskset_ea, i, (uint64_t)elf_ea,
-                                   (uint64_t)context_ea, task_arg, task_lsp);
+            /* KZ3 patch 1073: task_info, then the enabled (old path; taken above otherwise) and ready bits as
+             * atomic line updates. */
+            spurs_taskset_write_task_info(taskset_ea, i, (uint64_t)elf_ea, (uint64_t)context_ea, task_arg, task_lsp);
+            if (kz3_ts_create_old()) kz3_ts_set_bit(taskset_ea, 0x30, i);
+            kz3_ts_set_bit(taskset_ea, 0x10, i);
             /* Bridge to the image-22 dispatch so build_context uses this taskset+task. */
             g_ydkj_real_taskset_ea = taskset_ea;
             g_ydkj_real_taskid     = i;
--- a/libs/spurs/spurs_taskset.c
+++ b/libs/spurs/spurs_taskset.c
@@ -32,6 +32,19 @@
 
 /* Register a task: write task_info[taskId] (args/elf/context/ls_pattern) and mark the
  * task enabled + ready so the PM's SELECT_TASK picks it. arg/ls_pattern may be NULL. */
+/* task_info[taskId] only (args/elf/context/ls_pattern), no bitset change: cellSpursCreateTask sets the enabled and
+ * ready bits itself with an atomic line update (KZ3 patch 1073). */
+void spurs_taskset_write_task_info(uint32_t taskset_ea, uint32_t taskId, uint64_t elf_ea, uint64_t context,
+                                   const uint32_t arg[4], const uint32_t ls_pattern[4])
+{
+    uint32_t ti = spurs_taskset_taskinfo_ea(taskset_ea, taskId);
+    for (int i = 0; i < 4; i++) vm_write32(ti + TI_ARGS + i * 4, arg ? arg[i] : 0);
+    vm_write64(ti + TI_ELF, elf_ea);
+    vm_write64(ti + TI_CONTEXT, context);
+    for (int i = 0; i < 4; i++)
+        vm_write32(ti + TI_LS_PATTERN + i * 4, ls_pattern ? ls_pattern[i] : 0);
+}
+
 void spurs_taskset_add_task(uint32_t taskset_ea, uint32_t taskId, uint64_t elf_ea,
