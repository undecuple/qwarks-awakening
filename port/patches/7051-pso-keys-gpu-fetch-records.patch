diff --git a/pb/libs/video/rsx_pso_keys_rec.h b/libs/video/rsx_pso_keys_rec.h
new file mode 100644
index 0000000..84de293
--- /dev/null
+++ b/libs/video/rsx_pso_keys_rec.h
@@ -0,0 +1,58 @@
+/* R&C patch 7051: the PSO preload key file's record flags and its append (pso_keys.bin, KZ3 patches 2031/2141).
+ *
+ * The walker records every PSO it builds so the next session's preload can recreate it before the walker asks.
+ * KZ3 patch 2076 left the GPU-fetch variant (packed payload mode 2, LD_VTX_GPU=1) out of the file, to be derived from
+ * the packed (mode 1) record by the pipeline-template prewarm. With GPU fetch on, the walker never builds the mode 1
+ * pipeline of a covered draw, so no mode 1 record is ever written, and the template prewarm runs only with
+ * LD_PSO_TEMPLATE: the GPU-fetch pipelines (R&C's default, rc_settings.h) were never preloaded. ToD stall-cold
+ * (2026-11-10): 181 PSOs built, 179 stored in the pipeline library, 20 keys in pso_keys.bin; the warm run preloaded
+ * 20 and awaited 161 in the walker. A mode 2 record now carries LD_PL_FLAG_VGPU and its own key, VS hash and layout,
+ * and the preload creates it like any other record.
+ *
+ * The append opens, writes and closes the file once per new key, so a run killed at any point has every key it
+ * built before the last one on disk (host test port/rc/tests/run_pso_keys_rec_test.sh kills a writer midway).
+ * Pure C. */
+#ifndef RSX_PSO_KEYS_REC_H
+#define RSX_PSO_KEYS_REC_H
+#include <stdint.h>
+#include <stdio.h>
+#include "rsx_pso_keys_hdr.h"
+
+#define LD_PL_FLAG_LAYOUT 1u
+#define LD_PL_FLAG_PACKED 2u
+#define LD_PL_FLAG_DEPTH  4u
+#define LD_PL_FLAG_VGPU   8u   /* R&C patch 7051: packed payload mode 2 (GPU vertex fetch, KZ3 patch 2076) */
+
+/* packed: the walker's packed payload mode (0 float4 slots, 1 packed offsets, 2 GPU fetch); it needs a layout. */
+static inline uint32_t ld_pl_rec_flags(int has_layout, int packed, int depth)
+{
+    return (has_layout ? LD_PL_FLAG_LAYOUT : 0u) | (has_layout && packed ? LD_PL_FLAG_PACKED : 0u) |
+           (has_layout && packed == 2 ? LD_PL_FLAG_VGPU : 0u) | (depth ? LD_PL_FLAG_DEPTH : 0u);
+}
+
+/* The packed payload mode a record was built with (what ld_pso_desc_fill takes). */
+static inline int ld_pl_rec_packed_mode(uint32_t flags)
+{
+    if (!(flags & LD_PL_FLAG_LAYOUT) || !(flags & LD_PL_FLAG_PACKED)) return 0;
+    return (flags & LD_PL_FLAG_VGPU) ? 2 : 1;
+}
+
+/* Append one record to the key file, writing the header first when the file is empty. The file is closed before
+ * returning, so the record is in the operating system's hands even if the process is killed right after.
+ * Returns 1 when the record was written whole. */
+static inline int ld_pl_append(const char* path, const void* rec, uint32_t rec_size, uint32_t rs_size,
+                               uint32_t cache_version, uint64_t translator_id)
+{
+    FILE* f = fopen(path, "ab");
+    if (!f) return 0;
+    int ok = 1;
+    fseek(f, 0, SEEK_END);   /* MSVCRT: an "a" stream reports position 0 until its first write */
+    if (ftell(f) == 0) {
+        const ld_pl_hdr h = ld_pl_hdr_make(rec_size, rs_size, cache_version, translator_id);
+        ok = fwrite(&h, sizeof h, 1, f) == 1;
+    }
+    if (ok) ok = fwrite(rec, rec_size, 1, f) == 1;
+    if (fclose(f) != 0) ok = 0;
+    return ok;
+}
+#endif
