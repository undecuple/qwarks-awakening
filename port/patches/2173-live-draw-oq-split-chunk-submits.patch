+ * pass then records thousands of draws into one list with the GPU idle (A4O Luminopolis: one list holds 31-60 ms of
+ * GPU work, `[perf-gpu] longest`).
+ *
+ * Now a chunk submit closes the open query, submits, and reopens a new query (a "host segment") in the next list. The
+ * title's "game segment" (patch 2025's segment: from the first draw with ZPASS on to ZPASS off, CLEAR_REPORT_VALUE,
+ * GET_REPORT or a flush) is the run of host segments [first, last], contiguous in serial because only one query is
+ * open at a time. Occlusion counts are additive over draws and a split falls between draws, so the game segment's
+ * count is the sum of its host segments. Report outcomes are unchanged: segs counts game segments only, so NEVER /
+ * PENDING / ALWAYS are decided exactly as before; only the count of a PENDING report is now a sum of k >= 1 queries.
+ *
+ * Modes (LD_OQ_SPLIT): 0 = the old refusal (A/B), 1 = default (chunk splits are host splits), 2 = opt-in, a flush
+ * that closes a game segment is a host split too (reports that fall to ALWAYS today get real counts: a behaviour
+ * change, needs its own RPCS3-referenced A/B). Host test: port/rc/tests/run_oq_split_test.sh. */
+#ifndef RSX_OQ_SPLIT_H
+#define RSX_OQ_SPLIT_H
+#include <stdint.h>
+
+enum { OQS_MODE_OFF = 0, OQS_MODE_SPLIT = 1, OQS_MODE_SPLIT_FLUSH = 2 };
+enum { OQS_IDLE = 0, OQS_REFUSE_OPEN, OQS_SUBMIT, OQS_SUBMIT_REOPEN };
+/* Same numbers as rsx_live_draw.c's OQ_ALWAYS / OQ_NEVER / OQ_PENDING. */
+enum { OQS_R_ALWAYS = 1, OQS_R_NEVER = 2, OQS_R_PENDING = 3 };
+
+typedef struct {
+    uint64_t serial;         /* queries handed out */
+    uint64_t open_serial;    /* the open host segment's query */
+    uint64_t last_serial;    /* the newest closed host segment */
+    uint64_t first_serial;   /* the first host segment of the newest game segment */
+    uint32_t segs;           /* game segments since CLEAR_REPORT_VALUE(ZPASS) */
+    int open;                /* a query is open in the current list */
+    int reopen_pending;      /* mode 2: a flush closed a game segment; the next ZPASS draw continues it */
+} oqs_seg_t;
+
+typedef struct { int state; uint64_t first; uint32_t k; int too_long; } oqs_report_t;
+typedef struct { uint32_t q, r, n; } oqs_piece_t;   /* query index, destination entry, count */
+
+/* The chunk-submit gate (ld_submit_nowait). Before 2173: refuse whenever a query is open. */
+static inline int oqs_gate(int ready, uint32_t unsubmitted, int open, int mode)
+{
+    if (!ready || !unsubmitted) return OQS_IDLE;
+    if (!open) return OQS_SUBMIT;
+#ifdef OQS_MUTANT_REFUSE
+    (void)mode; return OQS_REFUSE_OPEN;
+#else
+    return mode >= OQS_MODE_SPLIT ? OQS_SUBMIT_REOPEN : OQS_REFUSE_OPEN;
+#endif
+}
+
+/* A draw with ZPASS counting on and no open query: returns the serial to BeginQuery; *game = 1 when it starts a new
+ * game segment (segs++), 0 when it continues one (mode 2 after a flush). */
+static inline uint64_t oqs_open_for_draw(oqs_seg_t* s, int mode, int* game)
+{
+    const uint64_t q = s->serial++;
+    s->open = 1; s->open_serial = q;
+    if (mode == OQS_MODE_SPLIT_FLUSH && s->reopen_pending) { s->reopen_pending = 0; *game = 0; return q; }
+    s->reopen_pending = 0;
+    s->segs++; s->first_serial = q; *game = 1;
+    return q;
+}
+
+/* Close the open query (the caller ends query open_serial first when s->open). Returns 1 if one was open. */
+static inline int oqs_close(oqs_seg_t* s)
+{
+    if (!s->open) return 0;
+    s->last_serial = s->open_serial;
+    s->open = 0;
+    return 1;
+}
+
+/* A chunk submit with the query open (OQS_SUBMIT_REOPEN): after the close and the new list, a new host segment of the
+ * same game segment. segs and first_serial stay. Returns the serial to BeginQuery. */
+static inline uint64_t oqs_host_reopen(oqs_seg_t* s)
+{
+    const uint64_t q = s->serial++;
+    s->open = 1; s->open_serial = q;
+    return q;
+}
+
+/* A flush (ld_flush_body) closes the query. Mode 2 lets the next ZPASS draw continue the game segment. */
+static inline int oqs_flush_close(oqs_seg_t* s, int mode)
+{
+    const int was = oqs_close(s);
+    if (was && mode == OQS_MODE_SPLIT_FLUSH) s->reopen_pending = 1;
+    return was;
+}
+static inline int oqs_zpass_off(oqs_seg_t* s) { s->reopen_pending = 0; return oqs_close(s); }
+static inline int oqs_clear(oqs_seg_t* s) { const int was = oqs_close(s); s->segs = 0; s->reopen_pending = 0; return was; }
+
+/* GET_REPORT (the caller has closed the query): the slot state and, for PENDING, the host segments [first, first + k).
+ * A game segment longer than the query heap (qn) cannot be resolved: ALWAYS, flagged (it needs more than qn chunk
+ * submits inside one query: about a million draws). */
+static inline oqs_report_t oqs_report(oqs_seg_t* s, uint32_t type, uint32_t qn)
+{
+    oqs_report_t r = { OQS_R_ALWAYS, 0, 0, 0 };
+    s->reopen_pending = 0;
+    if (type != 1u || s->segs > 1) return r;
+    if (s->segs == 0) { r.state = OQS_R_NEVER; return r; }
+    const uint64_t k = s->last_serial - s->first_serial + 1u;
+    if (k >= qn) { r.too_long = 1; return r; }
+    r.state = OQS_R_PENDING; r.first = s->first_serial; r.k = (uint32_t)k;
+    return r;
+}
+
+/* Is the query range [first, last] still in the heap (no index reused since)? first is the oldest, so it is the one
+ * reused first. */
+static inline int oqs_range_live(uint64_t first, uint64_t last, uint64_t serial, uint32_t qn)
+{
+#ifdef OQS_MUTANT_LAST
+    (void)first; return last + qn > serial;
+#else
+    (void)last; return first + qn > serial;
+#endif
+}
+
+/* Split k queries from `first` (heap of qn) into destination entries from h (ring of rn) as runs contiguous in both:
+ * one ResolveQueryData per run. k <= qn and k <= rn give at most 3 runs; -1 if they do not. */
+static inline int oqs_pieces(uint64_t first, uint32_t k, uint32_t qn, uint64_t h, uint32_t rn, oqs_piece_t out[3])
+{
+    int n = 0;
+    uint32_t done = 0;
+    while (done < k && n < 3) {
+        const uint32_t q = (uint32_t)((first + done) % qn), r = (uint32_t)((h + done) % rn);
+        uint32_t run = k - done;
+        if (run > qn - q) run = qn - q;
+        if (run > rn - r) run = rn - r;
+        out[n].q = q; out[n].r = r; out[n].n = run; n++;
+        done += run;
+    }
+    return done == k ? n : -1;
+}
+
+/* Room for a k-entry readback group in a ring of rn entries ([tail, head) in use)? */
+static inline int oqs_rb_room(uint64_t head, uint64_t tail, uint32_t rn, uint32_t k)
+{
+    return k >= 1u && k <= rn && head - tail + k <= rn;
+}
+
+/* The game segment's count: the sum of its k host counts (ring of rn from start), saturated to 32 bits as patch 2027
+ * saturates a single count. */
+static inline uint32_t oqs_sum_sat(const volatile uint64_t* map, uint32_t rn, uint64_t start, uint32_t k)
+{
+    uint64_t sum = 0;
+    for (uint32_t j = 0; j < k; j++) {
+        const uint64_t c = map[(start + j) % rn];
+        if (c > 0xFFFFFFFFull || sum + c > 0xFFFFFFFFull) return 0xFFFFFFFFu;
+        sum += c;
+    }
+    return (uint32_t)sum;
+}
